      },
      "ci_marker": "nightly",
      "expected_runtime_s": 900
    },
    "eady_uniform_dominant_wavelength_over_L_d": {
      "metric": "dominant_wavelength_over_L_d",
      "tolerance_window": [0.7, 1.5],
      "reference": {
        "kind": "analytical",
        "fn": "legoesm.ocean.fidelity.references:eady_most_unstable_wavelength"
      },
      "ci_marker": "nightly",
      "expected_runtime_s": 900
    },
    "phillips_two_layer_period_days": {
      "metric": "most_unstable_period_days",
      "tolerance_window": [15.0, 40.0],
