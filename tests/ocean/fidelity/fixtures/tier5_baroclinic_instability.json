{
  "schema_version": 1,
  "tier": 5,
  "description": "Baroclinic-instability growth: Eady sigma_max=0.31 f Lambda/N; Phillips ~25 day period",
  "common": {
    "precision": "x64",
    "grid": "latlon_cgrid",
    "resolution": "2p5deg"
  },
  "cases": {
    "eady_instability_growth_rate_over_sigma_eady": {
