# --- Committed forcing / boundary-condition INPUT data (small, tracked so a
# fresh clone can run the AMIP/LES/OMIP smokes without a data download). These
# are model INPUTS, not runtime OUTPUTS — the `data/` and `*.nc` ignores above
# are for transient outputs. Narrow, path-scoped negations only.
# Provenance: data/les_cases = third-party gSAM SAM CASES decks (Khairoutdinov,
# SAM/gSAM); see data/les_cases/NOTICE. data/forcing_amip = synthetic, regen via
# scripts/data/generate_amip_forcing.py. data/bathymetry = NOAA ETOPO (public).
!data/
data/*
!data/forcing_amip/
!data/forcing_amip/*.nc
!data/bathymetry/
!data/bathymetry/*.nc
!data/les_cases/
!data/les_cases/**/
!data/les_cases/**
e3sm-source/

# Published DEPHY-format case files, downloaded by
# scripts/data/fetch_dephy_cases.py from the groups that publish them. NOT
# vendored: the transition composites are 36 MB each, and provenance belongs
# upstream. The gSAM decks above stay tracked; these do not.
data/les_cases/dephy/

# --- Caches and derived data that were committed by accident (2026-09-20) ---
# matplotlib's font cache.  Nothing points MPLCONFIGDIR here — the scripts that
# set it use a temp dir (e.g. scripts/run/run_ocean_spectral_tests.py) — so the
# tracked copy was a stray commit, not a deliberate vendoring.
.mplconfig/
# Derived ERA5 climatology, ~26 MB, REGENERABLE: its generator is committed at
# scripts/validate/amip_bias/extract_era5_omega.py and its only consumer is
# scripts/validate/amip_bias/tropical_circulation.py.  A derived artifact with a
# committed recipe belongs to the run directory, not to git history.
scripts/validate/amip_bias/era5_omega_clim.npz
# Debug plots.  Visual artifacts are regenerated on demand.  THREE are kept
# tracked on purpose: scripts/data/build_legoesm_deck.py uses them as the
# committed fallback figures (``first_existing(RESULTS/..., DEBUG/...)``) so a
# machine with no run output can still build the slide deck.  The other six
# were unreferenced.  The other carve-out stays the tiny numeric
# visual-regression baselines under tests/visual_baselines.
tests/debug/
!tests/debug/spectral_hs100.png
!tests/debug/spectral_hs100_final.png
!tests/debug/spectral_hs100_eqinit.png
# Reviewer stderr captures.
.physics-validator/**/*.err
