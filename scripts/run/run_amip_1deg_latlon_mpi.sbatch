#!/bin/bash
#SBATCH --job-name=amip_1deg_latlon_mpi
#SBATCH --output=results/amip_1deg_latlon_mpi/slurm_%j.out
#SBATCH --error=results/amip_1deg_latlon_mpi/slurm_%j.err
#SBATCH --account=glab
#SBATCH --partition=burst
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
#SBATCH --mem=150G
#SBATCH --time=72:00:00
#
# Production AMIP run on a 1° lat-lon FV grid under latitude-band MPI
# on 32 ranks (full 32-core Ginsburg node; n_lat=180 → ~5.6 rows/rank,
# halo overhead ≈ 35%; sweet spot before band partition becomes
# halo-dominated).
#
# Resolution: ``--resolution 180`` → 180 lat × 360 lon (= 1° at the
# equator).  For a 2° smoke-test run use ``--resolution 90``.
#
# Forcing deck: full CMIP6 stack via ``run_amip_smoke_deck.py`` —
# transient SST/SIC, GHG, ozone, solar, aerosol, volcanic.  The deck
# is auto-generated by ``generate_amip_forcing.py`` the first time
# the script sees a missing file (idempotent on re-run).
#
# Checkpoint / restart chain
# ~~~~~~~~~~~~~~~~~~~~~~~~~~
# ``--checkpoint-days 365`` writes one checkpoint per simulated year.
# The launcher script detects the latest checkpoint in
# ``${OUTPUT_DIR}`` and resumes from it via ``--restart-from``.  For a
# 100-year run that exceeds the 72 h walltime, submit consecutive
# instances of this sbatch (e.g.
# ``sbatch --dependency=afterany:<prev> <this>``); each picks up
# where the previous left off.
#
# Prerequisite
# ~~~~~~~~~~~~
# The pg2328 MPI venv with mpi4jax must exist at
# ``~/.venvs/legoesm-mpi``; build it once with
# ``sbatch scripts/data/setup_legoesm_mpi_venv.sbatch``.

set -euo pipefail

REPO_ROOT="/burg-archive/glab/users/pg2328/legoESM"
cd "${REPO_ROOT}"

# --------------------------------------------------------------------
# Configuration knobs (override via env at sbatch time, e.g.
# RES=90 sbatch scripts/run_amip_1deg_latlon_mpi.sbatch).
# --------------------------------------------------------------------
: "${RES:=180}"                  # 90 = 2°, 180 = 1° at equator
: "${START_YEAR:=1979}"
: "${END_YEAR:=2014}"            # CMIP6 AMIP standard span
: "${TARGET_DAYS:=36500}"        # 100 yr — restart chain handles spillover
: "${DT:=270.0}"                 # equatorial-CFL safe at 1° under polar filter
: "${RAD_UPDATE_STEPS:=13}"      # ~1-h radiation cadence at dt=270 (3510 s ≈ 1 h)
# Stage 3-E sizing note: at 1° (n_lat=180, n_lon=360),
#   dx_equator = 2π R / n_lon ≈ 1.11e5 m
# Advective CFL with c=300 m/s, CFL=0.8 gives dt_max ≈ 296 s.  DT=270
# leaves ~9% margin and avoids ``component_factory``'s clamp.  The
# polar filter handles the pole-cell CFL by truncating modes that
# would violate it at this dt.  Without ``--use-polar-filter`` the
# clamp would drop dt to ~5 s — 60× slowdown.
: "${OUTPUT_DIR:=${REPO_ROOT}/results/amip_1deg_latlon_mpi}"
: "${FORCING_DIR:=${REPO_ROOT}/forcing_amip}"

mkdir -p "${OUTPUT_DIR}"
mkdir -p "${FORCING_DIR}"

# --------------------------------------------------------------------
# Environment: pg2328 MPI venv (mpi4jax + jn2808 site-packages).
# --------------------------------------------------------------------
PY="${HOME}/.venvs/legoesm-mpi/bin/python"
if [[ ! -x "${PY}" ]]; then
    echo "FATAL: ${PY} not found.  Build the venv first:" >&2
    echo "    sbatch scripts/data/setup_legoesm_mpi_venv.sbatch" >&2
    exit 2
fi
export PYTHONPATH="${REPO_ROOT}/src:${PYTHONPATH:-}"
export JAX_PLATFORMS=cpu
export JAX_ENABLE_X64=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

source /etc/profile.d/modules.sh 2>/dev/null || true
module load openmpi/gcc/64/4.1.7a1 2>/dev/null || true

# --------------------------------------------------------------------
# Restart-chain logic: look for the latest checkpoint in OUTPUT_DIR.
# --------------------------------------------------------------------
LATEST_CKPT=""
LATEST_DAY=0
if [[ -d "${OUTPUT_DIR}" ]]; then
    # Checkpoints are written as ``checkpoint_day_NNNN.npz`` by
    # the driver (driver/model_driver.py:1378).
    LATEST_CKPT=$(ls -1 "${OUTPUT_DIR}"/checkpoint_day_*.npz 2>/dev/null \
                  | sort -V | tail -1 || true)
    if [[ -n "${LATEST_CKPT}" ]]; then
        # Extract NNNN from the filename for logging
        LATEST_DAY=$(basename "${LATEST_CKPT}" \
                     | sed -E 's/checkpoint_day_0*([0-9]+).npz/\1/')
    fi
fi

echo "========================================"
echo "  AMIP 1° lat-lon MPI run"
echo "  Job ID:        ${SLURM_JOB_ID:-<no-slurm>}"
echo "  Nodes / tasks: ${SLURM_NNODES:-1} / ${SLURM_NTASKS:-32}"
echo "  Resolution:    ${RES} (n_lat=${RES}, n_lon=$((2*RES)))"
echo "  Start year:    ${START_YEAR}"
echo "  Target days:   ${TARGET_DAYS} (100 yr ≈ 36500)"
echo "  dt:            ${DT} s"
echo "  Rad cadence:   ${RAD_UPDATE_STEPS} steps (≈1 h at dt=${DT})"
echo "  Output dir:    ${OUTPUT_DIR}"
echo "  Forcing dir:   ${FORCING_DIR}"
echo "  Restart from:  ${LATEST_CKPT:-<fresh start>}"
echo "  Latest day:    ${LATEST_DAY}"
echo "  Date:          $(date -u)"
echo "========================================"

# --------------------------------------------------------------------
# Build the run_amip_smoke_deck.py command line.  The deck driver
# auto-generates missing forcing files on first run via
# ``--auto-generate``.
# --------------------------------------------------------------------
DAYS_THIS_JOB=$((TARGET_DAYS - LATEST_DAY))
if (( DAYS_THIS_JOB <= 0 )); then
    echo "[$(date -u)] Target ${TARGET_DAYS} days already reached "
    echo "(latest checkpoint at day ${LATEST_DAY}).  Nothing to do."
    exit 0
fi

CMD=(
    "${PY}" "${REPO_ROOT}/scripts/run/run_amip_smoke_deck.py"
    --forcing-dir "${FORCING_DIR}"
    --auto-generate
    --start-year "${START_YEAR}"
    --end-year "${END_YEAR}"
    --resolution "${RES}"
    --grid-type latlon
    --discretization finite_volume
    --days "${DAYS_THIS_JOB}"
    --dt "${DT}"
    --rad-update-steps "${RAD_UPDATE_STEPS}"
    --diag-days 30
    --checkpoint-days 365
    --output "${OUTPUT_DIR}"
    --monthly-means
)

# ``run_amip_smoke_deck.py`` uses ``--extra nargs=REMAINDER`` which
# consumes ALL subsequent argv into args.extra.  Build the trailing
# argv block first, then attach it once with a single ``--extra``.
# Stage 3-E: ``--use-polar-filter`` lifts the pole-cell CFL clamp so
# the run can use ``--dt 300`` set by the equatorial CFL.  Without
# this flag, 100-y at 1° lat-lon FV needs ~600 B time steps and is
# infeasible in the 72-h × N restart-chain SLURM budget.
EXTRA_ARGS=(--use-polar-filter --time-integrator ssp_rk3_scan)
if [[ -n "${LATEST_CKPT}" ]]; then
    EXTRA_ARGS+=(--restart-from "${LATEST_CKPT}")
fi
CMD+=(--extra "${EXTRA_ARGS[@]}")

# --------------------------------------------------------------------
# Launch under MPI.  ``run_amip.py`` auto-detects SLURM_NTASKS and
# enables ``--distributed`` so ModelDriver activates MPI halo
# exchange (cubed-sphere precedent).  For lat-lon under MPI the
# wrapper-function path in legoesm.parallel.latlon_mpi does the
# set_halo_backend("mpi", layout) — but ModelDriver's run loop
# currently dispatches to ``_run_per_step`` on the lat-lon grid
# without that activation.  This sbatch will surface that gap as
# a clear error at launch time, pointing at Stage 3 of the
# lat-lon MPI work (physics + driver dispatch); the rest of the
# infrastructure (forcing deck, checkpoint chain, yearly maps,
# wall-time / restart accounting) is in place and reusable.
# --------------------------------------------------------------------
if [[ -n "${SLURM_JOB_ID:-}" ]] && command -v srun >/dev/null; then
    MPI_LAUNCH=(srun --mpi=pmix --cpus-per-task=1 -n "${SLURM_NTASKS:-32}")
else
    MPI_LAUNCH=(mpirun -n "${SLURM_NTASKS:-32}")
fi

echo "[$(date -u)] Launching: ${MPI_LAUNCH[*]} ${CMD[*]}"
"${MPI_LAUNCH[@]}" "${CMD[@]}"
RC=$?
echo "[$(date -u)] Done.  Exit code: ${RC}"

# --------------------------------------------------------------------
# Post-run: generate yearly PNG maps if any monthly means exist.
# Cheap (<1 min for 1 year, scales linearly), runs on rank 0 only.
# --------------------------------------------------------------------
if [[ -f "${OUTPUT_DIR}/monthly_means.npz" ]] && (( SLURM_PROCID == 0 || ! ${SLURM_PROCID+x} )); then
    echo "[$(date -u)] Rendering yearly maps …"
    "${PY}" "${REPO_ROOT}/scripts/plot/plot_amip_yearly_maps.py" \
        --input  "${OUTPUT_DIR}/monthly_means.npz" \
        --output "${OUTPUT_DIR}/yearly_maps" \
        --start-year "${START_YEAR}" \
        || echo "[$(date -u)] WARNING: yearly-map plotter exited non-zero (continuing)"
fi

# --------------------------------------------------------------------
# Auto-chain: if the target days were not reached this job, submit
# the next link with ``--dependency=afterany`` so it picks up after
# any exit (success OR walltime-timeout).
# --------------------------------------------------------------------
if (( RC == 0 )) && [[ -n "${SLURM_JOB_ID:-}" ]]; then
    LATEST_CKPT_NEW=$(ls -1 "${OUTPUT_DIR}"/checkpoint_day_*.npz 2>/dev/null \
                      | sort -V | tail -1 || true)
    if [[ -n "${LATEST_CKPT_NEW}" ]]; then
        NEW_DAY=$(basename "${LATEST_CKPT_NEW}" \
                  | sed -E 's/checkpoint_day_0*([0-9]+).npz/\1/')
        if (( NEW_DAY < TARGET_DAYS )); then
            echo "[$(date -u)] Chain: ${NEW_DAY} / ${TARGET_DAYS} days "
            echo "done.  Queueing next link …"
            NEXT_JOB=$(sbatch \
                --dependency=afterany:"${SLURM_JOB_ID}" \
                "$0" | awk '{print $NF}')
            echo "[$(date -u)] Submitted next link as job ${NEXT_JOB}"
        else
            echo "[$(date -u)] Target ${TARGET_DAYS} days reached.  Chain complete."
        fi
    fi
fi

exit "${RC}"
