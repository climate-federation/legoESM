! ecRad namelist reproducing the OpenIFS 49r1 (8f6f722) code-default IFS
! configuration with RRTMG gas optics (user decision A14). The operational
! 49r1 namelist is not in the clone, so the CODE DEFAULTS are the oracle of
! record. Every value below is what arpifs/phys_radi/su_radiation_scheme.F90
! (SU) sets from the suecrad.F90 (SE) defaults, or the radiation_config.F90
! (RC) default where the IFS does not set it. directory_name is set by the
! harness at run time. Per-call settings made by radiation_scheme.F90
! (overlap decorrelation, fractional std, inhomogeneity decorrelation ratio,
! seeds) belong to the IFS-interface harness, not here.
&radiation_driver
do_parallel              = false,  ! harness: one thread, deterministic
nblocksize               = 8,
iverbose                 = 2,
do_write_double_precision = true,  ! harness: fp64 output
do_save_net_fluxes       = false,
/
&radiation
directory_name           = "DATA_DIR",
do_sw                    = true,   ! RC default
do_lw                    = true,   ! RC default
do_sw_direct             = true,   ! RC default
do_clear                 = true,   ! RC default
gas_model_name           = "RRTMG-IFS",  ! SU:188 (NSWGASOPTICS=NLWGASOPTICS=0, SE:637-638)
use_general_cloud_optics = false,  ! SU:189
use_general_aerosol_optics = true, ! SU:190
do_weighted_surface_mapping = false, ! SU:195
liquid_model_name        = "SOCRATES",  ! SU:251 (NLIQOPT=4, SE:672)
ice_model_name           = "Fu-IFS",    ! SU:262 (NICEOPT=3, SE:674)
do_fu_lw_ice_optics_bug  = false,  ! SU:265 (LFU_LW_ICE_OPTICS_BUG=F, SE:754)
do_sw_delta_scaling_with_gases = false, ! SU:292
use_aerosols             = true,   ! SU:298
sw_solver_name           = "McICA", ! SU:551 (NSWSOLVER=0, SE:643)
lw_solver_name           = "McICA", ! SU:535 (NLWSOLVER=0, SE:642)
do_3d_effects            = false,  ! SU:530
do_lw_cloud_scattering   = true,   ! SU:586 (NLWSCATTERING=1, SE:630)
do_lw_aerosol_scattering = false,  ! SU:583
overlap_scheme_name      = "Exp-Ran", ! SU:605 (NCLOUDOVERLAP=3, SE:647)
cloud_fraction_threshold = 1.0e-6, ! RC default (SU:632 only for Tripleclouds/SPARTACUS)
use_beta_overlap         = false,  ! RC default
use_vectorizable_generator = false, ! RC default (non-SX)
cloud_pdf_shape_name     = "Gamma", ! RC default
do_lw_derivatives        = true,   ! SU:162 (LAPPROXLWUPDATE=T, SE:524)
do_canopy_fluxes_sw      = true,   ! SU:168 (LAPPROXSWUPDATE=T, SE:530)
do_canopy_fluxes_lw      = false,  ! RC default; SU:175 only if NLWOUT>1 (NEMISSSCHEME=0 -> NLWOUT=1, SE:1299)
do_surface_sw_spectral_flux = true, ! SU:179
do_save_spectral_flux    = true,   ! harness: spectral fluxes in the output
do_save_gpoint_flux      = false,
iverbose                 = 1,      ! SU:150
iverbosesetup            = 2,
! SW albedo: 6 MODIS intervals, weighted mapping (NALBEDOSCHEME=2 in su0phy.F90:1457 -> SU:653 nearest=F)
do_nearest_spectral_sw_albedo = false,
sw_albedo_wavelength_bound(1:5) = 0.25e-6, 0.44e-6, 0.69e-6, 1.19e-6, 2.38e-6,  ! SU:637-638
i_sw_albedo_index(1:6) = 1,2,3,4,5,6,     ! SU:639
! LW emissivity: NEMISSSCHEME=0 (su0phy.F90:1464) -> 2 intervals (SE:1305), nearest (SU:662)
do_nearest_spectral_lw_emiss = true,
lw_emiss_wavelength_bound(1:2) = 8.0e-6, 13.0e-6,
i_lw_emiss_index(1:3) = 1,2,1,
/
