+   SUBROUTINE l4_orca1ice_thd_dump( kt, kframe )
+      !! WRITE-only, self-describing ORCA1-target thermodynamic frame.
+      !! The source fields are never assigned; canonical helpers zero halos,
+      !! land, and inactive components before serialization.
+      INTEGER, INTENT(in) :: kt, kframe
+      INTEGER :: l4_unit, l4_ios, l4_payload, jf
+      INTEGER, PARAMETER :: l4_nf = 16
+      INTEGER, DIMENSION(4,l4_nf) :: l4_ext
+      CHARACTER(LEN=16), PARAMETER :: l4_magic = 'NEMO_L4_O1ITHD1'
+      CHARACTER(LEN=96) :: l4_name
+      IF( .NOT.lwp ) RETURN
+
+      l4_ext(:, 1) = (/ SHAPE(a_i), 1 /)
+      l4_ext(:, 2) = (/ SHAPE(v_i), 1 /)
+      l4_ext(:, 3) = (/ SHAPE(v_s), 1 /)
+      l4_ext(:, 4) = (/ SHAPE(sv_i), 1 /)
+      l4_ext(:, 5) = (/ SHAPE(t_su), 1 /)
+      l4_ext(:, 6) = SHAPE(e_i)
+      l4_ext(:, 7) = SHAPE(e_s)
+      l4_ext(:, 8) = SHAPE(szv_i)
+      l4_ext(:, 9) = (/ SHAPE(qns_ice), 1 /)
+      l4_ext(:,10) = (/ SHAPE(qsr_ice), 1 /)
+      l4_ext(:,11) = (/ SHAPE(dqns_ice), 1 /)
+      l4_ext(:,12) = (/ SHAPE(evap_ice), 1 /)
+      l4_ext(:,13) = (/ SHAPE(qprec_ice), 1, 1 /)
+      l4_ext(:,14) = (/ SHAPE(qml_ice), 1 /)
+      l4_ext(:,15) = (/ SHAPE(qcn_ice), 1 /)
+      l4_ext(:,16) = (/ SHAPE(qtr_ice_top), 1 /)
+      l4_payload = 0
+      DO jf = 1, l4_nf
+         l4_payload = l4_payload + PRODUCT(l4_ext(:,jf))
+      END DO
+
+      WRITE(l4_name,'("oracle_orca1ice_thd_kt",I8.8,"_f",I1,".bin")') kt, kframe
+      OPEN( NEWUNIT=l4_unit, FILE=TRIM(l4_name), STATUS='REPLACE', ACCESS='STREAM', &
+         & FORM='UNFORMATTED', ACTION='WRITE', IOSTAT=l4_ios )
+      IF( l4_ios /= 0 ) CALL ctl_stop('l4_orca1ice_thd_dump: open failed')
+      WRITE(l4_unit) l4_magic
+      WRITE(l4_unit) 1, kt, kframe, jpi, jpj, jpl, nlay_i, nlay_s, &
+         & STORAGE_SIZE(1._wp), l4_nf, l4_payload
+      WRITE(l4_unit) l4_ext
+      WRITE(l4_unit) l4_canon_3d(a_i,'T'), l4_canon_3d(v_i,'T'), &
+         & l4_canon_3d(v_s,'T'), l4_canon_3d(sv_i,'T'), l4_canon_3d(t_su,'T'), &
+         & l4_canon_4d(e_i,'T'), l4_canon_4d(e_s,'T'), l4_canon_4d(szv_i,'T'), &
+         & l4_canon_3d(qns_ice,'T'), l4_canon_3d(qsr_ice,'T'), &
+         & l4_canon_3d(dqns_ice,'T'), l4_canon_3d(evap_ice,'T'), &
+         & l4_canon_2d(qprec_ice,'T'), l4_canon_3d(qml_ice,'T'), &
+         & l4_canon_3d(qcn_ice,'T'), l4_canon_3d(qtr_ice_top,'T')
+      CLOSE(l4_unit)
+   END SUBROUTINE l4_orca1ice_thd_dump
+
