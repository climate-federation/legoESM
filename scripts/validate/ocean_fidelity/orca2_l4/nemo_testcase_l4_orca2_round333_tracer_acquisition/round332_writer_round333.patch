--- round332_writer.F90
+++ round332_writer.F90
@@ -5,2 +5,3 @@
    USE dynzdf_round328_writer, ONLY : checksum3
+   USE dynzdf_round328_writer, ONLY : checksum2
    USE lib_mpp, ONLY : ctl_stop
@@ -9,2 +10,3 @@
    PUBLIC :: r332_vor_begin, r332_vor_add, r332_vor_done
+   PUBLIC :: r333_tracer_open, r333_tracer_rhs, r333_tracer_finish
    PUBLIC :: r332_tke_row, r332_raw_postfold_v
@@ -13,2 +15,4 @@
    LOGICAL, SAVE :: active=.FALSE.,have_add=.FALSE.,have_vor=.FALSE.,written=.FALSE.
+   INTEGER, SAVE :: r333_unit=-1,r333_rows=0
+   LOGICAL, SAVE :: r333_active=.FALSE.,r333_written=.FALSE.
    LOGICAL, SAVE :: raw_written=.FALSE.
@@ -145,1 +149,79 @@
+   SUBROUTINE r333_put3(name,value)
+      CHARACTER(LEN=*), INTENT(in) :: name
+      REAL(wp), DIMENSION(jpi,jpj,jpk), INTENT(in) :: value
+      CHARACTER(LEN=24) :: field
+      field=name
+      WRITE(r333_unit) field
+      WRITE(r333_unit) 3,jpi,jpj,jpk,1,1,1
+      WRITE(r333_unit) checksum3(value)
+      WRITE(r333_unit) value
+   END SUBROUTINE r333_put3
+
+   SUBROUTINE r333_put2(name,value)
+      CHARACTER(LEN=*), INTENT(in) :: name
+      REAL(wp), DIMENSION(jpi,jpj), INTENT(in) :: value
+      CHARACTER(LEN=24) :: field
+      field=name
+      WRITE(r333_unit) field
+      WRITE(r333_unit) 2,jpi,jpj,1,1,1,1
+      WRITE(r333_unit) checksum2(value)
+      WRITE(r333_unit) value
+   END SUBROUTINE r333_put2
+
+   SUBROUTINE r333_tracer_open(kt,kstg,Kbb,Kmm,Krhs,Kaa,pT,pS)
+      INTEGER, INTENT(in) :: kt,kstg,Kbb,Kmm,Krhs,Kaa
+      REAL(wp), DIMENSION(jpi,jpj,jpk), INTENT(in) :: pT,pS
+      INTEGER :: ios
+      CHARACTER(LEN=16) :: magic
+      CHARACTER(LEN=96) :: filename
+      IF(kt /= nit000+1 .OR. kstg /= 3) RETURN
+      IF(r333_active .OR. r333_written) CALL ctl_stop('round333: duplicate tracer open')
+      IF(STORAGE_SIZE(1._wp) /= 64) CALL ctl_stop('round333: tracer record requires fp64')
+      WRITE(filename,'("oracle_rktracer_stage3_kt",I8.8,"_r",I4.4,".bin")') kt,narea-1
+      OPEN(NEWUNIT=r333_unit,FILE=TRIM(filename),ACCESS='STREAM',FORM='UNFORMATTED', &
+         & STATUS='REPLACE',ACTION='WRITE',IOSTAT=ios)
+      IF(ios /= 0) CALL ctl_stop('round333: cannot open tracer record')
+      magic='NEMO_L4_R333TR'
+      WRITE(r333_unit) magic,2,kt,kstg,Kbb,Kmm,Krhs,Kaa,narea-1,jpi,jpj,jpk, &
+         & STORAGE_SIZE(1._wp),21
+      CALL r333_put3('zero_T',pT)
+      CALL r333_put3('zero_S',pS)
+      r333_rows=0
+      r333_active=.TRUE.
+   END SUBROUTINE r333_tracer_open
+
+   SUBROUTINE r333_tracer_rhs(pT,pS)
+      REAL(wp), DIMENSION(jpi,jpj,jpk), INTENT(in) :: pT,pS
+      CHARACTER(LEN=24), DIMENSION(5) :: t_names,s_names
+      IF(.NOT.r333_active) RETURN
+      IF(r333_rows >= 5) CALL ctl_stop('round333: excess tracer RHS boundary')
+      t_names=(/'after_advection_T       ','after_sbc_T             ', &
+         &       'after_qsr_T             ','after_ldf_T             ', &
+         &       'after_damping_T         '/)
+      s_names=(/'after_advection_S       ','after_sbc_S             ', &
+         &       'after_qsr_S             ','after_ldf_S             ', &
+         &       'after_damping_S         '/)
+      r333_rows=r333_rows+1
+      CALL r333_put3(t_names(r333_rows),pT)
+      CALL r333_put3(s_names(r333_rows),pS)
+   END SUBROUTINE r333_tracer_rhs
+
+   SUBROUTINE r333_tracer_finish(pbbT,pbbS,pmmT,pmmS,paaT,paaS,rbb,rmm,raa)
+      REAL(wp), DIMENSION(jpi,jpj,jpk), INTENT(in) :: pbbT,pbbS,pmmT,pmmS,paaT,paaS
+      REAL(wp), DIMENSION(jpi,jpj), INTENT(in) :: rbb,rmm,raa
+      IF(.NOT.r333_active) RETURN
+      IF(r333_rows /= 5) CALL ctl_stop('round333: incomplete tracer RHS boundary set')
+      CALL r333_put3('Kbb_T',pbbT)
+      CALL r333_put3('Kbb_S',pbbS)
+      CALL r333_put3('Kmm_T',pmmT)
+      CALL r333_put3('Kmm_S',pmmS)
+      CALL r333_put3('Kaa_T',paaT)
+      CALL r333_put3('Kaa_S',paaS)
+      CALL r333_put2('r3t_Kbb',rbb)
+      CALL r333_put2('r3t_Kmm',rmm)
+      CALL r333_put2('r3t_Kaa',raa)
+      CLOSE(r333_unit)
+      r333_active=.FALSE.
+      r333_written=.TRUE.
+   END SUBROUTINE r333_tracer_finish
 END MODULE round332_writer
