+                     l4_zdf_e3vw_bb(ji,jj,jk) = e3vw (ji,jj,jk,Kbb)
+                     l4_zdf_e3vw_mm(ji,jj,jk) = e3vw (ji,jj,jk,Kmm)
+                     l4_zdf_gdepw_mm(ji,jj,jk) = gdepw(ji,jj,jk,Kmm)
+                     l4_zdf_e3t_mm (ji,jj,jk) = e3t  (ji,jj,jk,Kmm)
