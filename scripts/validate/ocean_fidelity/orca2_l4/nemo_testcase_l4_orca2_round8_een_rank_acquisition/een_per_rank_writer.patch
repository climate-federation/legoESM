-         WRITE(l4_filename,'("oracle_een_zpvo_kt",I8.8,".bin")') kt
+         WRITE(l4_filename,'("oracle_een_zpvo_kt",I8.8,"_r",I4.4,".bin")') kt, narea - 1
          OPEN( NEWUNIT=l4_unit, FILE=TRIM(l4_filename), ACCESS='STREAM', FORM='UNFORMATTED', &
