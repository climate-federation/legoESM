+   SUBROUTINE l4bulk2d_open
+      INTEGER :: ios
+      IF( .NOT. ll_l4bulk2d_opened ) THEN
+         OPEN( NEWUNIT=num_l4bulk2d, FILE='oracle_l4_bulk_boundary_2d.bin', STATUS='REPLACE', &
+            &  ACCESS='STREAM', FORM='UNFORMATTED', ACTION='WRITE', IOSTAT=ios )
+         IF( ios /= 0 )   CALL ctl_stop( 'cannot open oracle_l4_bulk_boundary_2d.bin' )
+         ll_l4bulk2d_opened = .TRUE.
+      ENDIF
+   END SUBROUTINE l4bulk2d_open
