+   SUBROUTINE l3bulk_header( kt, kstage, knval )
+      INTEGER, INTENT(in) :: kt, kstage, knval
+      CHARACTER(LEN=16), PARAMETER :: cmagic = 'NEMO_L3BULK_001 '
