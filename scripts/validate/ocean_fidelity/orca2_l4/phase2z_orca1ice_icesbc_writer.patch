+   SUBROUTINE l4_dump_bulk_tau_2d( kt, putau_ice, pvtau_ice )
+      !! Phase-2z WRITE-only full-domain companion to l3bulk_dump_tau (the
+      !! certified single-column C1D probe, icesbc.F90:88-91 as executed).
+      !! Captures the SI3 bulk-boundary INPUTS (theta_air, q_air, p_surface,
+      !! wind components, rho_air, lw_down, qsr, precip, snow, cloud
+      !! fraction, Ch, Ce -- all module/forcing fields already valid at this
+      !! point in ice_sbc_tau) and the tau-stage OUTPUTS (utau_ice, vtau_ice,
+      !! wndm_ice) over the real masked domain, so the already-certified
+      !! single-column identity can be re-scored under real geometry.  No
+      !! model array is assigned; masking only selects owned wet cells.
+      INTEGER , INTENT(in) :: kt
+      REAL(wp), DIMENSION(jpi,jpj), INTENT(in) :: putau_ice, pvtau_ice
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'l4 bulk-2d dump requires 64-bit wp' )
+      CALL l4bulk2d_open
+      WRITE(num_l4bulk2d) 'NEMO_L4BULK2D_1 '
+      WRITE(num_l4bulk2d) 1, kt, 0, jpi, jpj, jpl, 16, 0, STORAGE_SIZE(1._wp)
+      WRITE(num_l4bulk2d) l4_canon_2d(theta_air_zt,'T'), l4_canon_2d(q_air_zt,'T'), &
+         & l4_canon_2d(sf(jp_slp)%fnow(:,:,1),'T'), l4_canon_2d(sf(jp_wndi)%fnow(:,:,1),'T'), &
+         & l4_canon_2d(sf(jp_wndj)%fnow(:,:,1),'T'), l4_canon_2d(rhoa,'T'), &
+         & l4_canon_2d(sf(jp_qlw)%fnow(:,:,1),'T'), l4_canon_2d(qsr,'T'), &
+         & l4_canon_2d(precip,'T'), l4_canon_2d(sf(jp_snow)%fnow(:,:,1),'T'), &
+         & l4_canon_2d(cloud_fra,'T'), l4_canon_2d(Ch_ice,'T'), l4_canon_2d(Ce_ice,'T'), &
+         & l4_canon_2d(putau_ice,'T'), l4_canon_2d(pvtau_ice,'T'), l4_canon_2d(wndm_ice,'T')
+   END SUBROUTINE l4_dump_bulk_tau_2d
+
+
+   SUBROUTINE l4_dump_bulk_flux_2d( kt )
+      !! Phase-2z WRITE-only full-domain companion to l3bulk_dump_flux stage
+      !! 2 (icesbc.F90:200-201 as executed, immediately after ice_flx_other).
+      !! Captures the remaining SI3 bulk-boundary OUTPUTS not yet in scope at
+      !! the tau-stage frame: per-category qla_ice/dqla_ice/devap_ice/
+      !! alb_ice/qevap_ice (jpi,jpj,jpl) and aggregate emp_ice/emp_oce/
+      !! tprecip/sprecip/qemp_oce/qemp_ice/qsb_ice_bot/fhld/qlead/drag_io/
+      !! frq_m (jpi,jpj).  No model array is assigned.
+      INTEGER, INTENT(in) :: kt
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'l4 bulk-2d dump requires 64-bit wp' )
+      CALL l4bulk2d_open
+      WRITE(num_l4bulk2d) 'NEMO_L4BULK2D_1 '
+      WRITE(num_l4bulk2d) 1, kt, 1, jpi, jpj, jpl, 11, 5, STORAGE_SIZE(1._wp)
+      WRITE(num_l4bulk2d) l4_canon_3d(qla_ice,'T'), l4_canon_3d(dqla_ice,'T'), &
+         & l4_canon_3d(devap_ice,'T'), l4_canon_3d(alb_ice,'T'), l4_canon_3d(qevap_ice,'T')
+      WRITE(num_l4bulk2d) l4_canon_2d(emp_ice,'T'), l4_canon_2d(emp_oce,'T'), &
+         & l4_canon_2d(tprecip,'T'), l4_canon_2d(sprecip,'T'), l4_canon_2d(qemp_oce,'T'), &
+         & l4_canon_2d(qemp_ice,'T'), l4_canon_2d(qsb_ice_bot,'T'), l4_canon_2d(fhld,'T'), &
+         & l4_canon_2d(qlead,'T'), l4_canon_2d(drag_io,'T'), l4_canon_2d(frq_m,'T')
+      FLUSH(num_l4bulk2d)
+   END SUBROUTINE l4_dump_bulk_flux_2d
+
