+   SUBROUTINE l4_tke_write( kt, Kbb, Kmm )
+      INTEGER, INTENT(in) :: kt, Kbb, Kmm
+      INTEGER :: l4_tke_unit, l4_tke_ios, l4_tke_payload, l4_tke_ifield
+      INTEGER, DIMENSION(3,21) :: l4_tke_extents
+      CHARACTER(LEN=96) :: l4_tke_filename
+      CHARACTER(LEN=16) :: l4_tke_magic
+      IF( .NOT.l4_tke_dump ) RETURN
+      l4_tke_extents(:, 1)=SHAPE(l4_tke_zpelc)
+      l4_tke_extents(:, 2)=SHAPE(l4_tke_en_lc)
+      l4_tke_extents(:, 3)=SHAPE(l4_tke_pdlr)
+      l4_tke_extents(:, 4)=SHAPE(l4_tke_zdiag_pre)
+      l4_tke_extents(:, 5)=SHAPE(l4_tke_zdlw_pre)
+      l4_tke_extents(:, 6)=SHAPE(l4_tke_zdup_pre)
+      l4_tke_extents(:, 7)=SHAPE(l4_tke_en_rhs)
+      l4_tke_extents(:, 8)=SHAPE(l4_tke_zdiag_fwd)
+      l4_tke_extents(:, 9)=SHAPE(l4_tke_zdlw_fwd)
+      l4_tke_extents(:,10)=SHAPE(l4_tke_en_solved)
+      l4_tke_extents(:,11)=SHAPE(l4_tke_en_etau)
+      l4_tke_extents(:,12)=SHAPE(l4_tke_mxlm)
+      l4_tke_extents(:,13)=SHAPE(l4_tke_mxld)
+      l4_tke_extents(:,14)=SHAPE(l4_tke_avm)
+      l4_tke_extents(:,15)=SHAPE(l4_tke_avt)
+      l4_tke_extents(:,16)=SHAPE(l4_tke_dissl)
+      l4_tke_extents(:,17)=(/jpi,jpj,1/)
+      l4_tke_extents(:,18)=(/jpi,jpj,1/)
+      l4_tke_extents(:,19)=(/jpi,jpj,1/)
+      l4_tke_extents(:,20)=(/jpi,jpj,1/)
+      l4_tke_extents(:,21)=(/jpi,jpj,1/)
+      l4_tke_payload=0
+      DO l4_tke_ifield=1,21
+         l4_tke_payload=l4_tke_payload+PRODUCT(l4_tke_extents(:,l4_tke_ifield))
+      END DO
+      WRITE(l4_tke_filename,'("oracle_tke_walk_kt",I8.8,".bin")') kt
+      OPEN( NEWUNIT=l4_tke_unit, FILE=TRIM(l4_tke_filename), ACCESS='STREAM', FORM='UNFORMATTED', &
+         & STATUS='REPLACE', ACTION='WRITE', IOSTAT=l4_tke_ios )
+      IF( l4_tke_ios /= 0 ) CALL ctl_stop( 'cannot open lane4 tke-walk dump' )
+      l4_tke_magic='NEMO_L4_TKEW_1'
+      WRITE(l4_tke_unit) l4_tke_magic, 1, kt, Kbb, Kmm, jpi, jpj, jpk, &
+         & STORAGE_SIZE(1._wp), 16, 5, l4_tke_payload, nn_eice, nn_etau, nn_mxl, nn_pdl
+      WRITE(l4_tke_unit) l4_tke_extents
+      WRITE(l4_tke_unit) l4_tke_zpelc, l4_tke_en_lc, l4_tke_pdlr, &
+         & l4_tke_zdiag_pre, l4_tke_zdlw_pre, l4_tke_zdup_pre, l4_tke_en_rhs, &
+         & l4_tke_zdiag_fwd, l4_tke_zdlw_fwd, l4_tke_en_solved, l4_tke_en_etau, &
+         & l4_tke_mxlm, l4_tke_mxld, l4_tke_avm, l4_tke_avt, l4_tke_dissl, &
+         & l4_tke_zice, l4_tke_zwlc2, l4_tke_imlc, l4_tke_zhlc, l4_tke_zus3
+      CLOSE(l4_tke_unit)
+      DEALLOCATE( l4_tke_zice, l4_tke_zwlc2, l4_tke_imlc, l4_tke_zhlc, &
+         & l4_tke_zus3, l4_tke_zpelc, l4_tke_en_lc, l4_tke_pdlr, &
+         & l4_tke_zdiag_pre, l4_tke_zdlw_pre, l4_tke_zdup_pre, l4_tke_en_rhs, &
+         & l4_tke_zdiag_fwd, l4_tke_zdlw_fwd, l4_tke_en_solved, l4_tke_en_etau, &
+         & l4_tke_mxlm, l4_tke_mxld, l4_tke_avm, l4_tke_avt, l4_tke_dissl )
+      l4_tke_dump=.FALSE.
+      WRITE(numout,*) 'LANE4_TKE_WALK_DUMP ', kt, Kbb, Kmm
+   END SUBROUTINE l4_tke_write
