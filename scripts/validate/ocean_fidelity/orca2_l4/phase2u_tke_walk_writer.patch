+   SUBROUTINE l4_tke_begin( kt )
+      INTEGER, INTENT(in) :: kt
+      INTEGER :: l4_tke_ios
+      l4_tke_dump = lwp .AND. .NOT.ln_tile .AND. kt == nit000 + 1
+      IF( .NOT.l4_tke_dump ) RETURN
+      ALLOCATE( l4_tke_zice(jpi,jpj), l4_tke_zwlc2(jpi,jpj), &
+         & l4_tke_imlc(jpi,jpj), l4_tke_zhlc(jpi,jpj), l4_tke_zus3(jpi,jpj), &
+         & l4_tke_zpelc(jpi,jpj,jpk), l4_tke_en_lc(jpi,jpj,jpk), &
+         & l4_tke_pdlr(jpi,jpj,jpk), l4_tke_zdiag_pre(jpi,jpj,jpk), &
+         & l4_tke_zdlw_pre(jpi,jpj,jpk), l4_tke_zdup_pre(jpi,jpj,jpk), &
+         & l4_tke_en_rhs(jpi,jpj,jpk), l4_tke_zdiag_fwd(jpi,jpj,jpk), &
+         & l4_tke_zdlw_fwd(jpi,jpj,jpk), l4_tke_en_solved(jpi,jpj,jpk), &
+         & l4_tke_en_etau(jpi,jpj,jpk), l4_tke_mxlm(jpi,jpj,jpk), &
+         & l4_tke_mxld(jpi,jpj,jpk), l4_tke_avm(jpi,jpj,jpk), &
+         & l4_tke_avt(jpi,jpj,jpk), l4_tke_dissl(jpi,jpj,jpk), STAT=l4_tke_ios )
+      IF( l4_tke_ios /= 0 ) CALL ctl_stop( 'cannot allocate lane4 tke-walk dump storage' )
+      l4_tke_zice=0._wp ; l4_tke_zwlc2=0._wp ; l4_tke_imlc=0._wp
+      l4_tke_zhlc=0._wp ; l4_tke_zus3=0._wp ; l4_tke_zpelc=0._wp
+      l4_tke_en_lc=0._wp ; l4_tke_pdlr=0._wp ; l4_tke_zdiag_pre=0._wp
+      l4_tke_zdlw_pre=0._wp ; l4_tke_zdup_pre=0._wp ; l4_tke_en_rhs=0._wp
+      l4_tke_zdiag_fwd=0._wp ; l4_tke_zdlw_fwd=0._wp ; l4_tke_en_solved=0._wp
+      l4_tke_en_etau=0._wp ; l4_tke_mxlm=0._wp ; l4_tke_mxld=0._wp
+      l4_tke_avm=0._wp ; l4_tke_avt=0._wp ; l4_tke_dissl=0._wp
+   END SUBROUTINE l4_tke_begin
+
