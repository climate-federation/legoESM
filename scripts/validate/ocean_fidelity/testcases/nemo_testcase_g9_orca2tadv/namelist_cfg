   ln_abl      = .false.
   ln_cpl      = .false.
   ln_mixcpl   = .false.
   nn_components = 0
   nn_ice      = 2         !  G5: ORCA2 sea ice (ORCA2 :85)
   ln_ice_embd = .false.
   ln_traqsr   = .true.    !  ORCA2 :89
   ln_dm2dc    = .false.
   ln_ssr      = .true.    !  ORCA2 :90
   nn_fwb      = 2         !  ORCA2 :92
   ln_rnf      = .true.    !  ORCA2 :91
   ln_apr_dyn  = .false.
   ln_wave     = .false.
   nn_lsm      = 0
