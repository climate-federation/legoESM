+def _nemo_een_north_t(field, grid, fold_image):
+    """North T neighbour of every row for ``dom_qco_r3c_RK3``'s ``jj+1`` read.
+
+    ``domqco.f90:268-269`` (``pr3v``) and ``:281-285`` (``pr3f``) read
+    ``e1e2t*pssh`` on row ``jj+1``.  On the stored pivot row that is NEMO's
+    T fold halo: the T-permuted image of the row below the pivot, sign +1.
+    ``stprk3_stg.f90:163`` then exchanges the results, and
+    ``dynspg_ts.f90:960-981`` and ``:987-1008`` consume them on the pivot
+    row.  ``fold_image=False`` is the legacy cyclic roll, which hands the
+    pivot row the SOUTH row instead (inert on a closed box; first order
+    wrong in ssh on a fold).  Selected by
+    ``BarotropicConfig.barotropic_een_fold_image_ssh``.
+    """
+    north = jnp.roll(field, -1, axis=0)
+    if not fold_image:
+        return north
+    fold = getattr(grid, "fold", None)
+    if not (fold_is_local(grid)
+            and bool(getattr(fold, "pivot_row_stored", False))):
+        raise ValueError(
+            "barotropic_een_fold_image_ssh=True needs a local T-pivot north "
+            "fold whose pivot row is the stored top row")
+    return north.at[-1].set(fold_ghost_source_T(field, fold)[0][fold.perm_T])
