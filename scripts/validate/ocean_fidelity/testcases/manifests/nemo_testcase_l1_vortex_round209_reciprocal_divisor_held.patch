--- /dev/null
+++ b/tests/ocean/fidelity/test_nemo_testcase_l1_vortex_round209_reciprocal_divisor.py
@@ -0,0 +1,157 @@
+"""Round 209 pin: the RK3 transport target multiplies NEMO's STORED reciprocal.
+
+``stprk3_stg.f90:270`` (the ``CASE ( np_LIN, np_HYB )`` arm the module
+default ``n_baro_upd = np_HYB`` at ``:48`` selects) writes
+
+    zub(ji,jj) = un_adv(ji,jj)*(r1_hu_0(ji,jj) /(1._wp+r3u(ji,jj,Kmm))) - uu_b(ji,jj,Kmm)
+
+-- a MULTIPLY by a reciprocal built once in ``domain.f90:213``
+(``r1_hu_0 = ssumask/(hu_0 + 1 - ssumask)`` over
+``hu_0 = SUM_k e3t_1d*umask``, ``domain.f90:194-199``) and divided by
+``1 + r3u(Kmm)`` (``domqco.f90:266-267``, the ``dom_qco_r3c_RK3`` entry).  Round 206 landed the algebraically
+equal DIVIDE by ``SUM_k e3u_0*(1 + r3u*umask)``; round 209 transcribes the
+association.
+
+Two things are asserted, and neither can pass on the reverted code:
+
+* the two forms are NOT the same bits on this card, so the association is
+  observable at all (this is the non-vacuity of the second assertion);
+* the production step is the MULTIPLY one -- proven by substituting the
+  divide form into the one kernel the statement reads and requiring the
+  step to move.  Revert the landing and the substitution becomes a no-op
+  and this test fails.
+"""
+from __future__ import annotations
+
+import inspect
+
+import jax
+import numpy as np
+import pytest
+
+from legoesm.core.precision import PrecisionPolicy, get_policy, set_policy
+
+CASE = "VORTEX-zco"
+
+
+@pytest.fixture(scope="module")
+def fp64():
+    old = get_policy()
+    set_policy(PrecisionPolicy.fp64(transcendentals="libm"))
+    yield
+    set_policy(old)
+
+
+def _card_and_model():
+    from legoesm.ocean.dynamics.ocean_model_latlon_cgrid import (
+        LatLonCGridOceanModel,
+    )
+    from legoesm.ocean.fidelity.nemo_testcase_recipe import (
+        build_nemo_testcase_card,
+    )
+
+    card = build_nemo_testcase_card(CASE)
+    return card, LatLonCGridOceanModel(
+        card.recipe.grid, card.recipe.z_coord, card.recipe.model_config)
+
+
+def test_the_two_associations_are_not_the_same_bits(fp64):
+    """Non-vacuity of the pin below: the reciprocal and ``1/SUM(e3u)`` differ.
+
+    If they were bit-identical the substitution control could never move the
+    step and the pin would be a smoke test.
+    """
+    import jax.numpy as jnp
+
+    from legoesm.ocean.dynamics.latlon_cgrid_operators import (
+        compute_face_masks_3d,
+    )
+    from legoesm.ocean.dynamics.ocean_model_latlon_cgrid import (
+        _nemo_ws_qco_stage_faces,
+    )
+    from legoesm.ocean.fidelity.nemo_testcase_recipe import (
+        build_nemo_testcase_card,
+    )
+    from legoesm.ocean.vertical import compute_layer_thickness
+
+    card = build_nemo_testcase_card(CASE)
+    state = card.recipe.initial_state
+    z_coord = card.recipe.z_coord
+    h_ref = compute_layer_thickness(
+        jnp.zeros_like(state.eta.data), state.H_bathy.data, z_coord,
+        min_water_column_m=card.recipe.model_config.min_water_column_m)
+    umask3, vmask3 = compute_face_masks_3d(z_coord.is_active, card.recipe.grid)
+    faces = _nemo_ws_qco_stage_faces(
+        state.eta.data, h_ref, umask3.astype(state.eta.data.dtype),
+        vmask3.astype(state.eta.data.dtype), card.recipe.grid,
+        include_reciprocals=True)
+    r1_hu = np.asarray(faces[4])
+    summed = np.asarray(jnp.sum(faces[0], axis=-1))
+    wet = r1_hu > 0.0
+    assert wet.any()
+    # Same value to rounding -- it IS the same depth ...
+    rel = np.abs(1.0 / summed[wet] - r1_hu[wet]) / r1_hu[wet]
+    assert rel.max() < 1.0e-14
+    # ... and not the same bits, which is what this round is about.
+    assert np.any(1.0 / summed[wet] != r1_hu[wet])
+    # NEMO's reciprocal is EXACTLY zero on a closed face (ssumask = 0), which
+    # is why the divide's dry-column guard is not needed once it is gone.
+    # Asserted against the mask that actually multiplies the target, in BOTH
+    # directions -- ``r1_hu[~wet] == 0`` alone is true by the definition of
+    # ``wet`` and would prove nothing.
+    u_mask = np.asarray(state.u_mask.data) > 0.0
+    assert np.array_equal(wet, u_mask)
+
+
+def test_production_multiplies_the_stored_reciprocal(fp64):
+    """ROUND 209 PIN.
+
+    Substitute the DIVIDE form into the kernel the statement reads.  The
+    production step must move; on the pre-round-209 code it cannot, because
+    production would already be computing that same quotient.
+    """
+    import jax.numpy as jnp
+
+    from legoesm.ocean.dynamics import ocean_model_latlon_cgrid as mod
+
+    card, model = _card_and_model()
+    initial = card.recipe.initial_state
+    plain = model.step(initial, dt=card.dt_s)
+
+    real = mod._nemo_ws_qco_stage_faces
+
+    def divide_form(*args, include_reciprocals=False, **kwargs):
+        out = real(*args, include_reciprocals=include_reciprocals, **kwargs)
+        if not include_reciprocals:
+            return out
+        # ISOLATE THE STATEMENT.  The same kernel also serves
+        # ``_nemo_ws_stage_transport``'s own reciprocal, which this round
+        # does not touch; substituting there too would move the step no
+        # matter what the transport target does and the pin would pass on
+        # the reverted code (it did, when first written).  Leave that
+        # consumer alone and substitute ONLY in the caller that holds
+        # round 209's statement -- ``_step_impl``, the enclosing function
+        # of the ``transport_target_u/v`` lines.
+        if inspect.stack()[1].function != "_step_impl":
+            return out
+        h_u = jnp.sum(out[0], axis=-1)
+        h_v = jnp.sum(out[1], axis=-1)
+        return out[:4] + (
+            jnp.where(h_u > 0.0, 1.0 / jnp.where(h_u > 0.0, h_u, 1.0), 0.0),
+            jnp.where(h_v > 0.0, 1.0 / jnp.where(h_v > 0.0, h_v, 1.0), 0.0),
+        )
+
+    mod._nemo_ws_qco_stage_faces = divide_form
+    try:
+        _, armed_model = _card_and_model()
+        armed = armed_model.step(initial, dt=card.dt_s)
+    finally:
+        mod._nemo_ws_qco_stage_faces = real
+
+    moved = max(
+        float(np.abs(np.asarray(a) - np.asarray(b)).max())
+        for a, b in zip(jax.tree_util.tree_leaves(armed),
+                        jax.tree_util.tree_leaves(plain)))
+    assert moved > 0.0
+    for leaf in jax.tree_util.tree_leaves(armed):
+        assert np.all(np.isfinite(np.asarray(leaf)))
