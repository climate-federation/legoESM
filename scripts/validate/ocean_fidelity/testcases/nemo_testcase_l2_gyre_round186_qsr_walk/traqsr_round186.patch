+
+   SUBROUTINE qsr_2BD_l2_replay( Kmm, pinc )
+      !! Post-call diagnostic replay of the compiled qsr_2BD statements.
+      INTEGER, INTENT(in) :: Kmm
+      REAL(wp), DIMENSION(jpi,jpj,jpk), INTENT(out) :: pinc
+      INTEGER :: ji, jj, jk
+      REAL(wp) :: zzatt, zz0, zz1, ze3t
+      REAL(wp), DIMENSION(ntsi-(0):ntei+(0),ntsj-(0):ntej+(0)) :: zatt
+      pinc(:,:,:) = 0._wp
+      zz0 = rn_abs * r1_rho0_rcp
+      zz1 = ( 1._wp - rn_abs ) * r1_rho0_rcp
+      zatt(ntsi-(0):ntei+(0),ntsj-(0):ntej+(0)) = r1_rho0_rcp
+      DO jj = ntsj-(0), ntej+(0) ; DO ji = ntsi-(0), ntei+(0)
+         zatt(ji,jj) = zz0 * EXP( -(gdepw_1d(1)*(1._wp+r3t(ji,jj,Kmm)))*r1_si0 ) &
+            &        + zz1 * EXP( -(gdepw_1d(1)*(1._wp+r3t(ji,jj,Kmm)))*r1_si1 )
+      END DO ; END DO
+      DO jk = 1, nk0
+         DO jj = ntsj-(0), ntej+(0) ; DO ji = ntsi-(0), ntei+(0)
+            ze3t = e3t_3d(ji,jj,jk) * (1._wp+r3t(ji,jj,Kmm)*tmask(ji,jj,jk))
+            zzatt = ( zz0 * EXP( -(gdepw_1d(jk+1)*(1._wp+r3t(ji,jj,Kmm)))*r1_si0 ) &
+               &    + zz1 * EXP( -(gdepw_1d(jk+1)*(1._wp+r3t(ji,jj,Kmm)))*r1_si1 ) ) * wmask(ji,jj,jk+1)
+            pinc(ji,jj,jk) = qsr(ji,jj) * ( zatt(ji,jj) - zzatt ) / ze3t
+            zatt(ji,jj) = zzatt
+         END DO ; END DO
+      END DO
+      DO jk = nk0+1, nkV
+         DO jj = ntsj-(0), ntej+(0) ; DO ji = ntsi-(0), ntei+(0)
+            ze3t = e3t_3d(ji,jj,jk) * (1._wp+r3t(ji,jj,Kmm)*tmask(ji,jj,jk))
+            zzatt = zz1 * EXP( -(gdepw_1d(jk+1)*(1._wp+r3t(ji,jj,Kmm)))*r1_si1 ) * wmask(ji,jj,jk+1)
+            pinc(ji,jj,jk) = qsr(ji,jj) * ( zatt(ji,jj) - zzatt ) / ze3t
+            zatt(ji,jj) = zzatt
+         END DO ; END DO
+      END DO
+   END SUBROUTINE qsr_2BD_l2_replay
 
