+   SUBROUTINE l2_dump_zdf( kstp, klevel )
+      !! Lane-4 read-only stage-entry TKE/viscosity instrument.  The call is
+      !! directly after zdf_phy and before stp_2D; no state array is set.
+      INTEGER, INTENT(in) :: kstp, klevel
+      INTEGER :: iunit, ios
+      CHARACTER(LEN=16) :: magic
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'lane2 zdf dump requires 64-bit wp' )
+      OPEN( NEWUNIT=iunit, FILE='oracle_zdf_entry_kt00000001.bin', ACCESS='STREAM', &
+         &  FORM='UNFORMATTED', STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane2 zdf file' )
+      magic = 'NEMO_L4_ZDF___2'
+      WRITE(iunit) magic, 2, kstp, klevel, jpi, jpj, jpk, STORAGE_SIZE(1._wp)
+      WRITE(iunit) l4_canon_3d(avm,'T'), l4_canon_3d(avt,'T'), &
+         & l4_canon_3d(avs,'T'), l4_canon_3d(en,'T')
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE2_ZDF_ENTRY_DUMP ', kstp, klevel
+   END SUBROUTINE l2_dump_zdf
