+      INTEGER :: iunit, ios
+      CHARACTER(LEN=16) :: magic
+      IF( .NOT.lwp ) RETURN
+      OPEN( NEWUNIT=iunit, FILE='oracle_rhs_kt00000001.bin', ACCESS='STREAM', &
+         &  FORM='UNFORMATTED', STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane1 rhs file' )
+      magic = 'NEMO_L1_RHS___1'
+      WRITE(iunit) magic, 1, kstp, klevel, jpi, jpj, jpk, STORAGE_SIZE(1._wp)
+      WRITE(iunit) l4_canon_3d(uu(:,:,:,klevel),'U'), l4_canon_3d(vv(:,:,:,klevel),'V')
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE1_RHS_DUMP ', kstp, klevel
+   END SUBROUTINE l1_dump_rhs
+
