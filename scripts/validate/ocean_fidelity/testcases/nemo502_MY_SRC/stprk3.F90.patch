+   SUBROUTINE l1_dump_bt_frames( kstp, klevel )
+      !! Phase-3 frame instrument, immediately after stp_2D.  puu_b/pvv_b at
+      !! Kaa are the primary velocity-weighted substep average committed by
+      !! RK3; un_adv/vn_adv are the distinct transport-weighted time means.
+      INTEGER, INTENT(in) :: kstp, klevel
+      INTEGER :: iunit, ios
+      CHARACTER(LEN=96) :: filename
+      CHARACTER(LEN=16) :: magic
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'lane1 frame dump requires 64-bit wp' )
+      WRITE(filename,'("oracle_bt_frames_kt",I8.8,".bin")') kstp
+      OPEN( NEWUNIT=iunit, FILE=TRIM(filename), ACCESS='STREAM', FORM='UNFORMATTED', &
+         &  STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane1 frame file' )
+      magic = 'NEMO_L1_BTFRM_1'
+      WRITE(iunit) magic, 1, kstp, klevel, jpi, jpj, STORAGE_SIZE(1._wp)
+      WRITE(iunit) l4_canon_2d(uu_b(:,:,klevel),'U'), l4_canon_2d(vv_b(:,:,klevel),'V'), &
+         & l4_canon_2d(un_adv(:,:),'U'), l4_canon_2d(vn_adv(:,:),'V')
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE1_BT_FRAME_DUMP ', kstp, klevel, TRIM(filename)
+   END SUBROUTINE l1_dump_bt_frames
+
+
+   SUBROUTINE l1_dump_stage( kstp, kstage, klevel )
+      !! Phase-3 read-only stage-state instrument.  The call sites above pin
+      !! Kaa before each Nnn/Naa swap; no prognostic field is assigned here.
+      INTEGER, INTENT(in) :: kstp, kstage, klevel
+      INTEGER :: iunit, ios
+      CHARACTER(LEN=96) :: filename
+      CHARACTER(LEN=16) :: magic
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'lane1 stage dump requires 64-bit wp' )
+      WRITE(filename,'("oracle_stage_kt",I8.8,"_s",I1,".bin")') kstp, kstage
+      OPEN( NEWUNIT=iunit, FILE=TRIM(filename), ACCESS='STREAM', FORM='UNFORMATTED', &
+         &  STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane1 stage file' )
+      magic = 'NEMO_L1_STAGE_1'
+      WRITE(iunit) magic, 1, kstp, kstage, klevel, jpi, jpj, jpk, jpts, STORAGE_SIZE(1._wp)
+      WRITE(iunit) l4_canon_4d(ts(:,:,:,:,klevel),'T'), &
+         & l4_canon_3d(uu(:,:,:,klevel),'U'), l4_canon_3d(vv(:,:,:,klevel),'V'), &
+         & l4_canon_2d(ssh(:,:,klevel),'T')
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE1_STAGE_DUMP ', kstp, kstage, klevel, TRIM(filename)
+   END SUBROUTINE l1_dump_stage
+
+
+   SUBROUTINE l1_dump_rhs( kstp, klevel )
