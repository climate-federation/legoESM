+   SUBROUTINE l4_dump_ocean_surface_input( kstp, klevel )
+      !! Lane-4 Phase-2b read-only final surface-input instrument.  Its call
+      !! is immediately after sbc returns, after SI3, iceberg, runoff, FWB,
+      !! halo exchange and U/V stress interpolation.  No model array is set.
+      INTEGER, INTENT(in) :: kstp, klevel
+      INTEGER :: iunit, ios
+      INTEGER, PARAMETER :: in2d_full = 20, in2d_reduced = 12, in2d_halo1 = 1, in3d_reduced = 2
+      INTEGER, PARAMETER :: ihalo = 2
+      CHARACTER(LEN=16) :: magic
+      REAL(wp), DIMENSION(jpi,jpj) :: zicb_zero
+      IF( .NOT.lwp ) RETURN
+      IF( STORAGE_SIZE( 1._wp ) /= 64 )   CALL ctl_stop( 'lane4 surface input dump requires 64-bit wp' )
+      OPEN( NEWUNIT=iunit, FILE='oracle_ocean_surface_input_kt00000001.bin', ACCESS='STREAM', &
+         &  FORM='UNFORMATTED', STATUS='REPLACE', ACTION='WRITE', IOSTAT=ios )
+      IF( ios /= 0 )   CALL ctl_stop( 'cannot open lane4 surface input file' )
+      magic = 'NEMO_L4_SBCIN_1'
+      WRITE(iunit) magic, 1, kstp, klevel, jpi, jpj, jpts, nclasses, ihalo, &
+         &                  in2d_full, in2d_reduced, in2d_halo1, in3d_reduced, STORAGE_SIZE(1._wp)
+      IF( ln_icebergs ) THEN
+         WRITE(iunit) l4_canon_2d(utau,'T'), l4_canon_2d(vtau,'T'), &
+            & l4_canon_2d(utauU,'U'), l4_canon_2d(vtauV,'V'), &
+            & l4_canon_2d(utau_b,'T'), l4_canon_2d(vtau_b,'T'), &
+            & l4_canon_2d(utau_icb,'T'), l4_canon_2d(vtau_icb,'T'), &
+            & l4_canon_2d(taum,'T'), l4_canon_2d(wndm,'T')
+      ELSE
+         ! icb_init returns before allocating these component fields when the
+         ! selected deck disables icebergs.  Emit writer-local zero placeholders
+         ! for the frozen schema; no model array is assigned or dereferenced.
+         zicb_zero(:,:) = 0._wp
+         WRITE(iunit) l4_canon_2d(utau,'T'), l4_canon_2d(vtau,'T'), &
+            & l4_canon_2d(utauU,'U'), l4_canon_2d(vtauV,'V'), &
+            & l4_canon_2d(utau_b,'T'), l4_canon_2d(vtau_b,'T'), &
+            & zicb_zero, zicb_zero, l4_canon_2d(taum,'T'), l4_canon_2d(wndm,'T')
+      ENDIF
+      WRITE(iunit) l4_canon_2d(qsr,'T'), l4_canon_2d(qns,'T'), l4_canon_2d(qns_b,'T'), &
+         & l4_canon_2d(qsr_tot,'T'), l4_canon_2d(qns_tot,'T'), l4_canon_2d(emp,'T'), &
+         & l4_canon_2d(emp_b,'T'), l4_canon_2d(sfx,'T'), l4_canon_2d(sfx_b,'T'), &
+         & l4_canon_2d(emp_tot,'T')
+      WRITE(iunit) l4_canon_2d(fwfice,'T'), l4_canon_2d(rnf,'T'), &
+         & l4_canon_2d(rnf_b,'T'), l4_canon_2d(fwficb,'T'), l4_canon_2d(fr_i,'T')
+      WRITE(iunit) l4_canon_2d(snwice_mass,'T'), l4_canon_2d(snwice_mass_b,'T'), &
+         & l4_canon_2d(snwice_fmass,'T'), l4_canon_2d(rCdU_ice,'T')
+      IF( ln_icebergs ) THEN
+         WRITE(iunit) l4_canon_2d(berg_grid%calving,'T'), l4_canon_2d(berg_grid%calving_hflx,'T'), &
+            & l4_canon_2d(berg_grid%floating_melt,'T'), l4_canon_2d(berg_grid%stored_heat,'T')
+      ELSE
+         WRITE(iunit) zicb_zero, zicb_zero, zicb_zero, zicb_zero
+      ENDIF
+      WRITE(iunit) l4_canon_3d(rnf_tsc,'T'), l4_canon_3d(rnf_tsc_b,'T')
+      CLOSE(iunit)
+      WRITE(numout,*) 'LANE4_OCEAN_SURFACE_INPUT_DUMP ', kstp, klevel
+   END SUBROUTINE l4_dump_ocean_surface_input
+
