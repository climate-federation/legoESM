+   SUBROUTINE l3bulk_dump_folded_constants
+      !! WRITE-only lane-3b oracle instrument.  These are compiler-folded
+      !! binary64 operands on the active SI3 bulk path; no model state is read
+      !! or changed.  Called once from sbc_blk_init.
+      INTEGER ::   inum
+      REAL(wp), DIMENSION(4) ::   zvalues
+      zvalues(1) = reps0
+      zvalues(2) = rgamma_dry
+      zvalues(3) = rDg_i
+      zvalues(4) = LOG(10._wp)
+      OPEN( NEWUNIT=inum, FILE='oracle_si3_folded_constants.bin', &
+         &  ACCESS='STREAM', FORM='UNFORMATTED', STATUS='REPLACE', ACTION='WRITE' )
+      WRITE(inum) zvalues
+      CLOSE(inum)
+   END SUBROUTINE l3bulk_dump_folded_constants
 
 
