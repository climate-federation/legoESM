+   SUBROUTINE trddump_tau( puinc, pvinc )
+      !!---------------------------------------------------------------------
+      !! #1455. Populate the instantaneous tau slot from dyn_zdf's exact
+      !! post-minus-pre level-1 stress increment. Keep levels 2:jpk zero and
+      !! do not touch utrd_acc/nacc_trd: tau is not a member of the registered
+      !! nine-term interval closure and this hook fires only on nit000.
+      !!---------------------------------------------------------------------
+      REAL(wp), DIMENSION(jpi,jpj), INTENT(in) ::   puinc, pvinc
+      INTEGER ::   ji, jj
+      !!---------------------------------------------------------------------
+      IF( .NOT. ALLOCATED( utrd_store ) ) THEN
+         ALLOCATE( utrd_store(jpi,jpj,jpk,jptot_dyn), vtrd_store(jpi,jpj,jpk,jptot_dyn) )
+         utrd_store(:,:,:,:) = 0._wp   ;   vtrd_store(:,:,:,:) = 0._wp
+      ENDIF
+      ! A restart may be written after other trend calls have reused the
+      ! store. Clear this diagnostic slot explicitly before filling level 1.
+      utrd_store(:,:,:,jpdyn_tau) = 0._wp
+      vtrd_store(:,:,:,jpdyn_tau) = 0._wp
+      DO jj = Njs0, Nje0
+         DO ji = Nis0, Nie0
+            utrd_store(ji,jj,1,jpdyn_tau) = puinc(ji,jj) * r1_Dt
+            vtrd_store(ji,jj,1,jpdyn_tau) = pvinc(ji,jj) * r1_Dt
+         END DO
+      END DO
+   END SUBROUTINE trddump_tau
+
