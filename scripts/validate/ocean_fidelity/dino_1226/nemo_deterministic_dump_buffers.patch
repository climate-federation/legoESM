+++ b/cfgs/DINO/MY_SRC/dino_dump_zero.F90
@@ -0,0 +1,44 @@
+MODULE dino_dump_zero
+   !!======================================================================
+   !! Deterministic raw-stream writer for DINO fidelity instrumentation.
+   !! Production arrays are INTENT(in) and are never modified.  Only the
+   !! physical interior is copied into a fully zero-initialized haloed
+   !! buffer, so debug streams cannot expose uninitialized halo storage.
+   !!======================================================================
+   USE par_kind, ONLY : wp
+   USE par_oce , ONLY : jpi, jpj, jpk, jpkm1, Nis0, Nie0, Njs0, Nje0
+
+   IMPLICIT NONE
+   PRIVATE
+
+   PUBLIC :: dino_dump_2d, dino_dump_3d
+
+CONTAINS
+
+   SUBROUTINE dino_dump_2d( kunit, pfield )
+      INTEGER , INTENT(in) :: kunit
+      REAL(wp), DIMENSION(Nie0-Nis0+1,Nje0-Njs0+1), INTENT(in) :: pfield
+
+      INTEGER :: ji, jj
+      REAL(wp), DIMENSION(jpi,jpj) :: zbuffer
+
+      zbuffer(:,:) = 0._wp
+      zbuffer(Nis0:Nie0,Njs0:Nje0) = pfield(:,:)
+      WRITE(kunit) ( ( zbuffer(ji,jj), ji=1,jpi ), jj=1,jpj )
+   END SUBROUTINE dino_dump_2d
+
+
+   SUBROUTINE dino_dump_3d( kunit, pfield )
+      INTEGER , INTENT(in) :: kunit
+      REAL(wp), DIMENSION(Nie0-Nis0+1,Nje0-Njs0+1,jpkm1-1), INTENT(in) :: pfield
+
+      REAL(wp), ALLOCATABLE, DIMENSION(:,:,:) :: zbuffer
+
+      ALLOCATE( zbuffer(jpi,jpj,jpk) )
+      zbuffer(:,:,:) = 0._wp
+      zbuffer(Nis0:Nie0,Njs0:Nje0,2:jpkm1) = pfield(:,:,:)
+      WRITE(kunit) zbuffer
+      DEALLOCATE( zbuffer )
+   END SUBROUTINE dino_dump_3d
+
+END MODULE dino_dump_zero
