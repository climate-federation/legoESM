#!/bin/bash
# Derecho PBS batch: global biophysics-only LMIP run (config-driven).
#
# Instantiates an experiment from a template with ``scripts/run/init_experiment.py``
# (applying any qsub -v overrides), then runs ``scripts/run/run_lmip_biophys.py
# --config`` against the real CRU-JRA reanalysis on glade + the Zenodo-hosted
# CLM5 surfdata (staged by ``scripts/data/download_lmip_data.sh``).
#
# Default template: biophysics/lmip_canopy_4deg_smoke — a ~4 deg global shakedown
# (two_leaf_canopy + MOST + soil freeze/thaw ON), the small-first test before
# scaling to the 2 deg lmip_canopy_10yr production spin-up.
#
# Usage:
#   qsub -A <ACCOUNT> scripts/cluster/derecho_lmip/lmip_biophys.pbs
#   qsub -A <ACCOUNT> -v TEMPLATE=biophysics/lmip_canopy_10yr,RESOLUTION=90 \
#        scripts/cluster/derecho_lmip/lmip_biophys.pbs
#
# Requirements before submitting:
#   1) The batch script activates the conda env itself (PBS shells inherit NOTHING
#      from the submitting login shell).  Default env name is 'legoesm-lmip';
#      override with 'qsub -v LEGOESM_CONDA_ENV=<name>'.
#   2) Data staged under repo-relative data/:
#        ./scripts/data/download_lmip_data.sh --year 1920
#   3) qsub from the repo root (PBS_O_WORKDIR = repo root).
#
# Override knobs via qsub -v (all optional; unset = the template's own default):
#   LEGOESM_CONDA_ENV=legoesm-lmip  — conda env with jax + xarray + legoesm
#   TEMPLATE=biophysics/lmip_canopy_4deg_smoke  — any templates/land/<name>.yaml
#   YEAR=""                         — override forcing.year_start (CRU-JRA year)
#   YEAR_END=""                     — override forcing.year_end (multi-year span)
#   RESOLUTION=""                   — override grid.resolution (latlon N; 45=4deg, 90=2deg)
#   DT=""                           — override time.dt [s]
#   N_STEPS=""                      — override time.n_steps
#   START_DOY=""                    — override time.start_doy
#   SURFACE_SCHEME=""               — override physics.surface_scheme (two_leaf_canopy|simple_seb)
#   BULK=""                         — override physics.bulk_scheme (most|constant)
#   FREEZE_THAW=""                  — override physics.enable_freeze_thaw (true|false)
#   RESTART_FROM=""                 — warm-start seed .npz (chained spin-up); empty = cold
#   OUT_TAG=""                      — appended to the experiment dir name
#
# NOTE: simple_seb + MOST is numerically fragile; pair SURFACE_SCHEME=simple_seb
# with BULK=constant.  The default template (two_leaf_canopy + MOST) is stable.
#
#PBS -N lmip_biophys
#PBS -l select=1:ncpus=8:mem=32GB
#PBS -l walltime=02:00:00
#PBS -q main
#PBS -l job_priority=premium
#PBS -j oe

set -euo pipefail

# --- knobs (empty = use the template's own value) ---
TEMPLATE="${TEMPLATE:-biophysics/lmip_canopy_4deg_smoke}"
YEAR="${YEAR:-}"
YEAR_END="${YEAR_END:-}"
RESOLUTION="${RESOLUTION:-}"
DT="${DT:-}"
N_STEPS="${N_STEPS:-}"
START_DOY="${START_DOY:-}"
SURFACE_SCHEME="${SURFACE_SCHEME:-}"
BULK="${BULK:-}"
FREEZE_THAW="${FREEZE_THAW:-}"
RESTART_FROM="${RESTART_FROM:-}"
OUT_TAG="${OUT_TAG:-}"

# Cheap queue-saving guard: simple_seb + MOST is fragile.  Only trips when BOTH
# are explicitly overridden to that combination.
if [[ "$SURFACE_SCHEME" == "simple_seb" && "$BULK" == "most" ]]; then
    echo "ERROR: SURFACE_SCHEME=simple_seb + BULK=most is numerically fragile." >&2
    echo "       Pair simple_seb with BULK=constant, or use two_leaf_canopy." >&2
    exit 4
fi

# PBS_O_WORKDIR = the directory qsub was called from = the repo root.
cd "${PBS_O_WORKDIR:-$PWD}"

# --- activate the legoesm conda env (PBS shells inherit NOTHING from login) ---
LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-lmip}"
module purge
module load conda
set +u   # `conda activate` references unbound vars internally
conda activate "$LEGOESM_CONDA_ENV"
set -u

python -c "import jax, xarray, netCDF4, legoesm" 2>/dev/null || {
    echo "ERROR: legoesm/jax/xarray/netCDF4 not importable in env '$LEGOESM_CONDA_ENV'." >&2
    echo "       activate the right env, or set LEGOESM_CONDA_ENV via 'qsub -v'." >&2
    which python; python --version
    exit 3
}

# --- experiment dir under scratch ---
EXPT_NAME="$(basename "$TEMPLATE")${OUT_TAG}"
OUT_DIR="${SCRATCH:-$PWD/results/derecho_lmip}/lmip_${EXPT_NAME}"
mkdir -p "$OUT_DIR"

# --- build init_experiment overrides from the set knobs only ---
OVERRIDES=()
add_o() { if [[ -n "${2:-}" ]]; then OVERRIDES+=(-o "$1=$2"); fi; }
add_o forcing.year_start        "$YEAR"
add_o forcing.year_end          "$YEAR_END"
add_o grid.resolution           "$RESOLUTION"
add_o time.dt                   "$DT"
add_o time.n_steps              "$N_STEPS"
add_o time.start_doy            "$START_DOY"
add_o physics.surface_scheme    "$SURFACE_SCHEME"
add_o physics.bulk_scheme       "$BULK"
add_o physics.enable_freeze_thaw "$FREEZE_THAW"

echo "=================================================================="
echo "LMIP biophysics run (config-driven)"
echo "  repo:        $PWD"
echo "  branch:      $(git rev-parse --abbrev-ref HEAD)  ($(git rev-parse --short HEAD))"
echo "  conda env:   $LEGOESM_CONDA_ENV"
echo "  python:      $(which python)  ($(python --version 2>&1))"
echo "  template:    $TEMPLATE"
echo "  overrides:   ${OVERRIDES[*]:-<none — template defaults>}"
echo "  restart:     ${RESTART_FROM:-<cold start>}"
echo "  out:         $OUT_DIR"
echo "=================================================================="

export JAX_ENABLE_X64=1
export PYTHONPATH="${PYTHONPATH:-}:$PWD"

# --- 1. instantiate the resolved config.yaml (validates the schema too) ---
python scripts/run/init_experiment.py "$TEMPLATE" \
    --name "$EXPT_NAME" \
    --output-dir "$OUT_DIR" \
    --machine derecho \
    "${OVERRIDES[@]}"

CONFIG="$OUT_DIR/config.yaml"

# --- 2. verify staged data present (fail fast, reading the RESOLVED config) ---
YEAR_RESOLVED="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['forcing']['year_start'])")"
SURFDATA="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['surfdata']['path'])")"
SOURCE="$(python -c "import yaml; print(yaml.safe_load(open('$CONFIG'))['forcing'].get('source','cru_jra'))")"
if [[ "$SOURCE" == "cru_jra" ]]; then
    CRUJRA_SOLR="data/crujra/clmforc.CRUJRAv2.5_filled_antarct_and_grnlnd_0.5x0.5.Solr.${YEAR_RESOLVED}.nc"
    for f in "$CRUJRA_SOLR" "$SURFDATA"; do
        if [[ ! -e "$f" ]]; then
            echo "ERROR: expected staged input not found: $f" >&2
            echo "  Stage inputs first from a login node:" >&2
            echo "    ./scripts/data/download_lmip_data.sh --year $YEAR_RESOLVED" >&2
            exit 2
        fi
    done
fi

# --- 3. run ---
RUN_ARGS=(--config "$CONFIG" --output-dir "$OUT_DIR")
if [[ -n "$RESTART_FROM" ]]; then RUN_ARGS+=(--restart-from "$RESTART_FROM"); fi
python scripts/run/run_lmip_biophys.py "${RUN_ARGS[@]}"

echo "=================================================================="
echo "experiment dir: $OUT_DIR"
ls -lh "$OUT_DIR" 2>/dev/null || true
