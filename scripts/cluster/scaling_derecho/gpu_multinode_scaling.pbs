#!/bin/bash -l
#PBS -N legoesm_gpu_multinode
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=2:ncpus=64:mpiprocs=4:ngpus=4:gpu_type=a100:mem=400GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# MULTI-NODE GPU scaling on Derecho (2x deg nodes, 4x A100 each, Slingshot-11).
#
# The two cross-node GPU transports, each as its own lane:
#
#   Lane A (NCCL, jax.distributed multi-controller) — cubed-sphere cs-spmd,
#     6 processes x 1 GPU over 2 nodes (3 GPUs used/node): the true
#     face-decomposed dycore over XLA collectives. NCCL on Slingshot-11 has
#     NO native CXI support: without the aws-ofi-nccl plugin it silently
#     falls back to TCP sockets over hsn (works, 2-3x slower comm — fine
#     for a first correctness+scaling shakeout, NOT for production numbers).
#     Point LEGOESM_NCCL_OFI_LIB at an aws-ofi-nccl install to use the
#     fast path (build recipe: github.com/benkirk/derecho-pytorch-mpi
#     utils/build_nccl-ofi-plugin.sh; prebuilt conda envs under
#     /glade/work/benkirk/conda-envs may already carry it).
#     Verify on first run: NCCL_DEBUG=INFO must print
#     "Using network AWS Libfabric" (plugin) vs "Using network Socket".
#
#   Lane B (route-A CUDA-aware cray-mpich + mpi4jax) — latlon/icosahedral
#     moist, 8 processes x 1 GPU over 2 nodes: the gpu_moist_scaling.pbs
#     path extended CROSS-NODE (GPU-direct sendrecv over Slingshot via
#     MPICH_GPU_SUPPORT_ENABLED=1). Needs the route-A overlay env
#     (README Step 1b). This is the previously-unvalidated cross-node leg —
#     treat first results as a validation shakeout.
#
# Requires TWO different possible envs:
#   Lane A: plain `legoesm-gpu` (README Step 1) is enough.
#   Lane B: `legoesm-gpu` WITH the route-A overlay (README Step 1b).
# The job runs lane A by default; enable lanes via qsub -v:
#   RUN_NCCL=1 (default 1)   RUN_ROUTEA=1 (default 0 — needs overlay)
#
# SUBMIT:
#   qsub scripts/cluster/scaling_derecho/gpu_multinode_scaling.pbs
#   qsub -v RUN_ROUTEA=1,LEGOESM_NCCL_OFI_LIB=/path/to/nccl-ofi/lib \
#        scripts/cluster/scaling_derecho/gpu_multinode_scaling.pbs
# ===========================================================================
set -uo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if   [ -f "${SUBMIT_DIR}/scripts/cluster/scaling_derecho/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}/scripts/cluster/scaling_derecho"
elif [ -f "${SUBMIT_DIR}/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}"
else
    echo "ERROR: cannot find _env.sh from PBS_O_WORKDIR=${SUBMIT_DIR}" >&2
    exit 1
fi

export JAX_PLATFORMS=cuda
export LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-gpu}"
# shellcheck source=_env.sh
source "${SCRIPT_DIR}/_env.sh"
cd "$REPO"

RUN_NCCL="${RUN_NCCL:-1}"           # lane A: cube cs-spmd
RUN_LATLON="${RUN_LATLON:-1}"       # lane C: atm latlon lat-band multihost
RUN_OCEAN="${RUN_OCEAN:-1}"         # lane D: ocean lat-band multihost
RUN_ROUTEA="${RUN_ROUTEA:-0}"       # lane B: CUDA-aware mpi4jax (overlay env)
PRECISION="${PRECISION:-float32}"
MODE="${MODE:-strong}"
CS_RES="${CS_RES:-96}"              # cube face edge for lane A (C96 strong)
LL_RES="${LL_RES:-512}"             # atm latlon n_lat for lane C (LL512 strong)
OC_RES="${OC_RES:-288}"             # ocean n_lat for lane D (LL288 strong)
NLEV="${NLEV:-26}"
OC_NLEV="${OC_NLEV:-20}"
N_WARMUP="${N_WARMUP:-3}"
N_TIMING="${N_TIMING:-30}"

# Shared NCCL-over-Slingshot env for every jax.distributed lane (A/C/D):
# NCCL owns the GPU traffic — keep GPU-aware cray-mpich OFF (mixing
# GPU-aware MPICH and NCCL in one app risks deadlock — CSCS/ALCF guidance);
# mpi4py in these lanes is bootstrap-only (rank discovery for the PALS
# fallback in init_jax_distributed_with_fallback).
nccl_env() {
    export MPICH_GPU_SUPPORT_ENABLED=0
    export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-hsn}"
    export NCCL_CROSS_NIC="${NCCL_CROSS_NIC:-1}"
    # send/recv (= ppermute halo) throughput knob on multi-NIC nodes.
    export NCCL_NCHANNELS_PER_NET_PEER="${NCCL_NCHANNELS_PER_NET_PEER:-4}"
    export NCCL_DEBUG="${NCCL_DEBUG:-INFO}"   # first run: check the net line
    if [ -n "${LEGOESM_NCCL_OFI_LIB:-}" ]; then
        export LD_LIBRARY_PATH="${LEGOESM_NCCL_OFI_LIB}:${LD_LIBRARY_PATH:-}"
        export NCCL_NET="AWS Libfabric"
        echo "NCCL transport: aws-ofi-nccl from $LEGOESM_NCCL_OFI_LIB"
    else
        # No plugin: TCP-sockets-over-hsn fallback. Loud, not silent.
        export NCCL_IB_DISABLE=1
        export NCCL_SHM_DISABLE="${NCCL_SHM_DISABLE:-1}"  # socket-path hang workaround
        echo "WARNING: LEGOESM_NCCL_OFI_LIB unset -> NCCL on TCP sockets"
        echo "         over hsn (2-3x slower comm). Build it with"
        echo "         scripts/cluster/scaling_derecho/build_nccl_ofi.sh."
    fi
}

STAMP=$(date +%Y%m%d_%H%M%S)
OUTDIR="${OUTDIR:-$SCRATCH/legoesm_scaling/gpu_multinode_${STAMP}}"
mkdir -p "$OUTDIR"

echo "=== HOSTS ==="; cat "$PBS_NODEFILE" | sort -u; date
echo "=== CONFIG ==="
echo "lanes: nccl=$RUN_NCCL routeA=$RUN_ROUTEA | mode=$MODE prec=$PRECISION cs_res=$CS_RES"
echo "outdir=$OUTDIR"

# Per-rank GPU pin from the PALS local rank id (Derecho's mpiexec exports
# PALS_*, not the OpenMPI/SLURM vars the python auto-pin looks for). One
# process must see exactly ONE GPU in BOTH lanes: lane A so that
# jax.process_count()==6 federates 6 single-GPU controllers (not 6x4=24
# devices), lane B so the mpi4jax halo runs 1 GPU/rank.
PIN='export CUDA_VISIBLE_DEVICES=${PALS_LOCAL_RANKID:-${OMPI_COMM_WORLD_LOCAL_RANK:-0}}; exec "$@"'

rc_all=0

# --------------------------------------------------------------------------
# Lane A: cubed-sphere cs-spmd over NCCL (6 procs = 2 nodes x 3 GPUs)
# --------------------------------------------------------------------------
if [ "$RUN_NCCL" = "1" ]; then
    echo "=== LANE A: cube cs-spmd, jax.distributed + NCCL, np=6 over 2 nodes ==="
    (
        nccl_env
        mpiexec -n 6 --ppn 3 bash -c "$PIN" _ \
            "$PY" scripts/bench/run_cpu_mpi_scaling.py \
            --grid cubed-sphere --cs-spmd --device gpu \
            --physics moist \
            --mode "$MODE" --resolution "$CS_RES" \
            --precision "$PRECISION" --n-levels "$NLEV" \
            --n-warmup "$N_WARMUP" --n-timing "$N_TIMING" \
            --output-dir "$OUTDIR/nccl_cs_spmd" < /dev/null
    )
    rc=$?
    [ "$rc" -ne 0 ] && { echo "LANE A FAILED rc=$rc"; rc_all=$rc; }
fi

# --------------------------------------------------------------------------
# Lane C: ATM lat-lon lat-band multihost (8 procs = 2 nodes x 4 GPUs, NCCL)
# — native ppermute band halos (route-B) replace the route-A mpi4jax leg
# that the 2026-07-02 Derecho runs showed is the >=2-node ceiling.
# Gate: tests/parallel/test_atm_latlon_spmd_multicontroller_selfspawn.py.
# --------------------------------------------------------------------------
if [ "$RUN_LATLON" = "1" ]; then
    echo "=== LANE C: atm latlon multihost, np=8 over 2 nodes (LL$LL_RES) ==="
    (
        nccl_env
        mpiexec -n 8 --ppn 4 bash -c "$PIN" _ \
            "$PY" scripts/bench/bench_atm_latlon_spmd_scaling.py \
            --multicontroller --n-devices 8 \
            --mode "$MODE" --n-lat "$LL_RES" --n-lon $((2 * LL_RES)) \
            --nlev "$NLEV" \
            --steps $((N_WARMUP + N_TIMING)) --warmup "$N_WARMUP" \
            --out "$OUTDIR/latlon_multihost/spmd_scaling.jsonl" < /dev/null
    )
    rc=$?
    [ "$rc" -ne 0 ] && { echo "LANE C FAILED rc=$rc"; rc_all=$rc; }
fi

# --------------------------------------------------------------------------
# Lane D: OCEAN lat-band multihost (8 procs = 2 nodes x 4 GPUs, NCCL) via
# the bench's --transport spmd --multihost lane (parity/conservation gates
# available; smoke first, then timed case).
# Gate: tests/parallel/test_latlon_ocean_spmd_multicontroller_selfspawn.py.
# --------------------------------------------------------------------------
if [ "$RUN_OCEAN" = "1" ]; then
    echo "=== LANE D: ocean latlon multihost, np=8 over 2 nodes (LL$OC_RES) ==="
    (
        nccl_env
        mpiexec -n 8 --ppn 4 bash -c "$PIN" _ \
            "$PY" scripts/bench/bench_ocean_latlon_spmd_scaling.py \
            --multicontroller --n-devices 8 \
            --mode "$MODE" --n-lat "$OC_RES" --n-lon $((2 * OC_RES)) \
            --nlev "$OC_NLEV" \
            --steps $((N_WARMUP + N_TIMING)) --warmup "$N_WARMUP" \
            --out "$OUTDIR/ocean_multicontroller/ocean_spmd_scaling.jsonl" < /dev/null
    )
    rc=$?
    [ "$rc" -ne 0 ] && { echo "LANE D FAILED rc=$rc"; rc_all=$rc; }
fi

# --------------------------------------------------------------------------
# Lane B: route-A CUDA-aware mpi4jax cross-node (8 procs = 2 nodes x 4 GPUs)
# --------------------------------------------------------------------------
if [ "$RUN_ROUTEA" = "1" ]; then
    echo "=== LANE B: route-A mpi4jax GPU-direct cross-node (2 nodes x 4 GPUs) ==="
    # Same sweep -> case machinery as gpu_moist_scaling.pbs (resolution
    # semantics are grid-specific; the sweep encodes them), rank ladder up
    # to the 8 GPUs of this 2-node allocation.
    module load craype-accel-nvidia80 2>/dev/null || true
    export MPICH_GPU_SUPPORT_ENABLED=1
    export MPICH_OFI_NIC_POLICY="${MPICH_OFI_NIC_POLICY:-GPU}"
    export MPI4JAX_USE_CUDA_MPI=1
    export LD_LIBRARY_PATH="${CRAY_LD_LIBRARY_PATH:-}:${LD_LIBRARY_PATH:-}"
    for grid in latlon icosahedral; do
        CASE_FILE="$OUTDIR/routeA_${grid}_cases.jsonl"
        "$PY" scripts/bench/run_cpu_mpi_scaling.py --sweep \
            --grid "$grid" --mode "$MODE" --physics moist \
            --precision "$PRECISION" --n-levels "$NLEV" \
            --max-ranks 8 > "$CASE_FILE"
        while IFS= read -r -u 9 CASE; do
            [ -z "$CASE" ] && continue
            N_RANKS=$("$PY" -c 'import sys,json; print(json.loads(sys.argv[1])["n_ranks"])' "$CASE")
            echo "--- route-A $grid n_ranks=$N_RANKS (1 GPU/rank, --ppn 4) ---"
            mpiexec -n "$N_RANKS" --ppn 4 bash -c "$PIN" _ \
                "$PY" scripts/bench/run_cpu_mpi_scaling.py \
                --case "$CASE" --device gpu \
                --n-warmup "$N_WARMUP" --n-timing "$N_TIMING" \
                --output-dir "$OUTDIR/routeA_${grid}" < /dev/null
            rc=$?
            [ "$rc" -ne 0 ] && { echo "route-A $grid case FAILED rc=$rc"; rc_all=$rc; }
        done 9< "$CASE_FILE"
    done
fi

echo "=== RESULTS ==="
find "$OUTDIR" -name "*.csv" -o -name "*.json" | head -40
echo "=== DONE rc=$rc_all ==="
exit "$rc_all"
