#!/bin/bash -l
#PBS -N legoesm_routeb_sweep
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=4:ncpus=64:mpiprocs=4:ngpus=4:gpu_type=a100:mem=400GB
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# Route-B (NCCL multi-controller) GPU-COUNT SWEEP -- the scaling-curve twin of
# scaling_gpu.sh's route-A (mpi4jax) sweep.  gpu_multinode_scaling.pbs runs
# route B at a SINGLE fixed process count (np=6/8); this sweeps
# N = 1 2 4 8 16 GPUs (one process per GPU, --ppn 4) so route A and route B
# yield COMPARABLE SYPD/throughput-vs-GPU curves at the SAME grid + resolution.
#
# Transport: jax.distributed multi-controller over NCCL (native ppermute/psum
# band halos), no mpi4jax.  Needs the aws-ofi-nccl plugin for the fabric path
# (build_nccl_ofi.sh -> LEGOESM_NCCL_OFI_LIB); without it NCCL loudly falls back
# to TCP sockets.  Env: plain legoesm-gpu (mpi4py bootstrap only); NOT the
# route-A overlay.  Coordinator port auto-resolves (#751), so no EADDRINUSE.
#
# Pair with the route-A sweep at the SAME resolution for a head-to-head, e.g.:
#   NODES=4 PHYSICS=moist scripts/cluster/scaling_derecho/submit_scaling.sh \
#       $SCRATCH/legoesm_scaling/routeA latlon 512      # route A (mpi4jax)
#   qsub -v LEGOESM_NCCL_OFI_LIB=/glade/work/$USER/nccl-ofi/<tag>/lib \
#       scripts/cluster/scaling_derecho/routeb_sweep.pbs # route B (NCCL), LL512
#
# Knobs (qsub -v): LEGOESM_NCCL_OFI_LIB (fabric path), LL_RES/NLEV (atm size,
# match route A), RUN_OCEAN=1 (add the ocean lane), GPU_RANKS="1 2 4 8 16",
# MODE=strong|weak, PRECISION.  Fewer nodes -> the ladder self-caps.
# ===========================================================================
set -uo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if   [ -f "${SUBMIT_DIR}/scripts/cluster/scaling_derecho/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}/scripts/cluster/scaling_derecho"
elif [ -f "${SUBMIT_DIR}/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}"
else
    echo "ERROR: cannot find _env.sh from PBS_O_WORKDIR=${SUBMIT_DIR}" >&2
    exit 1
fi
export JAX_PLATFORMS=cuda
export LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-gpu}"
# shellcheck source=_env.sh
source "${SCRIPT_DIR}/_env.sh"          # provides nccl_env(), PY, REPO, SCRATCH
cd "$REPO"

MODE="${MODE:-strong}"
PRECISION="${PRECISION:-float32}"
LL_RES="${LL_RES:-512}"                 # atm n_lat (match route A's resolution)
NLEV="${NLEV:-26}"
OC_RES="${OC_RES:-288}"                 # ocean n_lat
OC_NLEV="${OC_NLEV:-20}"
N_WARMUP="${N_WARMUP:-3}"
N_TIMING="${N_TIMING:-30}"
RUN_ATM="${RUN_ATM:-1}"
RUN_OCEAN="${RUN_OCEAN:-0}"

# GPU cap = unique nodes x GPUs/node.  PBS_NODEFILE is one line PER RANK
# (mpiprocs=4), so count UNIQUE hosts (see scaling_gpu.sh: a bare $NGPUS is the
# per-chunk value=4 and would pin the cap at 4).  LEGOESM_NGPUS overrides.
_gpus_per_node="$(nvidia-smi -L 2>/dev/null | grep -c '^GPU' || echo 0)"
[ "${_gpus_per_node:-0}" -ge 1 ] 2>/dev/null || _gpus_per_node=4
_n_nodes=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "${PBS_NODEFILE}" ]; then
    _n_nodes="$(sort -u "$PBS_NODEFILE" 2>/dev/null | grep -c .)"
fi
[ "${_n_nodes:-0}" -ge 1 ] 2>/dev/null || _n_nodes=1
TOTAL_GPUS="${LEGOESM_NGPUS:-$(( _n_nodes * _gpus_per_node ))}"
[ "${TOTAL_GPUS:-0}" -ge 1 ] 2>/dev/null || TOTAL_GPUS=4
GPU_RANKS="${GPU_RANKS:-1 2 4 8 16}"

STAMP="$(date +%Y%m%d_%H%M%S)"
OUTDIR="${OUTDIR:-$SCRATCH/legoesm_scaling/routeb_sweep_${STAMP}}"
mkdir -p "$OUTDIR"
[ -n "${PBS_O_WORKDIR:-}" ] && exec > >(tee -a "$OUTDIR/run.log") 2>&1

echo "=== route-B (NCCL) sweep: mode=$MODE prec=$PRECISION gpus=[$GPU_RANKS] (cap=$TOTAL_GPUS) ==="
echo "    atm LL$LL_RES/L$NLEV  ocean LL$OC_RES/L$OC_NLEV (run_ocean=$RUN_OCEAN)  nodes=$_n_nodes  outdir=$OUTDIR"

# rank -> local GPU pin (Cray PALS exports PALS_LOCAL_RANKID; the python auto-pin
# does not read PALS, so without this every rank grabs GPU 0).
PIN='export CUDA_VISIBLE_DEVICES=${PALS_LOCAL_RANKID:-${OMPI_COMM_WORLD_LOCAL_RANK:-0}}; exec "$@"'

# Distinct jax.distributed coordinator port per launch: many sequential inits on
# ONE port hit a TIME_WAIT re-bind flake (why gpu_multinode uses a port/stage).
# early_init.resolve_coordinator_port() reads LEGOESM_COORDINATOR_PORT first.
_port="${COORD_PORT_BASE:-29800}"

rc_all=0
for N in $GPU_RANKS; do
    if [ "$N" -gt "$TOTAL_GPUS" ]; then
        echo "--- SKIP N=$N > cap=$TOTAL_GPUS (needs a larger allocation) ---"
        continue
    fi
    PPN=$(( N < _gpus_per_node ? N : _gpus_per_node ))
    if [ "$RUN_ATM" = "1" ]; then
        export LEGOESM_COORDINATOR_PORT="$_port"; _port=$(( _port + 1 ))
        echo "=== route-B atm latlon N=$N GPU (ppn=$PPN, LL$LL_RES/L$NLEV, coord_port=$LEGOESM_COORDINATOR_PORT) ==="
        (
            nccl_env
            mpiexec -n "$N" --ppn "$PPN" bash -c "$PIN" _ \
                "$PY" scripts/bench/bench_atm_latlon_spmd_scaling.py \
                --multicontroller --n-devices "$N" \
                --mode "$MODE" --n-lat "$LL_RES" --n-lon $((2 * LL_RES)) \
                --nlev "$NLEV" \
                --steps $((N_WARMUP + N_TIMING)) --warmup "$N_WARMUP" \
                --out "$OUTDIR/atm_latlon/spmd_N${N}.jsonl" < /dev/null
        ) || { echo "route-B atm N=$N FAILED rc=$?"; rc_all=1; }
    fi
    if [ "$RUN_OCEAN" = "1" ]; then
        export LEGOESM_COORDINATOR_PORT="$_port"; _port=$(( _port + 1 ))
        echo "=== route-B ocean latlon N=$N GPU (ppn=$PPN, LL$OC_RES/L$OC_NLEV, coord_port=$LEGOESM_COORDINATOR_PORT) ==="
        (
            nccl_env
            mpiexec -n "$N" --ppn "$PPN" bash -c "$PIN" _ \
                "$PY" scripts/bench/bench_ocean_latlon_spmd_scaling.py \
                --multicontroller --n-devices "$N" \
                --mode "$MODE" --n-lat "$OC_RES" --n-lon $((2 * OC_RES)) \
                --nlev "$OC_NLEV" \
                --steps $((N_WARMUP + N_TIMING)) --warmup "$N_WARMUP" \
                --out "$OUTDIR/ocean_latlon/spmd_N${N}.jsonl" < /dev/null
        ) || { echo "route-B ocean N=$N FAILED rc=$?"; rc_all=1; }
    fi
done

echo "=== DONE rc=$rc_all ===   route-B curve JSONL under: $OUTDIR"
echo "    atm:   $OUTDIR/atm_latlon/spmd_N*.jsonl"
[ "$RUN_OCEAN" = "1" ] && echo "    ocean: $OUTDIR/ocean_latlon/spmd_N*.jsonl"
exit "$rc_all"
