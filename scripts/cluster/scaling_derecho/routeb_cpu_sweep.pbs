#!/bin/bash -l
#PBS -N legoesm_routeb_cpu
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=16:ncpus=128:mpiprocs=1:mem=230GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# Route-B (SPMD multi-controller) CPU THROUGHPUT sweep -- latlon only.
#   NODE ladder N = 1 2 4 8 16 NODES (ONE process per FULL node = one CPU
#   device using all 128 cores as threads; --ppn 1) x RES_LIST resolutions.
# The CPU half of the fair CPU-node-vs-A100 throughput comparison; the SAME
# SPMD lat-band code path as routeb_gpu_sweep.pbs, so CPU-vs-GPU is a like-for-
# like transport comparison, differing only in the device (node vs A100).
#
# CPU multi-controller collectives run over the jax.distributed runtime (gloo /
# TCP over hsn) -- NO NCCL, NO GPU-aware MPICH; mpi4py is bootstrap-only.  ONE
# process per node with the full core count as the XLA intra-op thread pool is
# the CPU analogue of one A100 per process (route B on GPU).
#
# THROUGHPUT-only (Mcells/s; no dt).  JSONL records (platform=cpu) flow through
# the SAME finalize_scaling.sh; aggregate expresses CPU points in CORES
# (n_devices * 128) so the "CPU nodes" plot axis reads node counts.
#
# SUBMIT (env = legoesm-mpi, the CPU+MPI JAX build):
#   qsub scripts/cluster/scaling_derecho/routeb_cpu_sweep.pbs
#   # knobs: -v RES_LIST="128 256 512",NLEV=26,NODE_RANKS="1 2 4 8 16",OUTDIR=...
# ===========================================================================
set -uo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if   [ -f "${SUBMIT_DIR}/scripts/cluster/scaling_derecho/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}/scripts/cluster/scaling_derecho"
elif [ -f "${SUBMIT_DIR}/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}"
else
    echo "ERROR: cannot find _env.sh from PBS_O_WORKDIR=${SUBMIT_DIR}" >&2
    exit 1
fi
export JAX_PLATFORMS=cpu
export LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-mpi}"
# shellcheck source=_env.sh
source "${SCRIPT_DIR}/_env.sh"          # PY, REPO, SCRATCH (+ CXI tuning, harmless)
cd "$REPO"
module load gcc cray-mpich 2>/dev/null || true   # match the mpi4py bootstrap ABI

MODE="${MODE:-strong}"
RES_LIST="${RES_LIST:-128 256 512}"     # latlon n_lat resolutions (the 3 sizes)
RES_LIST="${RES_LIST//,/ }"             # accept comma-separated (survives qsub -v)
NLEV="${NLEV:-26}"
N_WARMUP="${N_WARMUP:-3}"
N_TIMING="${N_TIMING:-30}"
NODE_RANKS="${NODE_RANKS:-1 2 4 8 16}"   # = NODES = processes (1 proc/node)
NODE_RANKS="${NODE_RANKS//,/ }"
_CORES_PER_NODE="${LEGOESM_CORES_PER_NODE:-128}"

# One process per node uses the WHOLE node: size the CPU thread pools to the
# node's cores (XLA CPU intra-op auto-sizes too; set the BLAS/OMP envs to match).
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$_CORES_PER_NODE}"
export MKL_NUM_THREADS="$OMP_NUM_THREADS"
export OPENBLAS_NUM_THREADS="$OMP_NUM_THREADS"
export NUMEXPR_NUM_THREADS="$OMP_NUM_THREADS"
# Cross-node CPU collectives (gloo) go over TCP -- pin to the Slingshot NICs
# instead of the slow management network.
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-hsn0}"

# Node cap: with mpiprocs=1, PBS_NODEFILE has one line per NODE.
_n_nodes=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "${PBS_NODEFILE}" ]; then
    _n_nodes="$(sort -u "$PBS_NODEFILE" 2>/dev/null | grep -c .)"
fi
[ "${_n_nodes:-0}" -ge 1 ] 2>/dev/null || _n_nodes=1
NODE_CAP="${LEGOESM_NNODES:-$_n_nodes}"

STAMP="$(date +%Y%m%d_%H%M%S)"
OUTDIR="${OUTDIR:-$SCRATCH/legoesm_scaling/routeb_cpu_${STAMP}}"
mkdir -p "$OUTDIR"
[ -n "${PBS_O_WORKDIR:-}" ] && exec > >(tee -a "$OUTDIR/run.log") 2>&1

echo "=== route-B CPU sweep (latlon): mode=$MODE res=[$RES_LIST] nodes=[$NODE_RANKS] (cap=$NODE_CAP) nlev=$NLEV threads=$OMP_NUM_THREADS ==="
echo "    outdir=$OUTDIR"

# Distinct coordinator port per launch (sequential inits on one port hit a
# TIME_WAIT re-bind flake).  early_init.resolve_coordinator_port reads this.
_port="${COORD_PORT_BASE:-29900}"

rc_all=0
for RES in $RES_LIST; do
  for N in $NODE_RANKS; do
    if [ "$N" -gt "$NODE_CAP" ]; then
        echo "--- SKIP res=$RES N=$N nodes > cap=$NODE_CAP ---"
        continue
    fi
    export LEGOESM_COORDINATOR_PORT="$_port"; _port=$(( _port + 1 ))
    echo "=== route-B CPU latlon res=$RES N=$N nodes (1 proc/node, coord_port=$LEGOESM_COORDINATOR_PORT) ==="
    mpiexec -n "$N" --ppn 1 \
        "$PY" scripts/bench/bench_atm_latlon_spmd_scaling.py \
        --multicontroller --n-devices "$N" \
        --mode "$MODE" --n-lat "$RES" --n-lon $((2 * RES)) --nlev "$NLEV" \
        --steps $((N_WARMUP + N_TIMING)) --warmup "$N_WARMUP" \
        --out "$OUTDIR/atm_latlon_cpu/spmd_R${RES}_N${N}.jsonl" < /dev/null \
      || { echo "route-B CPU res=$RES N=$N FAILED rc=$?"; rc_all=1; }
  done
done

echo "=== DONE rc=$rc_all ===   route-B CPU curve JSONL under: $OUTDIR/atm_latlon_cpu/"
echo "    aggregate + plot:  scripts/cluster/scaling_derecho/finalize_scaling.sh $OUTDIR"
exit "$rc_all"
