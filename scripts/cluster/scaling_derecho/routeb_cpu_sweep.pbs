#!/bin/bash -l
#PBS -N legoesm_routeb_cpu
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=16:ncpus=128:mpiprocs=128:mem=230GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# Route-B (SPMD multi-controller) CPU THROUGHPUT sweep -- FULL-NODE PACKING.
#
# Each node is FULLY used: 128 SPMD processes per node (one CPU "device" per
# core, OMP=1), so all 128 cores do real work -- the apples-to-apples CPU
# analogue of route-A's 128-MPI-ranks/node, directly comparable to N A100s.
# NODE ladder 1,2,4,8,16 -> DEVICE counts 128,256,512,1024,2048; the plot
# x-axis is NODES (= n_devices / 128).
#
#   GRID=latlon       lat-band SPMD (bench_atm_latlon_spmd) -- 1-D decomposition,
#                     so n_devices <= n_lat: at 128 devices/node, res=128 caps at
#                     1 node, res=512 at 4, res=2048 at 16.  (Route-A latlon uses
#                     2-D pencils and scales further at low res -- a real A-vs-B
#                     difference; rungs past n_lat are SKIPPED with a note.)
#   GRID=icosahedral  MPAS cell partition (bench_mpas_spmd) -- RCB, any count;
#                     --reorder-for pins ONE padded mesh across the whole ladder.
#   GRID=cubed-sphere face-partition cs-spmd -- CANNOT full-node-pack: the face
#                     decomposition only admits 1,2,3,6 (or 6*kt^2) devices, so
#                     cube stays 1 proc/node (OMP=128) over the face-divisor
#                     ladder.  A <=6-device benchmark, NOT a full-node scaling
#                     curve -- a structural cube limit, documented, not a bug.
#
# CPU collectives run over jax.distributed gloo (TCP over hsn); NO NCCL.  mpi4py
# is bootstrap-only.  Records (platform=cpu) flow through finalize_scaling.sh; the
# aggregator places CPU points on the cores axis (n_devices) -> NODES on the plot.
# spectral rejected (no route-B path).
#
# SUBMIT (env = legoesm-mpi, the CPU+MPI JAX build):
#   qsub -v LEGOESM_REPO=<checkout>,OUTDIR=... routeb_cpu_sweep.pbs
#   # knobs: -v GRID=latlon,RES_LIST="512 1024 2048",NLEV=26,NODE_RANKS="1 2 4 8 16"
# ===========================================================================
set -uo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if   [ -f "${SUBMIT_DIR}/scripts/cluster/scaling_derecho/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}/scripts/cluster/scaling_derecho"
elif [ -f "${SUBMIT_DIR}/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}"
else
    echo "ERROR: cannot find _env.sh from PBS_O_WORKDIR=${SUBMIT_DIR}" >&2
    exit 1
fi
export JAX_PLATFORMS=cpu
export LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-mpi}"
# Worktree-safe: pin REPO to the checkout this job was SUBMITTED from (else
# _env.sh's default /glade/work/$USER/legoESM runs the wrong checkout's code).
: "${LEGOESM_REPO:=$(cd "${SCRIPT_DIR}/../../.." && pwd)}"
export LEGOESM_REPO
# shellcheck source=_env.sh
source "${SCRIPT_DIR}/_env.sh"          # PY, REPO, SCRATCH (+ CXI tuning)
cd "$REPO"
module load gcc cray-mpich 2>/dev/null || true   # match the mpi4py bootstrap ABI

MODE="${MODE:-strong}"
_CORES_PER_NODE="${LEGOESM_CORES_PER_NODE:-128}"
# GRID selects the SPMD lane + its full-node packing:
#   _ppn = SPMD procs PER NODE ; _omp = XLA/BLAS threads per proc.
# latlon/ico pack 128 procs/node (1 core each, OMP=1).  cube is face-capped at
# <=6 devices so it CANNOT pack -> 1 proc/node with the full 128-thread pool.
GRID="${GRID:-latlon}"
case "$GRID" in
  latlon)
    RES_LIST="${RES_LIST:-512 1024 2048}"; NLEV="${NLEV:-26}"
    NODE_RANKS="${NODE_RANKS:-1 2 4 8 16}"; _sub="atm_latlon_cpu"
    _ppn="$_CORES_PER_NODE"; _omp=1 ;;
  icosahedral)
    RES_LIST="${RES_LIST:-6 7 8}";          NLEV="${NLEV:-8}"
    NODE_RANKS="${NODE_RANKS:-1 2 4 8 16}"; _sub="mpas_atm_cpu"
    _ppn="$_CORES_PER_NODE"; _omp=1 ;;
  cubed-sphere|cubed_sphere)
    RES_LIST="${RES_LIST:-48 96 192}";      NLEV="${NLEV:-26}"
    NODE_RANKS="${NODE_RANKS:-1 2 3 6}";     _sub="cs_spmd_cpu"
    _ppn=1; _omp="$_CORES_PER_NODE" ;;      # face-capped: 1 proc/node, device==node
  *) echo "ERROR: routeb_cpu_sweep GRID='$GRID' unsupported (latlon|icosahedral|cubed-sphere; spectral=no route-B)." >&2; exit 2 ;;
esac
RES_LIST="${RES_LIST//[:,]/ }"
NODE_RANKS="${NODE_RANKS//[:,]/ }"       # = NODE counts (device count = _ppn * N)
N_WARMUP="${N_WARMUP:-3}"
N_TIMING="${N_TIMING:-30}"
PHYSICS="${PHYSICS:-none}"              # cube --cs-spmd only (none|moist)
PRECISION="${PRECISION:-float32}"       # cube --cs-spmd only

# Thread pool per SPMD process (1 core each when 128 procs pack a node).
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$_omp}"
export MKL_NUM_THREADS="$OMP_NUM_THREADS"
export OPENBLAS_NUM_THREADS="$OMP_NUM_THREADS"
export NUMEXPR_NUM_THREADS="$OMP_NUM_THREADS"
# Cross-node gloo collectives go over TCP -- pin to the Slingshot NICs.
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-hsn0}"

# Node cap: PBS_NODEFILE has one line per PROCESS SLOT, so nodes = unique hosts.
_n_nodes=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "${PBS_NODEFILE}" ]; then
    _n_nodes="$(sort -u "$PBS_NODEFILE" 2>/dev/null | grep -c .)"
fi
[ "${_n_nodes:-0}" -ge 1 ] 2>/dev/null || _n_nodes=1
NODE_CAP="${LEGOESM_NNODES:-$_n_nodes}"

# Icosahedral strong scaling: pin every DEVICE count (=_ppn*N) to ONE padded mesh
# (LCM) so all points are the same global problem size (fair strong scaling).
_reorder_for=1
if [ "$GRID" = icosahedral ]; then
    _gcd() { local a="$1" b="$2" t; while [ "$b" -ne 0 ]; do t="$b"; b=$(( a % b )); a="$t"; done; echo "$a"; }
    for N in $NODE_RANKS; do
        [ "$N" -gt "$NODE_CAP" ] 2>/dev/null && continue
        _nd=$(( _ppn * N ))
        g="$(_gcd "$_reorder_for" "$_nd")"; _reorder_for=$(( _reorder_for * _nd / g ))
    done
    echo "    icosahedral reorder_for (LCM of device counts) = $_reorder_for"
fi

STAMP="$(date +%Y%m%d_%H%M%S)"
OUTDIR="${OUTDIR:-$SCRATCH/legoesm_scaling/routeb_cpu_${STAMP}}"
mkdir -p "$OUTDIR"
[ -n "${PBS_O_WORKDIR:-}" ] && exec > >(tee -a "$OUTDIR/run.log") 2>&1

echo "=== route-B CPU sweep ($GRID): mode=$MODE res=[$RES_LIST] nodes=[$NODE_RANKS] (cap=$NODE_CAP) nlev=$NLEV procs/node=$_ppn threads/proc=$OMP_NUM_THREADS ==="
echo "    outdir=$OUTDIR"

_port="${COORD_PORT_BASE:-29900}"
# Coordinator host = first node (rank 0).  Per-rank SHIM bridges PALS_RANKID ->
# OMPI_COMM_WORLD_RANK (jax.distributed reads OMPI/PMI; PALS exposes only PALS_*);
# SIZE is exported per rung.  Bridge + explicit --coordinator = the proven
# mc_nccl-canary federation recipe (else mpi4py auto-detect -> process_count=1).
COORD_HOST="$(head -n 1 "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || true)"
[ -n "$COORD_HOST" ] || COORD_HOST="$(hostname)"
SHIM='export OMPI_COMM_WORLD_RANK=${PALS_RANKID:-${OMPI_COMM_WORLD_RANK:-0}}; exec "$@"'

rc_all=0
for RES in $RES_LIST; do
  for N in $NODE_RANKS; do
    if [ "$N" -gt "$NODE_CAP" ]; then
        echo "--- SKIP res=$RES nodes=$N > cap=$NODE_CAP ---"
        continue
    fi
    _nd=$(( _ppn * N ))          # SPMD device count = procs/node * node count
    # latlon 1-D lat-band: n_devices must divide n_lat (and be <= it).  Skip the
    # rungs a resolution cannot support instead of letting the bench SystemExit.
    if [ "$GRID" = latlon ] && { [ "$_nd" -gt "$RES" ] || [ $(( RES % _nd )) -ne 0 ]; }; then
        echo "--- SKIP latlon res=$RES nodes=$N -> $_nd devices > n_lat=$RES (1-D lat-band cap) ---"
        continue
    fi
    export LEGOESM_COORDINATOR_PORT="$_port"; _port=$(( _port + 1 ))
    export OMPI_COMM_WORLD_SIZE="$_nd"        # world size for the PALS->OMPI bridge
    _coord="${COORD_HOST}:${LEGOESM_COORDINATOR_PORT}"
    echo "=== route-B CPU $GRID res=$RES nodes=$N -> $_nd devices ($_ppn/node, coord=$_coord) ==="
    case "$GRID" in
      latlon)
        BENCH=( "$PY" scripts/bench/bench_atm_latlon_spmd_scaling.py
                --multicontroller --n-devices "$_nd" --coordinator "$_coord"
                --mode "$MODE" --n-lat "$RES" --n-lon $(( 2 * RES )) --nlev "$NLEV"
                --steps $(( N_WARMUP + N_TIMING )) --warmup "$N_WARMUP"
                --out "$OUTDIR/${_sub}/spmd_R${RES}_N${_nd}.jsonl" ) ;;
      icosahedral)
        BENCH=( "$PY" scripts/bench/bench_mpas_spmd_scaling.py
                --multicontroller --n-devices "$_nd" --reorder-for "$_reorder_for"
                --coordinator "$_coord"
                --subdivision "$RES" --nlev "$NLEV" --partition-method sfc
                --steps $(( N_WARMUP + N_TIMING )) --warmup "$N_WARMUP"
                --out "$OUTDIR/${_sub}/spmd_L${RES}_N${_nd}.jsonl" ) ;;
      cubed-sphere|cubed_sphere)
        BENCH=( "$PY" scripts/bench/run_cpu_mpi_scaling.py
                --grid cubed-sphere --cs-spmd --device cpu --coordinator "$_coord"
                --physics "$PHYSICS" --mode "$MODE" --resolution "$RES"
                --precision "$PRECISION" --n-levels "$NLEV"
                --n-warmup "$N_WARMUP" --n-timing "$N_TIMING"
                --output-dir "$OUTDIR/${_sub}" ) ;;
    esac
    # Binding: PALS core-binds each rank by DEFAULT, which strangled the cube
    # lane's 1-proc-per-node x 128-thread protocol to ~1 core (first campaign
    # run: cube "node" points ~10 Mcells/s = single-CORE throughput,
    # cpus_per_task=1 in the rows, C48 anti-scaling). Threaded ranks
    # (ppn=1, OMP>1) get the node's full affinity via --depth/--cpu-bind depth
    # so the XLA CPU pool can actually thread; packed grids (128 procs/node,
    # 1 thread each) keep the default per-core binding.
    _BIND=()
    if [ "$_ppn" -eq 1 ] && [ "${OMP_NUM_THREADS:-1}" -gt 1 ]; then
        _BIND=(--depth "$OMP_NUM_THREADS" --cpu-bind depth)
    fi
    mpiexec -n "$_nd" --ppn "$_ppn" "${_BIND[@]}" bash -c "$SHIM" _ "${BENCH[@]}" < /dev/null \
      || { echo "route-B CPU $GRID res=$RES nodes=$N ($_nd dev) FAILED rc=$?"; rc_all=1; }
  done
done

echo "=== DONE rc=$rc_all ===   route-B CPU records under: $OUTDIR/${_sub}/"
echo "    aggregate + plot:  scripts/cluster/scaling_derecho/finalize_scaling.sh $OUTDIR"
exit "$rc_all"
