#!/bin/bash -l
#PBS -N legoesm_routeb_gpu
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=4:ncpus=64:mpiprocs=4:ngpus=4:gpu_type=a100:mem=400GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# Route-B (NCCL multi-controller) GPU THROUGHPUT sweep -- all route-B grids.
#   x RES_LIST resolutions, strong scaling.  GRID selects the lane:
#     GRID=latlon       lat-band SPMD (bench_atm_latlon_spmd_scaling)   N=1 2 4 8 16
#     GRID=icosahedral  MPAS cell-partition SPMD (bench_mpas, #757)     N=1 2 4 8 16
#     GRID=cubed-sphere face-partition cs-spmd (run_cpu_mpi_scaling)    N=1 2 3 6 (|6)
# One process per GPU (--ppn = balanced across the fewest nodes).  The GPU half
# of the fair CPU-node-vs-A100 throughput comparison; pair with
# routeb_cpu_sweep.pbs.  spectral has no domain-decomposition path -> rejected.
# The three grids use DIFFERENT device axes (cube = face divisors) so they land
# as SEPARATE curves in aggregate_bcw_scaling.py, never overlaid.
#
# THROUGHPUT-only: the SPMD bench times kernels (no dt), so the metric is
# Mcells/s (SYPD is undefined).  Records are JSONL and flow through the SAME
# finalize_scaling.sh -> aggregate_bcw_scaling.py -> plot pipeline.
#
# Needs aws-ofi-nccl for the fabric (build_nccl_ofi.sh -> LEGOESM_NCCL_OFI_LIB);
# env = plain legoesm-gpu (mpi4py bootstrap only, NOT the route-A overlay).
#
# SUBMIT:
#   qsub -v LEGOESM_NCCL_OFI_LIB=/glade/work/$USER/nccl-ofi/<tag>/lib \
#        scripts/cluster/scaling_derecho/routeb_gpu_sweep.pbs
#   # knobs: -v RES_LIST="128 256 512",NLEV=26,GPU_RANKS="1 2 4 8 16",OUTDIR=...
# ===========================================================================
set -uo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:-$(pwd)}"
if   [ -f "${SUBMIT_DIR}/scripts/cluster/scaling_derecho/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}/scripts/cluster/scaling_derecho"
elif [ -f "${SUBMIT_DIR}/_env.sh" ]; then
    SCRIPT_DIR="${SUBMIT_DIR}"
else
    echo "ERROR: cannot find _env.sh from PBS_O_WORKDIR=${SUBMIT_DIR}" >&2
    exit 1
fi
export JAX_PLATFORMS=cuda
export LEGOESM_CONDA_ENV="${LEGOESM_CONDA_ENV:-legoesm-gpu}"
# Worktree-safe: pin REPO to the checkout this job was SUBMITTED from.  _env.sh
# defaults LEGOESM_REPO to /glade/work/$USER/legoESM, the WRONG checkout when the
# sweep is submitted from a git worktree -> `$PY scripts/bench/...` (resolved
# relative to $REPO after `cd "$REPO"`) is then not found.  Derive it from this
# script's own location (an explicit -v LEGOESM_REPO still wins).
: "${LEGOESM_REPO:=$(cd "${SCRIPT_DIR}/../../.." && pwd)}"
export LEGOESM_REPO
# shellcheck source=_env.sh
source "${SCRIPT_DIR}/_env.sh"          # provides nccl_env(), PY, REPO, SCRATCH
cd "$REPO"

MODE="${MODE:-strong}"
# GRID selects the SPMD lane.  Unknown grid -> hard error (dispatch hardening),
# never a silent latlon fallback.  Per-grid defaults: RES list, vertical levels,
# device ladder (POWERS OF 2 for the band/cell decomps; FACE-DIVISORS 1,2,3,6
# for the cube face decomposition), and output subdir.
GRID="${GRID:-latlon}"
case "$GRID" in
  latlon)
    RES_LIST="${RES_LIST:-128 256 512}"; NLEV="${NLEV:-26}"
    GPU_RANKS="${GPU_RANKS:-1 2 4 8 16}"; _sub="atm_latlon" ;;
  icosahedral)
    RES_LIST="${RES_LIST:-6 7 8}";        NLEV="${NLEV:-8}"
    GPU_RANKS="${GPU_RANKS:-1 2 4 8 16}"; _sub="mpas_atm" ;;
  cubed-sphere|cubed_sphere)
    # Cube uses run_cpu_mpi_scaling --cs-spmd (flat-JSON, sypd) over the FACE
    # divisor ladder N|6; extend to the sub-face 6*kt^2 counts (24,54) with more
    # GPUs via GPU_RANKS.  Its own device axis, NOT the powers-of-2 one.
    RES_LIST="${RES_LIST:-48 96 192}";    NLEV="${NLEV:-26}"
    GPU_RANKS="${GPU_RANKS:-1 2 3 6}";    _sub="cs_spmd" ;;
  *) echo "ERROR: routeb_gpu_sweep GRID='$GRID' unsupported (latlon|icosahedral|cubed-sphere; spectral=no route-B)." >&2; exit 2 ;;
esac
RES_LIST="${RES_LIST//[:,]/ }"          # accept colon/comma-separated (survives qsub -v)
GPU_RANKS="${GPU_RANKS//[:,]/ }"        # colon/comma-separated ok (survives qsub -v)
N_WARMUP="${N_WARMUP:-3}"
N_TIMING="${N_TIMING:-30}"
PHYSICS="${PHYSICS:-none}"              # cube --cs-spmd only (none|moist); 'none'=dry
# Precision applies to EVERY grid, not just the cube.  The latlon/ico SPMD
# benches take no --precision flag: they read jax.config.jax_enable_x64 and
# RECORD the result ("float64" if enabled else "float32"), so the knob for them
# is the JAX_ENABLE_X64 env var, exported per-precision in the loop below.
# Before this, PRECISION reached the cube branch ONLY and every latlon/ico row
# in the route-B campaign was float32 with no way to ask for f64.
# Default stays float32 = previous behaviour: this sweep is ONE job that loops
# internally, so adding a precision DOUBLES its walltime rather than fanning out
# to a second queue job (unlike route-A submit_scaling.sh, which submits one job
# per precision).  Opt in explicitly and raise the PBS walltime to match:
#   PRECISIONS="float32 float64"
PRECISIONS="${PRECISIONS:-${PRECISION:-float32}}"
PRECISIONS="${PRECISIONS//[:,]/ }"      # colon/comma-separated ok (survives qsub -v)

# GPU cap = unique nodes x GPUs/node (PBS_NODEFILE is one line PER RANK; count
# UNIQUE hosts -- a bare $NGPUS is the per-chunk value=4, see scaling_gpu.sh).
_gpus_per_node="$(nvidia-smi -L 2>/dev/null | grep -c '^GPU' || echo 0)"
[ "${_gpus_per_node:-0}" -ge 1 ] 2>/dev/null || _gpus_per_node=4
_n_nodes=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "${PBS_NODEFILE}" ]; then
    _n_nodes="$(sort -u "$PBS_NODEFILE" 2>/dev/null | grep -c .)"
fi
[ "${_n_nodes:-0}" -ge 1 ] 2>/dev/null || _n_nodes=1
TOTAL_GPUS="${LEGOESM_NGPUS:-$(( _n_nodes * _gpus_per_node ))}"
[ "${TOTAL_GPUS:-0}" -ge 1 ] 2>/dev/null || TOTAL_GPUS=4

# Icosahedral strong scaling: pin EVERY device count to ONE padded mesh so all
# points are the SAME global problem size (a fair strong-scaling curve, not one
# re-partitioned per N).  reorder_for = LCM of the runnable device counts, so it
# is divisible by every N and the bench's `nCells_padded % N == 0` check passes
# for all N against the shared mesh.  latlon needs none (n_lat is chosen
# divisible per rung by the bench itself).
_reorder_for=1
if [ "$GRID" = icosahedral ]; then
    _gcd() { local a="$1" b="$2" t; while [ "$b" -ne 0 ]; do t="$b"; b=$(( a % b )); a="$t"; done; echo "$a"; }
    for N in ${GPU_RANKS//,/ }; do
        [ "$N" -gt "$TOTAL_GPUS" ] 2>/dev/null && continue
        g="$(_gcd "$_reorder_for" "$N")"; _reorder_for=$(( _reorder_for * N / g ))
    done
    echo "    icosahedral reorder_for (LCM of runnable device counts) = $_reorder_for"
fi

STAMP="$(date +%Y%m%d_%H%M%S)"
OUTDIR="${OUTDIR:-$SCRATCH/legoesm_scaling/routeb_gpu_${STAMP}}"
mkdir -p "$OUTDIR"
[ -n "${PBS_O_WORKDIR:-}" ] && exec > >(tee -a "$OUTDIR/run.log") 2>&1

echo "=== route-B GPU sweep ($GRID): mode=$MODE res=[$RES_LIST] gpus=[$GPU_RANKS] (cap=$TOTAL_GPUS) nlev=$NLEV ==="
echo "    nodes=$_n_nodes  outdir=$OUTDIR"

# rank -> local GPU pin + PALS->OMPI rank bridge.  jax.distributed's
# multicontroller init reads OMPI_COMM_WORLD_RANK/SIZE, but Cray PALS exposes
# only PALS_* -- so bridge PALS_RANKID -> OMPI_COMM_WORLD_RANK (SIZE is set
# per-N in the loop).  The mc_nccl canary proves this bridge + an explicit
# --coordinator is what federates route-B on Derecho; without it the mpi4py
# auto-detect returns jax.process_count()=1 and every rung runs un-federated.
PIN='export CUDA_VISIBLE_DEVICES=${PALS_LOCAL_RANKID:-0}; '\
'export OMPI_COMM_WORLD_RANK=${PALS_RANKID:-${OMPI_COMM_WORLD_RANK:-0}}; exec "$@"'
# Coordinator host = the first node in the allocation (rank 0).
COORD_HOST="$(head -n 1 "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || true)"
[ -n "$COORD_HOST" ] || COORD_HOST="$(hostname)"

# Distinct coordinator port per launch (sequential inits on one port hit a
# TIME_WAIT re-bind flake).
_port="${COORD_PORT_BASE:-29800}"

rc_all=0
for PREC in $PRECISIONS; do
  # The latlon/ico benches read this env var and record the precision they
  # actually ran; the cube driver takes --precision. An unknown value is a HARD
  # error -- a typo must never silently run f32 and get labelled f64.
  case "$PREC" in
    float32|fp32) export JAX_ENABLE_X64=0 ;;
    float64|fp64) export JAX_ENABLE_X64=1 ;;
    *) echo "ERROR: routeb_gpu_sweep PRECISIONS='$PREC' unsupported (float32|float64)." >&2; exit 2 ;;
  esac
  echo "=== precision $PREC (JAX_ENABLE_X64=$JAX_ENABLE_X64) ==="
for RES in $RES_LIST; do
  for N in $GPU_RANKS; do
    if [ "$N" -gt "$TOTAL_GPUS" ]; then
        echo "--- SKIP res=$RES N=$N > cap=$TOTAL_GPUS ---"
        continue
    fi
    # Balanced placement: spread N ranks across the fewest nodes, EVENLY.  For
    # powers of 2 this equals the old min(N, gpus/node); for the cube's N=6 it
    # gives 3+3 across 2 nodes (not 4+2), matching gpu_multinode Lane A.
    _nodes_needed=$(( (N + _gpus_per_node - 1) / _gpus_per_node ))
    PPN=$(( (N + _nodes_needed - 1) / _nodes_needed ))
    export LEGOESM_COORDINATOR_PORT="$_port"; _port=$(( _port + 1 ))
    export OMPI_COMM_WORLD_SIZE="$N"     # world size for the PALS->OMPI bridge
    _coord="${COORD_HOST}:${LEGOESM_COORDINATOR_PORT}"
    echo "=== route-B GPU $GRID res=$RES N=$N (ppn=$PPN, coord=$_coord) ==="
    # Per-grid SPMD bench argv (mpiexec + PIN wrapper is shared).  latlon sweeps
    # n_lat; icosahedral sweeps subdivision level with reorder_for pinned to the
    # shared padded mesh.  The mpas bench is inherently strong (fixed mesh, vary
    # devices) so it takes no --mode.
    case "$GRID" in
      latlon)
        BENCH=( "$PY" scripts/bench/bench_atm_latlon_spmd_scaling.py
                --multicontroller --n-devices "$N" --coordinator "$_coord"
                --mode "$MODE" --n-lat "$RES" --n-lon $(( 2 * RES )) --nlev "$NLEV"
                --steps $(( N_WARMUP + N_TIMING )) --warmup "$N_WARMUP"
                --out "$OUTDIR/${_sub}/spmd_R${RES}_N${N}_${PREC}.jsonl" ) ;;
      icosahedral)
        BENCH=( "$PY" scripts/bench/bench_mpas_spmd_scaling.py
                --multicontroller --n-devices "$N" --reorder-for "$_reorder_for"
                --coordinator "$_coord"
                --subdivision "$RES" --nlev "$NLEV" --partition-method sfc
                --steps $(( N_WARMUP + N_TIMING )) --warmup "$N_WARMUP"
                --out "$OUTDIR/${_sub}/spmd_L${RES}_N${N}_${PREC}.jsonl" ) ;;
      cubed-sphere|cubed_sphere)
        # run_cpu_mpi_scaling --cs-spmd writes its OWN flat-JSON filename into
        # --output-dir (grid_type=cubed-sphere + sypd) -> aggregator _row_from_json.
        # Uses --n-levels/--n-warmup/--n-timing (not --nlev/--steps/--warmup).
        BENCH=( "$PY" scripts/bench/run_cpu_mpi_scaling.py
                --grid cubed-sphere --cs-spmd --device gpu --coordinator "$_coord"
                --physics "$PHYSICS" --mode "$MODE" --resolution "$RES"
                --precision "$PREC" --n-levels "$NLEV"
                --n-warmup "$N_WARMUP" --n-timing "$N_TIMING"
                --output-dir "$OUTDIR/${_sub}" ) ;;
    esac
    (
        nccl_env
        mpiexec -n "$N" --ppn "$PPN" bash -c "$PIN" _ "${BENCH[@]}" < /dev/null
    ) || { echo "route-B GPU $GRID res=$RES N=$N prec=$PREC FAILED rc=$?"; rc_all=1; }
  done
done
done

echo "=== DONE rc=$rc_all ===   route-B GPU curve JSONL under: $OUTDIR/${_sub}/"
echo "    aggregate + plot:  scripts/cluster/scaling_derecho/finalize_scaling.sh $OUTDIR"
exit "$rc_all"
