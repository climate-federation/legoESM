#!/usr/bin/env bash
#SBATCH --job-name=amip_ll_sota
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=200G
#SBATCH --time=12:00:00
#
# =============================================================================
# legoESM AMIP — SOTA land on the low-res lat-lon grid, single-GPU
#   lat-lon res24 / L20 + MULTILAYER (Richards) land + CLM PFT/texture map
# =============================================================================
# The SOTA physics + land stack (config/amip/amip_sota.yaml: RRTMG, Morrison
# 2-moment micro, SBM convection, Sundqvist clouds, aerosol_ccn, and
# use_multilayer_land = 10-layer Richards soil (3 m) + CLM surface map +
# prognostic snow + Jarvis stomata) — but overlaid onto the coarse lat-lon grid
# (res24 / L20 / latlon_cgrid + polar filter, dt 150) so a FULL YEAR fits in ONE
# 12 h GPU job (~8.5 h). That keeps the run single-rank + single-job:
#   - multilayer land is single-rank only (no distributed partition spec), and
#   - land_ml is NOT yet in the checkpoint, so a chained/restarted run would
#     reset the deep-soil spin-up. Single job => no restart => soil preserved.
# Real ERA5 IC + real ETOPO topo + full transient CMIP6 forcing; diurnal-fixed
# compiled driver (#720/#721).
#
# Progression (submit 10 d + 30 d together; run 1 yr once they pass):
#   DAYS=10  -> smoke     (~20 min)
#   DAYS=30  -> 1 month   (~45 min)
#   DAYS=365 -> full year (~8.5 h, fits one job)
#
# Overridable via --export: DAYS, DIAG_DAYS, RES, NLEV, DT, OUTDIR, CONV_CLOUD.
# Submit under bb1596, e.g.:
#   sbatch --account=bb1596 --time=02:00:00 --job-name=amip_ll_sota_10d \
#     --export=ALL,DAYS=10,OUTDIR=/scratch/b/b309178/amip_ll_sota_10d \
#     scripts/cluster/amip/amip_latlon_sota_land.sbatch
# =============================================================================

set -uo pipefail

: "${REPO:=/work/bd1083/b309178/diffESM/legoesm_ap}"
: "${DAYS:=10}"
: "${DIAG_DAYS:=1}"
: "${RES:=24}"
: "${NLEV:=20}"
: "${DT:=150.0}"
: "${IC:=era5}"
: "${TOPO:=/work/bd1083/b309178/diffESM/legoesm_ap/data/bathymetry/etopo_1deg_clean.nc}"
: "${CONV_CLOUD:=false}"
: "${OUTDIR:=/scratch/b/b309178/amip_ll_sota_${DAYS}d}"
: "${CLM_SURFDATA:=${REPO}/data/clm/surfdata_1.9x2.5_16pfts_CMIP6_simyr2000.nc}"
PY=/work/bd1083/b309178/mambaforge/envs/diffesm/bin/python
PKG="${REPO}/packages"
BASE_CONFIG="${REPO}/config/amip/amip_sota.yaml"
LATLON_CONFIG="${OUTDIR}/run_config_amip_latlon_sota.yaml"

# shellcheck source=/dev/null
source "${REPO}/config/amip/amip_production.sh"

mkdir -p "${OUTDIR}"
exec > >(tee -a "${OUTDIR}/slurm-${SLURM_JOB_ID:-local}.out") \
     2> >(tee -a "${OUTDIR}/slurm-${SLURM_JOB_ID:-local}.err" >&2)

# Lat-lon overlay: inherit the SOTA physics + multilayer land, override only the
# grid block + IC (mirrors amip_latlon_1yr.sbatch's overlay on the production cfg).
cat > "${LATLON_CONFIG}" <<EOF
# AUTO-GENERATED by amip_latlon_sota_land.sbatch — do not edit.
include: ${BASE_CONFIG}
grid_type: latlon
discretization: latlon_cgrid
resolution: ${RES}
nlev: ${NLEV}
dt: ${DT}
use_polar_filter: true
ic: ${IC}
diag_days: ${DIAG_DAYS}
convective_cloud: ${CONV_CLOUD}
EOF

for p in "${ERA5_IC}" "${ETOPO}" "${SST}" "${SIC}" "${SOLAR}" "${GHG}" "${OZONE}" "${AEROSOL}" "${VOLCANIC}" "${BASE_CONFIG}" "${CLM_SURFDATA}"; do
    [[ -e "${p}" ]] || { echo "ERROR: missing ${p}"; exit 1; }
done

export PYTHONPATH="${REPO}/src:${PKG}/core:${PKG}/atmosphere:${PKG}/coupler:${PKG}/tools:${PKG}/ml:${PKG}/ocean:${PKG}/land:${PKG}/ice"
export JAX_PLATFORMS=cuda
export JAX_ENABLE_X64=1
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85

BRANCH=$(git -C "${REPO}" rev-parse --short HEAD 2>/dev/null || echo "unknown")
echo "AMIP lat-lon res${RES}/L${NLEV} SOTA (multilayer land + CLM)  DAYS=${DAYS}  job=${SLURM_JOB_ID:-local}  branch=${BRANCH}  $(date -u)"
echo "  CONFIG: ${LATLON_CONFIG}  (include ${BASE_CONFIG})"
echo "  CLM surfdata: ${CLM_SURFDATA}"
echo "  OUTDIR: ${OUTDIR}  DIAG_DAYS: ${DIAG_DAYS}  CONV_CLOUD: ${CONV_CLOUD}"

cd "${REPO}"
START=$(date +%s)
"${PY}" -u scripts/run/run_amip.py \
    --config "${LATLON_CONFIG}" \
    "${AMIP_PATH_FLAGS[@]}" \
    --clm-surfdata-path "${CLM_SURFDATA}" \
    --days "${DAYS}" \
    --diag-days "${DIAG_DAYS}" \
    --cmip-output \
    --checkpoint-days 0 \
    --output "${OUTDIR}" \
    --topography "${TOPO}"
RC=$?
echo "[latlon-sota] run_amip exit=${RC}  wall=$(( $(date +%s) - START ))s  $(date -u)"
exit "${RC}"
