#!/usr/bin/env bash
#SBATCH --job-name=amip_cmip6
#SBATCH --account=bb1596
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=4
#SBATCH --mem=128G
#SBATCH --time=12:00:00
#
# =============================================================================
# DEPRECATED (2026-07-24): this was the CUBE-lane (C48/L40 cd-grid) production
# chain.  The cube lane is RETIRED (Pierre directive 2026-07-23; #1296) and
# config/amip/amip_production.yaml now defaults to the MPAS lane — sourcing it
# from this 4-GPU runner would launch MPAS single-lane physics on a multi-GPU
# allocation (unsupported: the MPAS land port + q_v filter are single-process).
# USE INSTEAD: scripts/cluster/levante/amip_mpas_gpu_chain.sbatch.
# Kept for the historical record of the cube campaign; do not submit as-is.
# =============================================================================
# legoESM AMIP — proper CMIP6 production run (self-chaining), convective_cloud OFF
# =============================================================================
# Runs the AUTHORITATIVE production physics (config/amip/amip_production.yaml:
# C48/L40 cubed-sphere, RRTMGP, SBM convection, Morrison microphysics, Sundqvist
# clouds, COARE3 tiled surface, Manabe soil bucket + Jarvis stomatal, full CMIP6
# external forcing) via run_amip.py --config, with convective_cloud DISABLED.
#
# Why OFF: under PRESCRIBED SST, SBM-alone is CMIP6-class on TOA (albedo 0.295 vs
# CERES 0.290, OLR 234.7) whereas convective_cloud=ON pushes albedo 0.295->0.370
# / OLR 234.7->213.3 (~25 W/m^2 off CERES) for only +0.55 K of inert near-surface
# warming (30-day C48 A/B jobs 25929869 ON vs 25929870 OFF). The tracked YAML
# ships convective_cloud:true for parameter-identity with the coupled CMIP base;
# `--convective-cloud` is a one-directional store_true and cannot flip that off,
# so this runner writes a tiny include-override YAML into OUTDIR that sets
# convective_cloud:false. Everything else matches the tracked config exactly.
#
# Chaining (cubed-sphere convention): every link passes --days = TARGET_DAYS
# (TOTAL, not remaining) and the cube path runs range(start_step, n_steps_total).
# The driver checkpoints checkpoint_day_NNNN.npz every 30 days and, at
# --max-wallclock-seconds, checkpoints + exits cleanly; the next link resumes from
# the latest checkpoint via --restart-from. The script self-resubmits (afterok)
# until LATEST_DAY >= TARGET_DAYS. A single-link run (e.g. TARGET_DAYS=30) simply
# completes and does not resubmit.
#
# Keep the SLURM --time >= MAX_WALLCLOCK_SECONDS + JIT buffer so the driver
# always checkpoints gracefully before the SLURM kill (don't shorten --time
# below ~12 h without also lowering MAX_WALLCLOCK_SECONDS).
#
# Usage:
#   30-day:  sbatch --job-name=amip_cmip6_30d \
#              --export=ALL,OUTDIR=/scratch/b/b309178/amip_cmip6_30d,TARGET_DAYS=30 \
#              scripts/cluster/amip/amip_cmip6_chain.sbatch
#   1-year:  sbatch --job-name=amip_cmip6_1979_1yr \
#              --export=ALL,OUTDIR=/scratch/b/b309178/amip_cmip6_1979_365d,TARGET_DAYS=365 \
#              scripts/cluster/amip/amip_cmip6_chain.sbatch
# =============================================================================

set -uo pipefail

: "${REPO:=/work/bd1083/b309178/diffESM/legoesm_ap}"
: "${OUTDIR:=/scratch/b/b309178/amip_cmip6_30d}"
: "${TARGET_DAYS:=30}"
: "${MAX_WALLCLOCK_SECONDS:=41400}"   # 11.5 h: checkpoint+exit before the 12 h SLURM kill
PY=/work/bd1083/b309178/mambaforge/envs/diffesm/bin/python
PKG="${REPO}/packages"
BASE_CONFIG="${REPO}/config/amip/amip_production.yaml"
OFF_CONFIG="${OUTDIR}/run_config_amip_cmip6_convcloud_off.yaml"

# shellcheck source=/dev/null
source "${REPO}/config/amip/amip_production.sh"

mkdir -p "${OUTDIR}"
exec > >(tee -a "${OUTDIR}/slurm-${SLURM_JOB_ID:-local}.out") \
     2> >(tee -a "${OUTDIR}/slurm-${SLURM_JOB_ID:-local}.err" >&2)

# Self-contained OFF override (include:s the tracked production YAML, flips
# convective_cloud off). Rewritten idempotently each link; travels with OUTDIR.
cat > "${OFF_CONFIG}" <<EOF
# AUTO-GENERATED by amip_cmip6_chain.sbatch — do not edit by hand.
# Proper CMIP6 AMIP run = the tracked production config with convective_cloud
# disabled (best prescribed-SST TOA; see the sbatch header for the A/B rationale).
include: ${BASE_CONFIG}
convective_cloud: false
EOF

for p in "${ERA5_IC}" "${ETOPO}" "${SST}" "${SIC}" "${SOLAR}" "${GHG}" "${OZONE}" "${AEROSOL}" "${VOLCANIC}" "${BASE_CONFIG}"; do
    [[ -e "${p}" ]] || { echo "ERROR: missing ${p}"; exit 1; }
done

export PYTHONPATH="${REPO}/src:${PKG}/core:${PKG}/atmosphere:${PKG}/coupler:${PKG}/tools:${PKG}/ml:${PKG}/ocean:${PKG}/land:${PKG}/ice"
export JAX_PLATFORMS=cuda
export JAX_ENABLE_X64=1
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85

BRANCH=$(git -C "${REPO}" rev-parse --short HEAD 2>/dev/null || echo "unknown")
echo "AMIP CMIP6 chain  convective_cloud=FALSE  job=${SLURM_JOB_ID:-local}  branch=${BRANCH}  $(date -u)"
echo "  CONFIG: ${OFF_CONFIG}  (include:s amip_production.yaml)"
echo "  OUTDIR: ${OUTDIR}  TARGET_DAYS: ${TARGET_DAYS}  MAX_WALLCLOCK_SECONDS: ${MAX_WALLCLOCK_SECONDS}"

# Resume from the latest checkpoint (empty on the first link).
LATEST_CKPT=$(ls -1 "${OUTDIR}"/checkpoint_day_*.npz 2>/dev/null | sort -V | tail -1 || true)
LATEST_DAY=0
if [[ -n "${LATEST_CKPT}" ]]; then
    LATEST_DAY=$(basename "${LATEST_CKPT}" | sed -E 's/checkpoint_day_0*([0-9]+)\.npz/\1/')
    echo "  Resuming from ${LATEST_CKPT}  (day ${LATEST_DAY}/${TARGET_DAYS})"
else
    echo "  First link — starting from ERA5 IC"
fi

if (( LATEST_DAY >= TARGET_DAYS )); then
    echo "  Already at or past target (${LATEST_DAY} >= ${TARGET_DAYS}). Nothing to do."
    exit 0
fi

cd "${REPO}"
CMD=(
    "${PY}" -u scripts/run/run_amip.py
        --config "${OFF_CONFIG}"
        "${AMIP_PATH_FLAGS[@]}"
        --days "${TARGET_DAYS}"
        --checkpoint-days 30
        --max-wallclock-seconds "${MAX_WALLCLOCK_SECONDS}"
        --output "${OUTDIR}"
)
if [[ -n "${LATEST_CKPT}" ]]; then
    CMD+=( --restart-from "${LATEST_CKPT}" )
fi

echo "[chain] launching: ${CMD[*]}"
"${CMD[@]}"
RC=$?
echo "[chain] run_amip exit=${RC}  $(date -u)"

# Auto-chain: re-submit if not done and this link exited cleanly (0 = clean
# wallclock checkpoint-exit or genuine completion).
if (( RC == 0 )); then
    NEW_CKPT=$(ls -1 "${OUTDIR}"/checkpoint_day_*.npz 2>/dev/null | sort -V | tail -1 || true)
    NEW_DAY=0
    [[ -n "${NEW_CKPT}" ]] && NEW_DAY=$(basename "${NEW_CKPT}" | sed -E 's/checkpoint_day_0*([0-9]+)\.npz/\1/')
    if (( NEW_DAY < TARGET_DAYS )) && [[ -n "${SLURM_JOB_ID:-}" ]]; then
        # OZONE/AEROSOL/VOLCANIC forwarded EXPLICITLY: a multi-year transient
        # campaign (e.g. the 1979-2014 merged forcing under
        # data/forcing/cmip6_1979-2014/) overrides these at first submit; every
        # later link must pin the SAME files — relying on --export=ALL env
        # inheritance alone is too fragile for an ~80-link chain.
        NEXT=$(sbatch \
                 --account="${SLURM_JOB_ACCOUNT:-bb1596}" \
                 --dependency="afterok:${SLURM_JOB_ID}" \
                 --job-name="${SLURM_JOB_NAME:-amip_cmip6}" \
                 --time="${SBATCH_TIMELIMIT:-12:00:00}" \
                 --export="ALL,OUTDIR=${OUTDIR},TARGET_DAYS=${TARGET_DAYS},MAX_WALLCLOCK_SECONDS=${MAX_WALLCLOCK_SECONDS},OZONE=${OZONE},AEROSOL=${AEROSOL},VOLCANIC=${VOLCANIC}" \
                 "$0" | awk '{print $NF}')
        echo "[chain] ${NEW_DAY}/${TARGET_DAYS} d done; queued next link: ${NEXT}"
    else
        echo "[chain] reached ${NEW_DAY}/${TARGET_DAYS} d — chain complete."
    fi
fi
exit "${RC}"
