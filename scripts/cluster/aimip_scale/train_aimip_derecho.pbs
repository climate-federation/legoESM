#!/bin/bash -l
#PBS -N aimip_scale_t106
#PBS -A P08010000
#PBS -q main
#PBS -l job_priority=regular
#PBS -l select=1:ncpus=64:ngpus=1:gpu_type=a100:mem=400GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -k eod
# ===========================================================================
# AIMIP AT SCALE on NCAR Derecho — single A100-80GB, T106 (~1.1 deg), ALL
# training years 1979-2014 (576 IC/target pairs), one variant per job.
#
# AIMIP training is SINGLE-DEVICE by design (the spectral semi-implicit solver
# all-gathers vertical levels and the SH transforms carry no collectives), so
# "at scale" here = a bigger GPU (80 GB vs Ginsburg's 24-40 GB) running the
# full-resolution, all-years, higher-capacity config — NOT multi-GPU sharding.
# The 80 GB card is what makes T106 + RRTMGP + K=2 autoregressive rollout +
# spatial-surface coefs fit.
#
# The run self-CHAINS: run_aimip.py writes a per-epoch checkpoint AND a
# mid-epoch per-chunk checkpoint (chunk_latest.eqx: model + optimizer state +
# chunk index, #942), and --resume picks up at the exact chunk it left off, so
# a T106 run whose SINGLE epoch (~13 h) exceeds one 12 h walltime resubmits
# itself and makes monotonic progress instead of restarting epoch 0 forever.
#
# The variant ladder: classical (full physics + RRTMGP radiation),
# column_nn (ALL physics incl. radiation learned by a column MLP),
# sfno_full (SFNO emulates the ENTIRE atmosphere — no dycore, no
# physics).  sfno_physics (SFNO physics, dycore retained) remains
# available as an optional intermediate rung.
#
# SUBMIT (one per variant):
#   qsub -v VARIANT=classical    scripts/cluster/aimip_scale/train_aimip_derecho.pbs
#   qsub -v VARIANT=column_nn    scripts/cluster/aimip_scale/train_aimip_derecho.pbs
#   qsub -v VARIANT=sfno_full    scripts/cluster/aimip_scale/train_aimip_derecho.pbs
# First submit auto-detects "no checkpoint yet -> fresh"; chained links pass
# RESUME=1 themselves. Override the account with `qsub -A <proj>`; paths + conda
# env live in scripts/cluster/scaling_derecho/_env.sh (EDIT before first run).
# ===========================================================================
set -uo pipefail

VARIANT="${VARIANT:-sfno_full}"     # classical | column_nn | sfno_full | sfno_physics
CHAIN="${CHAIN:-0}"
CHAIN_MAX="${CHAIN_MAX:-24}"  # v2 curriculum (72h/120h phases) needs more links

cd "$PBS_O_WORKDIR"
source scripts/cluster/scaling_derecho/_env.sh   # sets REPO, PY, conda, JAX env
cd "$REPO"

export JAX_ENABLE_X64=1
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
# Expose the CPU backend alongside CUDA so chunk_prefetch can host-stage the
# buffered chunk off the GPU (#985: prefetch OOM'd because the next chunk rode
# GPU memory). Harmless when prefetch is off; cuda stays the default device.
export JAX_PLATFORMS=cuda,cpu

SUITE="config/aimip/scale/suite_${VARIANT}.yaml"
OUT="results/aimip_scale_t106/${VARIANT}"
mkdir -p "$OUT/logs"

# Resume automatically if ANY checkpoint already exists for this variant --
# either a completed-epoch checkpoint (epoch_*.eqx) OR a mid-epoch per-chunk
# checkpoint (chunk_latest.eqx).  The latter is the #942 fix: a job killed by
# the 12 h walltime cap PART-WAY through the ~13 h epoch writes chunk_latest.eqx
# but no epoch_*.eqx, so detecting only epoch_*.eqx would (wrongly) restart the
# epoch from scratch on the next link -- the "zero progress forever" bug.
RESUME_FLAG=""
if ls "$OUT"/*/epoch_*.eqx >/dev/null 2>&1 \
   || ls "$OUT"/*/chunk_latest.eqx >/dev/null 2>&1 \
   || [ "${RESUME:-0}" = "1" ]; then
  RESUME_FLAG="--resume"
fi

echo "[aimip-scale] $(date) variant=$VARIANT link=$CHAIN suite=$SUITE resume=${RESUME_FLAG:-no}"
# Stop training with slack to run the chain-resubmit below BEFORE PBS SIGKILLs
# the whole job at the walltime cap.  A walltime kill terminates this script AND
# python together, so a `qsub` chain placed after the run never fires mid-
# curriculum -- the #942-era "chain never advanced on a walltime-bound link" bug
# (#985).  timeout stops the run itself in time; progress is preserved by the
# per-chunk chunk_latest.eqx checkpoint, so the next link resumes where it left
# off.  Keep LINK_BUDGET_S in sync with `#PBS -l walltime` (12 h) below.
LINK_BUDGET_S=$(( 12*3600 - 45*60 ))   # 40500 s = walltime - 45 min drain
# Resume-artifact signature (name:mtime of the newest FORWARD-PROGRESS checkpoint)
# BEFORE this link -- so a walltime-bound link is chained ONLY if it actually
# advanced a resumable checkpoint. The chunked variants (column_nn / sfno_physics
# with chunk_windows>0) write chunk_latest.eqx every chunk; `classical` AND
# `sfno_full` load the full dataset with NO per-chunk checkpoint, so if such an
# epoch exceeds the budget the link produces nothing new and blindly chaining
# would restart epoch 0 every link (#985 re-review). Restrict to epoch_*.eqx + chunk_latest.eqx (the only
# resume artifacts) -- NOT every *.eqx -- so an unrelated/eval .eqx mtime can't
# be mistaken for training progress; params.eqx (the DONE marker) is handled by
# the FINAL check below, not here.
_ckpt_sig() {
  ls -t "$OUT"/*/epoch_*.eqx "$OUT"/*/chunk_latest.eqx 2>/dev/null \
    | head -1 | xargs -r stat -c '%n:%Y' 2>/dev/null
}
SIG_BEFORE="$(_ckpt_sig)"
timeout -k 120 "${LINK_BUDGET_S}s" "$PY" -u scripts/run/run_aimip.py --suite "$SUITE" $RESUME_FLAG
RC=$?
# timeout returns 124 (SIGTERM) / 137 (SIGKILL after the -k grace) when it hits
# the link budget: NOT a training failure. Chain it ONLY if a checkpoint advanced
# (resumable progress); otherwise stop rather than restart epoch 0 forever.
if [ "$RC" -eq 124 ] || [ "$RC" -eq 137 ]; then
  if [ "$(_ckpt_sig)" != "$SIG_BEFORE" ]; then
    echo "[aimip-scale] hit link budget ${LINK_BUDGET_S}s (rc=$RC), checkpoint advanced -> chaining"
    RC=0
  else
    echo "[aimip-scale] hit link budget ${LINK_BUDGET_S}s (rc=$RC) but NO new checkpoint" \
         "-> this variant is not mid-epoch resumable (classical/sfno_full have no" \
         "chunk_latest.eqx and the epoch did not finish); NOT chaining to avoid an" \
         "epoch-0 restart loop. Remedy: chunked variants (column_nn/sfno_physics)" \
         "-> chunk_windows>0; classical/sfno_full -> a walltime long enough to" \
         "finish one epoch (they do not support chunked streaming)."
    RC=1
  fi
fi
echo "[aimip-scale] run_aimip rc=$RC $(date)"

# Chain until params.eqx (final) exists or CHAIN_MAX reached. run_aimip writes
# results/aimip_scale_t106/<variant>/<variant>/params.eqx only after the last
# epoch; while it is absent and the last run exited cleanly, resubmit.
FINAL="$OUT/${VARIANT}/params.eqx"
if [ "$RC" -eq 0 ] && [ ! -f "$FINAL" ] && [ "$CHAIN" -lt "$CHAIN_MAX" ]; then
  echo "[aimip-scale] not complete -> chaining link $((CHAIN+1))/$CHAIN_MAX"
  qsub -v VARIANT="$VARIANT",CHAIN="$((CHAIN+1))",CHAIN_MAX="$CHAIN_MAX",RESUME=1 \
    "$PBS_O_WORKDIR/scripts/cluster/aimip_scale/train_aimip_derecho.pbs"
elif [ -f "$FINAL" ]; then
  echo "[aimip-scale] DONE: $FINAL"
else
  echo "[aimip-scale] stop (rc=$RC or chain limit $CHAIN_MAX)"
fi
