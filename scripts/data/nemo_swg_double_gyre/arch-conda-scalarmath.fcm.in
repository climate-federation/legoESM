# Portable rendering of the reference NEMO 5.0.2 architecture used for the
# certified SWG_DG comparison on 2026-10-13.  build_swg_dg.sh replaces the
# single @CONDA_PREFIX@ token from its required --conda-prefix argument.
#
# Reference file:
#   NEMO 5.0.2 arch/arch-conda-scalarmath.fcm
# Reference SHA-256:
#   132f7a0500c4f0e86d8d3bf7864974a82e1dea5d83166dcfdfaf409e2ca04561
# Toolchain: GNU Fortran 15.2.0, Open MPI 5.0.10, no XIOS.

%CONDA_PREFIX        @CONDA_PREFIX@

%HDF5_HOME           %CONDA_PREFIX
%NCDF_C_HOME         %CONDA_PREFIX
%NCDF_F_HOME         %CONDA_PREFIX

%NCDF_INC            -I%NCDF_F_HOME/include -I%NCDF_C_HOME/include -I%HDF5_HOME/include
%NCDF_LIB            -L%NCDF_F_HOME/lib -lnetcdff -L%NCDF_C_HOME/lib -lnetcdf

%CPP                 cpp -Dkey_nosignedzero
%FC                  mpif90 -c -cpp
%FCFLAGS             -fdefault-real-8 -O3 -funroll-all-loops -fcray-pointer -ffree-line-length-none -fallow-argument-mismatch -fno-tree-vectorize
%FFLAGS              %FCFLAGS
%LD                  mpif90
%LDFLAGS             -Wl,-rpath,%CONDA_PREFIX/lib
%FPPFLAGS            -P -traditional
%AR                  ar
%ARFLAGS             rs
%MK                  make
%USER_INC            %NCDF_INC
%USER_LIB            %NCDF_LIB -L%CONDA_PREFIX/lib -lnetcdff -lnetcdf -lhdf5_hl -lhdf5

%CC                  mpicc
%CFLAGS              -O0
