    10	from legoesm.ocean.physics.surface_forcing.config import SurfaceForcingConfig
    11	
    12	
    13	def make_surface_forcing_physics(
    14	    config: SurfaceForcingConfig,
    15	) -> Callable:
    16	    """Create a surface forcing physics function.
    17	
    18	    Parameters
    19	    ----------
    20	    config : SurfaceForcingConfig
    21	
    22	    Returns
    23	    -------
    24	    Callable : physics_fn(state, grid, z_coord) -> OceanTendencies
    25	    """
    26	    scheme = config.scheme
    27	
    28	    if scheme == "none":
    29	        return _make_none()
    30	    elif scheme == "prescribed":
    31	        return _make_prescribed(config)
    32	    elif scheme == "restoring":
    33	        return _make_restoring(config)
    34	    elif scheme == "combined":
    35	        return _make_combined(config)
    36	    elif scheme == "bulk_formulas":
    37	        return _make_bulk_formulas(config)
    38	    else:
    39	        raise ValueError(f"Unknown surface forcing scheme: {scheme!r}")
    40	
    41	
    42	def _make_none() -> Callable:
    43	    def physics_fn(state: OceanState, grid: CubedSphereGrid,
    44	                   z_coord: OceanZStarCoordinate,
    45	                   surface_forcing=None) -> OceanTendencies:
    46	        return _zero_tendencies(state)
    47	    return physics_fn
    48	
    49	
    50	def _make_prescribed(config: SurfaceForcingConfig) -> Callable:
    51	    from legoesm.ocean.physics.surface_forcing.prescribed import prescribed_surface_forcing
    52	    cfg = config.prescribed
    53	
    54	    def physics_fn(state: OceanState, grid: CubedSphereGrid,
    55	                   z_coord: OceanZStarCoordinate,
    56	                   surface_forcing=None) -> OceanTendencies:
    57	        J = compute_ocean_jacobian(state.eta.data, state.H_bathy.data, z_coord)
    58	        out = prescribed_surface_forcing(
    59	            state.u.data, state.v.data, state.T.data, state.S.data,
    60	            z_coord, J, grid, cfg,
    61	        )
    62	        return _wrap_tendencies(out.du_dt, out.dv_dt, out.dT_dt, out.dS_dt, state)
    63	    return physics_fn
    64	
    65	
    66	def _make_restoring(config: SurfaceForcingConfig) -> Callable:
    67	    from legoesm.ocean.physics.surface_forcing.restoring import restoring_surface_forcing
    68	    cfg = config.restoring
    69	
    70	    def physics_fn(state: OceanState, grid: CubedSphereGrid,
    71	                   z_coord: OceanZStarCoordinate,
    72	                   surface_forcing=None) -> OceanTendencies:
    73	        out = restoring_surface_forcing(state.T.data, state.S.data, grid, cfg)
    74	        return _wrap_tendencies(out.du_dt, out.dv_dt, out.dT_dt, out.dS_dt, state)
    75	    return physics_fn
    76	
    77	
    78	def _make_combined(config: SurfaceForcingConfig) -> Callable:
    79	    """Prescribed wind stress + temperature/salinity restoring."""
    80	    from legoesm.ocean.physics.surface_forcing.prescribed import prescribed_surface_forcing
    81	    from legoesm.ocean.physics.surface_forcing.restoring import restoring_surface_forcing
    82	    cfg_p = config.prescribed
    83	    cfg_r = config.restoring
    84	
    85	    def physics_fn(state: OceanState, grid: CubedSphereGrid,
    86	                   z_coord: OceanZStarCoordinate,
    87	                   surface_forcing=None) -> OceanTendencies:
    88	        J = compute_ocean_jacobian(state.eta.data, state.H_bathy.data, z_coord)
    89	        p = prescribed_surface_forcing(
    90	            state.u.data, state.v.data, state.T.data, state.S.data,
    91	            z_coord, J, grid, cfg_p,
    92	        )
    93	        r = restoring_surface_forcing(state.T.data, state.S.data, grid, cfg_r)
    94	        return _wrap_tendencies(
    95	            p.du_dt + r.du_dt,
    96	            p.dv_dt + r.dv_dt,
    97	            p.dT_dt + r.dT_dt,
    98	            p.dS_dt + r.dS_dt,
    99	            state,
   100	        )
   101	    return physics_fn
   102	
   103	
   104	def _make_bulk_formulas(config: SurfaceForcingConfig) -> Callable:
   105	    from legoesm.ocean.physics.surface_forcing.bulk_formulas import bulk_formula_surface_forcing
   106	    cfg = config.bulk_formulas
   107	
   108	    def physics_fn(state: OceanState, grid: CubedSphereGrid,
   109	                   z_coord: OceanZStarCoordinate,
   110	                   surface_forcing=None) -> OceanTendencies:
   111	        J = compute_ocean_jacobian(state.eta.data, state.H_bathy.data, z_coord)
   112	        out = bulk_formula_surface_forcing(
   113	            state.T.data, state.S.data, z_coord, J, cfg,
   114	        )
   115	        return _wrap_tendencies(out.du_dt, out.dv_dt, out.dT_dt, out.dS_dt, state)
   116	    return physics_fn
   117	
