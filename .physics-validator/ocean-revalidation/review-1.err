     1	"""Prescribed surface forcing: fixed wind stress and heat/freshwater fluxes."""
     2	
     3	from __future__ import annotations
     4	
     5	import jax.numpy as jnp
     6	
     7	from legoesm.ocean.eos import rho_0 as rho_0_ref, c_sw
     8	from legoesm.ocean.physics.surface_forcing.config import PrescribedForcingConfig
     9	from legoesm.ocean.physics.surface_forcing.output import SurfaceForcingOutput
    10	from legoesm.ocean.physics.surface_forcing.wind_profiles import compute_wind_stress
    11	from legoesm.ocean.vertical import OceanZStarCoordinate
    12	
    13	
    14	def prescribed_surface_forcing(
    15	    u: jnp.ndarray,
    16	    v: jnp.ndarray,
    17	    T: jnp.ndarray,
    18	    S: jnp.ndarray,
    19	    z_coord: OceanZStarCoordinate,
    20	    jacobian: jnp.ndarray,
    21	    grid,  # Any grid with grid_lat property (GridProtocol)
    22	    cfg: PrescribedForcingConfig,
    23	) -> SurfaceForcingOutput:
    24	    """Apply prescribed surface forcing to the top ocean layer.
    25	
    26	    Parameters
    27	    ----------
    28	    u, v : array (6, n, n, nlev)
    29	    T, S : array (6, n, n, nlev)
    30	    z_coord : OceanZStarCoordinate
    31	    jacobian : array (6, n, n)
    32	    grid : CubedSphereGrid
    33	    cfg : PrescribedForcingConfig
    34	
    35	    Returns
    36	    -------
    37	    SurfaceForcingOutput
    38	    """
    39	    nlev = u.shape[-1]
    40	    shape_3d = u.shape
    41	    dtype = u.dtype
    42	
    43	    # Top layer thickness
    44	    dz_0 = z_coord.dz_ref[0] * jacobian  # (6, n, n)
    45	    inv_rho_dz = 1.0 / (rho_0_ref * jnp.maximum(dz_0, 1e-10))
    46	
    47	    # Wind stress from shared grid-agnostic computation
    48	    tau_x, tau_y = compute_wind_stress(grid.grid_lat, cfg)
    49	
    50	    # Build top-layer-only tendencies via ``jnp.pad`` along the
    51	    # trailing axis instead of allocating a fresh full ``(*, nlev)``
    52	    # zero buffer per field and scattering the surface row.  Single
    53	    # Pad HLO op each — this physics fires every ocean step in
    54	    # configurations that use the prescribed surface forcing.
    55	    nlev = shape_3d[-1]
    56	    pad_axes = ((0, 0),) * (len(shape_3d) - 1)
    57	    du_dt = jnp.pad(
    58	        (tau_x * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
    59	    )
    60	    dv_dt = jnp.pad(
    61	        (tau_y * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
    62	    )
    63	
    64	    # Heat flux: dT/dt = Q_net / (rho_0 * c_sw * dz_0)
    65	    Q_net = jnp.full_like(dz_0, cfg.Q_net, dtype=dtype)
    66	    inv_rho_csw_dz = 1.0 / (rho_0_ref * c_sw * jnp.maximum(dz_0, 1e-10))
    67	    dT_dt = jnp.pad(
    68	        (Q_net * inv_rho_csw_dz)[..., None], (*pad_axes, (0, nlev - 1)),
    69	    )
    70	
    71	    # Freshwater (virtual salt flux): dS/dt = +S * E_minus_P / dz_0
    72	    # Positive E-P means net evaporation → water leaves → salt concentrates → dS/dt > 0
    73	    if cfg.E_minus_P != 0.0:
    74	        inv_dz = 1.0 / jnp.maximum(dz_0, 1e-10)
    75	        dS_dt = jnp.pad(
    76	            (S[..., 0] * cfg.E_minus_P * inv_dz)[..., None],
    77	            (*pad_axes, (0, nlev - 1)),
    78	        )
    79	    else:
    80	        dS_dt = jnp.zeros(shape_3d, dtype=dtype)
    81	
    82	    return SurfaceForcingOutput(
    83	        du_dt=du_dt, dv_dt=dv_dt, dT_dt=dT_dt, dS_dt=dS_dt,
    84	        Q_net=Q_net, tau_x=tau_x, tau_y=tau_y,
    85	    )

