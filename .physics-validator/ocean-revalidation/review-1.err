    68	def test_shortwave_penetration_tendency_shape_and_finite():
    69	    sw_down, dz_ref, z_half_ref, J = _setup()
    70	    dT_dt = shortwave_penetration_tendency(
    71	        sw_down, dz_ref, z_half_ref, J,
    72	    )
    73	    expected_shape = sw_down.shape + (dz_ref.shape[0],)
    74	    assert dT_dt.shape == expected_shape
    75	    assert jnp.all(jnp.isfinite(dT_dt))
    76	    # All layers absorb a non-negative fraction (heating with sw>0).
    77	    assert jnp.all(dT_dt >= 0.0)
    78	
    79	
    80	def test_top_layer_warms_most():
    81	    sw_down, dz_ref, z_half_ref, J = _setup()
    82	    dT_dt = shortwave_penetration_tendency(
    83	        sw_down, dz_ref, z_half_ref, J,
    84	    )
    85	    # Top layer (index 0) absorbs the most under exponential decay.
    86	    top = float(jnp.mean(dT_dt[..., 0]))
    87	    bottom = float(jnp.mean(dT_dt[..., -1]))
    88	    assert top > bottom
    89	
    90	
    91	def test_zero_swdown_gives_zero_tendency():
    92	    sw_down, dz_ref, z_half_ref, J = _setup()
    93	    out = shortwave_penetration_tendency(
    94	        jnp.zeros_like(sw_down), dz_ref, z_half_ref, J,
    95	    )
    96	    assert jnp.allclose(out, 0.0)
    97	
    98	
    99	def test_water_type_changes_result():
   100	    sw_down, dz_ref, z_half_ref, J = _setup()
   101	    out_I = shortwave_penetration_tendency(
   102	        sw_down, dz_ref, z_half_ref, J,
   103	        config=ShortwavePenetrationConfig(water_type="I"),
   104	    )
   105	    out_III = shortwave_penetration_tendency(
   106	        sw_down, dz_ref, z_half_ref, J,
   107	        config=ShortwavePenetrationConfig(water_type="III"),
   108	    )
   109	    # Type III is more turbid: surface layer absorbs more than Type I.
   110	    assert float(jnp.mean(out_III[..., 0])) > float(jnp.mean(out_I[..., 0]))
   111	
   112	
   113	def test_jit_compiles():
   114	    sw_down, dz_ref, z_half_ref, J = _setup()
   115	    fn = jax.jit(shortwave_penetration_tendency)
   116	    out = fn(sw_down, dz_ref, z_half_ref, J)
   117	    assert jnp.all(jnp.isfinite(out))

