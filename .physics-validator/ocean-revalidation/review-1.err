   721	        max_T_brine = float(jnp.max(jnp.abs(out_brine.dT_dt.data)))
   722	        max_T_fresh = float(jnp.max(jnp.abs(out_fresh.dT_dt.data)))
   723	        assert max_T_brine >= max_T_fresh - 1e-30, (
   724	            f"B_salt sign regression: freshening produced stronger mixing "
   725	            f"({max_T_fresh:.3e}) than brine rejection ({max_T_brine:.3e}). "
   726	            "Under the correct sign (B_salt = +g*beta*Q_S), brine "
   727	            "rejection destabilizes and should mix at least as hard as "
   728	            "freshening (which stabilizes)."
   729	        )
