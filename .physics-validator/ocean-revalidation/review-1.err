   263	    def test_with_runoff(self):
   264	        n = 10
   265	        precip = jnp.zeros(n)
   266	        lhflx = jnp.zeros(n)
   267	        runoff_sfc = jnp.ones(n) * 1e-5
   268	        runoff_sub = jnp.ones(n) * 0.5e-5
