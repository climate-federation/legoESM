     1	"""Entraining mass-flux convective plume parameterization."""
     2	
     3	from __future__ import annotations
     4	
     5	import jax
     6	import jax.numpy as jnp
     7	
     8	from legoesm.ocean.eos import wright_eos
     9	from legoesm.ocean.physics.convection.config import PlumeConfig
    10	from legoesm.ocean.physics.convection.output import OceanConvectionOutput
    11	from legoesm.ocean.vertical import OceanZStarCoordinate
    12	
    13	
    14	def plume_convection(
    15	    T: jnp.ndarray,
    16	    S: jnp.ndarray,
    17	    rho: jnp.ndarray,
    18	    p_hydro: jnp.ndarray,
    19	    z_coord: OceanZStarCoordinate,
    20	    jacobian: jnp.ndarray,
    21	    cfg: PlumeConfig,
    22	) -> OceanConvectionOutput:
    23	    """Apply entraining mass-flux plume convection.
    24	
    25	    Parameters
    26	    ----------
    27	    T, S : array (6, n, n, nlev)
    28	    rho : array (6, n, n, nlev)
    29	    p_hydro : array (6, n, n, nlev)
    30	    z_coord : OceanZStarCoordinate
    31	    jacobian : array (6, n, n)
    32	    cfg : PlumeConfig
    33	
    34	    Returns
    35	    -------
    36	    OceanConvectionOutput
    37	    """
    38	    nlev = T.shape[-1]
    39	    shape_3d = T.shape
    40	    dtype = T.dtype
    41	    dz_actual = z_coord.dz_ref * jacobian[..., jnp.newaxis]
    42	
    43	    # Detect unstable surface: rho(k=0) > rho(k=1)
    44	    surface_unstable = rho[..., 0] > rho[..., 1]  # (6, n, n)
    45	
    46	    # Initialize plume properties at surface
    47	    T_plume_init = T[..., 0] + cfg.T_excess
    48	    S_plume_init = S[..., 0]
    49	
    50	    # Descend plume using scan over levels (starting from level 1)
    51	    def scan_fn(carry, k):
    52	        T_plume, S_plume, active = carry
    53	        dz_k = dz_actual[..., k]
    54	
    55	        # Entrain environment.  ``1 - exp(-epsilon*dz)`` is the exact
    56	        # solution of dT_plume/dz = -epsilon*(T_plume - T_env) over a
    57	        # layer of thickness ``dz``.  The first-order linearization
    58	        # ``epsilon*dz`` exceeds 1 and goes negative for thick layers
    59	        # (e.g. epsilon=1e-3 m^-1, dz>1000 m), which would produce an
    60	        # unphysical sign-flip on the plume properties.  ``-expm1(-x)``
    61	        # is monotone in [0, 1) for x>=0 and gradient-friendly.
    62	        entrain = -jnp.expm1(-cfg.epsilon * dz_k)
    63	        T_plume = (1.0 - entrain) * T_plume + entrain * T[..., k]
    64	        S_plume = (1.0 - entrain) * S_plume + entrain * S[..., k]
    65	
    66	        # Buoyancy check
    67	        rho_plume = wright_eos(T_plume, S_plume, p_hydro[..., k])
    68	        delta_rho = rho_plume - rho[..., k]
    69	
    70	        # Plume is active where it's denser than environment (sinking):
    71	        # delta_rho > 0 means rho_plume > rho_env → plume sinks → stay active
    72	        active = active * jax.nn.sigmoid(delta_rho * 1e4)
    73	
    74	        # Detrainment tendency at this level
    75	        dT_k = cfg.alpha_plume * cfg.epsilon * (T_plume - T[..., k]) * active
    76	        dS_k = cfg.alpha_plume * cfg.epsilon * (S_plume - S[..., k]) * active
    77	
    78	        return (T_plume, S_plume, active), (dT_k, dS_k, active)
    79	
    80	    init_active = surface_unstable.astype(dtype)
    81	    (_, _, _), (dT_levels, dS_levels, active_levels) = jax.lax.scan(
    82	        scan_fn,
    83	        (T_plume_init, S_plume_init, init_active),
    84	        jnp.arange(1, nlev),
    85	    )
    86	
    87	    # dT_levels shape: (nlev-1, 6, n, n) — move level axis to last,
    88	    # then ``jnp.pad`` along the trailing axis instead of
    89	    # ``zeros + .at[..., 1:].set(...)`` which materialises a fresh
    90	    # zero buffer + scatter.  Single Pad HLO op each.
    91	    dT_levels_t = jnp.moveaxis(dT_levels, 0, -1)  # (6, n, n, nlev-1)
    92	    dS_levels_t = jnp.moveaxis(dS_levels, 0, -1)
    93	    pad_axes = ((0, 0),) * (dT_levels_t.ndim - 1)
    94	    dT_dt = jnp.pad(dT_levels_t, (*pad_axes, (1, 0)))
    95	    dS_dt = jnp.pad(dS_levels_t, (*pad_axes, (1, 0)))
    96	
    97	    # Convection flag at interfaces (average of adjacent levels' activity)
    98	    active_t = jnp.moveaxis(active_levels, 0, -1)  # (6, n, n, nlev-1)
    99	    flag = active_t
   100	
   101	    return OceanConvectionOutput(
   102	        dT_dt=dT_dt,
   103	        dS_dt=dS_dt,
   104	        convection_flag=flag,
   105	    )

