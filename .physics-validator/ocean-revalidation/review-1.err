   749	    def test_monotonic_drag_with_wind(self):
   750	        """Drag should increase monotonically with wind speed."""
   751	        from legoesm.coupler.bulk_flux import compute_most_fluxes
   752	        winds = jnp.array([2.0, 5.0, 10.0, 15.0, 20.0])
