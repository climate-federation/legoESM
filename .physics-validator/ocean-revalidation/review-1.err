    35	def _setup(nx=4, ny=3, nlev=10, H=200.0):
    36	    """Build SW input + reference z grid (top-to-bottom, negative)."""
    37	    sw_down = jnp.full((nx, ny), 200.0)              # [W/m^2]
    38	    # Reference layer thicknesses (uniform).
    39	    dz_ref = jnp.full((nlev,), H / nlev)
    40	    # Reference half-level depths: 0 at surface, -H at bottom.
    41	    z_half_ref = -jnp.linspace(0.0, H, nlev + 1)
    42	    jacobian = jnp.ones((nx, ny))                    # eta=0, J=1
    43	    return sw_down, dz_ref, z_half_ref, jacobian
    44	
    45	
    46	def test_jerlov_params_namedtuple():
    47	    p = JerlovParams(R=0.6, zeta1=0.5, zeta2=15.0)
    48	    assert p.R == 0.6
    49	    assert p.zeta1 == 0.5
    50	    assert p.zeta2 == 15.0
    51	
    52	
    53	def test_jerlov_lookup_table():
    54	    for water_type in ("I", "IA", "IB", "II", "III"):
    55	        params = JERLOV_TYPES[water_type]
    56	        assert 0.0 < params.R < 1.0
    57	        assert params.zeta1 > 0.0
    58	        assert params.zeta2 > params.zeta1  # long band penetrates deeper
    59	
