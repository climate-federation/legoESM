import jax, jax.numpy as jnp
from legoesm.ocean.physics.lateral_mixing._gm_redi_common import compute_visbeck_kappa_gm
from legoesm.ocean.physics.lateral_mixing.config import VisbeckConfig
from legoesm.ocean.vertical import create_ocean_z_star
z=create_ocean_z_star(n_levels=3,H_max=30.0)
J=jnp.ones((1,)); f=jnp.ones((1,))*1e-4; Sx=jnp.ones((1,2))*1e-3; Sy=jnp.zeros((1,2))
rho=jnp.array([[1027.0,1026.0,1025.0]])
for kmin in [0.0, 100.0]:
    cfg=VisbeckConfig(enabled=True,kappa_min=kmin,kappa_max=1e9,use_rossby_radius=False,L_fixed=1e5)
    def loss(r): return jnp.sum(compute_visbeck_kappa_gm(r,Sx,Sy,z,J,f,cfg))
    g=jax.grad(loss)(rho)
    print('kmin', kmin, 'loss', loss(rho), 'finite', jnp.all(jnp.isfinite(g)), g)
