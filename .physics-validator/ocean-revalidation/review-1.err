     1	"""Direct unit tests for the entraining mass-flux plume convection scheme.
     2	
     3	Covers the leaf module ``legoesm.ocean.physics.convection.plume`` rather than
     4	the integration factory.  Specifically guards the entrainment formulation
     5	``entrain = 1 - exp(-epsilon * dz)`` against regressions back to the linear
     6	``entrain = epsilon * dz`` form, which can exceed unity for thick layers
     7	and produce an unphysical sign-flip on the plume properties.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import jax
    13	import jax.numpy as jnp
    14	import pytest
    15	
    16	from legoesm.ocean.physics.convection.config import PlumeConfig
    17	from legoesm.ocean.physics.convection.plume import plume_convection
    18	from legoesm.ocean.vertical import create_ocean_z_star
    19	
    20	
    21	def _build_state(n_levels: int = 8, H_max: float = 4000.0,
    22	                 surface_unstable: bool = True):
    23	    """Tiny synthetic 6-face cubed-sphere column at realistic magnitudes."""
    24	    z = create_ocean_z_star(n_levels=n_levels, H_max=H_max)
    25	    shape = (6, 4, 4, n_levels)
    26	
    27	    # Linear T profile from 18 °C at surface to 2 °C at depth.
    28	    T_profile = jnp.linspace(18.0, 2.0, n_levels)
    29	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
    30	    if surface_unstable:
    31	        # Cold dense water on top → plume should descend.
    32	        T = T.at[..., 0].set(1.0)
    33	
    34	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
    35	
    36	    # Crude linear-EOS density consistent with T (alpha ~2e-4):
    37	    rho = 1025.0 - 0.2 * (T - 4.0)
    38	    p = jnp.cumsum(
    39	        jnp.broadcast_to(jnp.linspace(0.0, 4.0e7, n_levels), shape),
    40	        axis=-1,
    41	    )
    42	    J = jnp.ones((6, 4, 4), dtype=jnp.float64)
    43	    return T, S, rho, p, z, J
    44	
    45	
    46	def test_plume_outputs_finite_and_signs_consistent():
    47	    """Surface-unstable column: tendencies are finite and surface row is zero."""
    48	    T, S, rho, p, z, J = _build_state(surface_unstable=True)
    49	    cfg = PlumeConfig()
    50	
    51	    out = plume_convection(T, S, rho, p, z, J, cfg)
    52	
    53	    assert jnp.all(jnp.isfinite(out.dT_dt))
    54	    assert jnp.all(jnp.isfinite(out.dS_dt))
    55	    assert jnp.all(jnp.isfinite(out.convection_flag))
    56	
    57	    # Surface level is the plume launch — no detrainment tendency there.
    58	    assert float(jnp.max(jnp.abs(out.dT_dt[..., 0]))) == 0.0
    59	    assert float(jnp.max(jnp.abs(out.dS_dt[..., 0]))) == 0.0
    60	
    61	    # Convection flag is in [0, 1].
    62	    flag_min = float(jnp.min(out.convection_flag))
    63	    flag_max = float(jnp.max(out.convection_flag))
    64	    assert 0.0 <= flag_min <= 1.0
    65	    assert 0.0 <= flag_max <= 1.0
    66	
    67	
    68	def test_plume_zero_when_stable():
    69	    """Stably stratified column: plume should not be active."""
    70	    T, S, rho, p, z, J = _build_state(surface_unstable=False)
    71	    cfg = PlumeConfig()
    72	
    73	    out = plume_convection(T, S, rho, p, z, J, cfg)
    74	
    75	    # No surface instability → plume inactive everywhere.
    76	    assert float(jnp.max(jnp.abs(out.dT_dt))) == 0.0
    77	    assert float(jnp.max(jnp.abs(out.dS_dt))) == 0.0
    78	    assert float(jnp.max(out.convection_flag)) == 0.0
    79	
    80	
    81	def test_plume_entrainment_uses_exact_not_linear_form():
    82	    """Sharp regression guard: ``-expm1(-eps*dz)`` vs ``eps*dz``.
    83	
    84	    For a cold dense surface (5 °C) above a warm sub-surface (20 °C) with
    85	    ``eps=1e-3`` and a layer thickness ``dz_1 ≈ 1048 m`` (so ``eps*dz_1
    86	    ≈ 1.05``), the two entrainment formulas produce **opposite signs** for
    87	    the detrainment tendency at the first descent step:
    88	
    89	    * Exact form: ``T_plume`` after entrainment ≈ 14.8 °C (cooler than
    90	      ``T_env=20``), so ``dT_dt[k=1] ≈ -5.2e-4 K/s`` (env cools toward
    91	      plume).
    92	    * Linear form: ``(1 - eps*dz)`` is ``-0.05`` so the plume's prior
    93	      temperature is *subtracted*, giving ``T_plume ≈ 20.7`` (slightly
    94	      *warmer* than env), and ``dT_dt[k=1] ≈ +7.1e-5 K/s`` (wrong sign).
    95	
    96	    Asserting ``dT_dt[..., 1] < 0`` distinguishes the two; the magnitude
    97	    bound rules out trivial near-zero passes.
    98	    """
    99	    nlev = 4
   100	    H_max = 6000.0  # → dz_ref[1] ≈ 1048 m, so eps*dz_1 ≈ 1.05 with eps=1e-3
   101	    z = create_ocean_z_star(n_levels=nlev, H_max=H_max)
   102	    shape = (6, 2, 2, nlev)
   103	
   104	    # Cold dense surface above warmer sub-surface.  Surface is unstable
   105	    # (rho_0 > rho_1) so the plume launches.  Sub-surface is sufficiently
   106	    # warmer that entrainment of T_env strongly heats the plume — but
   107	    # under the exact form the plume stays cooler than env.
   108	    T_profile = jnp.array([5.0, 20.0, 18.0, 16.0])
   109	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
   110	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
   111	    rho = 1025.0 - 0.2 * (T - 4.0)
   112	    p = jnp.cumsum(
   113	        jnp.broadcast_to(jnp.linspace(0.0, 6.0e7, nlev), shape), axis=-1,
   114	    )
   115	    J = jnp.ones((6, 2, 2), dtype=jnp.float64)
   116	
   117	    cfg = PlumeConfig(epsilon=1e-3)
   118	    out = plume_convection(T, S, rho, p, z, J, cfg)
   119	
   120	    # Bounded: tendencies are finite even though eps*dz_1 > 1 — the linear
   121	    # form would also produce finite (but sign-flipped) values, so this is
   122	    # a sanity floor, not a discriminator.
   123	    assert jnp.all(jnp.isfinite(out.dT_dt))
   124	    assert jnp.all(jnp.isfinite(out.dS_dt))
   125	
   126	    # Sharp discriminator: at the first descent step (level k=1) the plume
   127	    # is cooler than the environment under the exact form; the linear
   128	    # form's sign-flip makes the plume artificially *warmer* than env.
   129	    dT_at_first_step = float(out.dT_dt[..., 1].mean())
   130	    assert dT_at_first_step < -1e-4, (
   131	        f"dT_dt at first descent step is {dT_at_first_step:.3e}; expected "
   132	        "a clearly negative value (~ -5e-4) under the exact "
   133	        "1 - exp(-eps*dz) entrainment.  A positive or near-zero value "
   134	        "indicates regression to the linear ``eps*dz`` form."
   135	    )
   136	    assert dT_at_first_step > -1e-2, (
   137	        f"dT_dt at first descent step is {dT_at_first_step:.3e}; "
   138	        "magnitude is unphysically large for cfg.alpha_plume=0.1, "
   139	        "eps=1e-3, |T_plume - T_env| ~ 5 K."
   140	    )
   141	
   142	
   143	def test_plume_gradient_flows():
   144	    """``jax.grad`` through plume_convection produces finite, nonzero grads."""
   145	    T, S, rho, p, z, J = _build_state(surface_unstable=True)
   146	    cfg = PlumeConfig()
   147	
   148	    def loss(T_in):
   149	        out = plume_convection(T_in, S, rho, p, z, J, cfg)
   150	        return jnp.sum(out.dT_dt ** 2)
   151	
   152	    g = jax.grad(loss)(T)
   153	    assert jnp.all(jnp.isfinite(g))
   154	    # At least some sensitivity below the surface — surface row may be zero
   155	    # but k>0 levels should respond to environmental T perturbations.
   156	    assert float(jnp.max(jnp.abs(g[..., 1:]))) > 0.0
   157	
   158	
   159	@pytest.mark.parametrize("eps", [1e-4, 1e-3, 5e-3])
   160	def test_plume_finite_across_eps_regimes(eps):
   161	    """Sanity floor: tendencies are finite across a span of ``eps*dz``.
   162	
   163	    This is a *finiteness* check across entrainment regimes (``eps*dz``
   164	    ranging from ~0.025 to ~1.25 with the chosen layering), not a
   165	    correctness check on the entrainment form itself — the linear form
   166	    also produces finite (but sign-flipped) values.  The actual form
   167	    discrimination lives in
   168	    ``test_plume_entrainment_uses_exact_not_linear_form``.
   169	    """
   170	    nlev = 6
   171	    H_max = 1500.0  # dz_ref ~ 250 m → eps*dz spans 0.025 to 1.25
   172	    z = create_ocean_z_star(n_levels=nlev, H_max=H_max)
   173	    shape = (6, 2, 2, nlev)
   174	    T_profile = jnp.linspace(18.0, 2.0, nlev)
   175	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
   176	    T = T.at[..., 0].set(1.0)
   177	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
   178	    rho = 1025.0 - 0.2 * (T - 4.0)
   179	    p = jnp.cumsum(
   180	        jnp.broadcast_to(jnp.linspace(0.0, 1.5e7, nlev), shape), axis=-1,
   181	    )
   182	    J = jnp.ones((6, 2, 2), dtype=jnp.float64)
   183	
   184	    cfg = PlumeConfig(epsilon=eps)
   185	    out = plume_convection(T, S, rho, p, z, J, cfg)
   186	
   187	    assert jnp.all(jnp.isfinite(out.dT_dt))
   188	    assert jnp.all(jnp.isfinite(out.dS_dt))
