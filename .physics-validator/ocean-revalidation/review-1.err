   290	
   291	def simple_bulk_fluxes(
   292	    u_lowest: jnp.ndarray,
   293	    v_lowest: jnp.ndarray,
   294	    T_lowest: jnp.ndarray,
   295	    q_lowest: jnp.ndarray,
   296	    T_sfc: jnp.ndarray,
   297	    q_sfc: jnp.ndarray,
   298	    rho: jnp.ndarray,
   299	    wind_speed: jnp.ndarray,
   300	    Cd: float,
   301	    Ch: float,
   302	    L_latent: float | None = None,
   303	) -> tuple[jnp.ndarray, jnp.ndarray, jnp.ndarray, jnp.ndarray]:
   304	    """Simple bulk-aerodynamic surface fluxes with constant coefficients.
   305	
   306	    Parameters
   307	    ----------
   308	    u_lowest, v_lowest : array
   309	        Lowest-level wind components [m/s].
   310	    T_lowest : array
   311	        Lowest-level air temperature [K].
   312	    q_lowest : array
   313	        Lowest-level specific humidity [kg/kg].
   314	    T_sfc : array
   315	        Surface temperature [K].
   316	    q_sfc : array
   317	        Surface specific humidity [kg/kg].
   318	    rho : array
   319	        Air density at lowest level [kg/m3].
   320	    wind_speed : array
   321	        Wind speed (with minimum floor applied) [m/s].
   322	    Cd : float
   323	        Drag coefficient for momentum.
   324	    Ch : float
   325	        Transfer coefficient for heat and moisture.
   326	
   327	    Returns
   328	    -------
   329	    tau_x, tau_y : array
   330	        Surface stress [Pa] (opposes wind).
   331	    shflx : array
   332	        Sensible heat flux [W/m2] (positive upward = surface warmer).
   333	    lhflx : array
   334	        Latent heat flux [W/m2] (positive upward = surface moister).
   335	    """
   336	    _L = constants.L_v if L_latent is None else L_latent
   337	    tau_x = -rho * Cd * wind_speed * u_lowest
   338	    tau_y = -rho * Cd * wind_speed * v_lowest
   339	    shflx = rho * constants.c_pd * Ch * wind_speed * (T_sfc - T_lowest)
   340	    lhflx = rho * _L * Ch * wind_speed * (q_sfc - q_lowest)
   341	    return tau_x, tau_y, shflx, lhflx

