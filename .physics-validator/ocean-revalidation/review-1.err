   654	        from legoesm.grids.cubed_sphere import create_cubed_sphere
   655	
   656	        # Build minimal cubed-sphere ocean state with strong surface freshening.
   657	        n, nlev = 4, 6
   658	        grid = create_cubed_sphere(n=n)
   659	        z_coord = create_ocean_z_star(n_levels=nlev, H_max=2000.0)
   660	        shape = (6, n, n, nlev)
   661	        shape_2d = (6, n, n)
   662	
   663	        # Mildly stable column (T decreasing with depth, near-zero density gradient
   664	        # so the surface buoyancy flux dominates h_bl).
   665	        T_data = jnp.broadcast_to(
   666	            jnp.linspace(15.0, 5.0, nlev)[None, None, None, :], shape,
   667	        ).astype(jnp.float64)
   668	        S_data = jnp.full(shape, 35.0, dtype=jnp.float64)
   669	        u_data = jnp.zeros(shape, dtype=jnp.float64)
   670	        v_data = jnp.zeros(shape, dtype=jnp.float64)
   671	        eta_data = jnp.zeros(shape_2d, dtype=jnp.float64)
   672	        H_bathy_data = jnp.full(shape_2d, 2000.0, dtype=jnp.float64)
   673	        land_mask = jnp.ones(shape_2d, dtype=jnp.float64)
   674	
   675	        from legoesm.ocean.state import OceanState
   676	        state = OceanState(
   677	            u=Field(data=u_data),
   678	            v=Field(data=v_data),
   679	            T=Field(data=T_data),
   680	            S=Field(data=S_data),
   681	            eta=Field(data=eta_data),
   682	            H_bathy=Field(data=H_bathy_data),
   683	            land_mask=Field(data=land_mask),
   684	        )
   685	
   686	        # Strong freshening: P >> E.
   687	        fw_freshening = jnp.full(shape_2d, 5e-4, dtype=jnp.float64)  # kg/m^2/s
   688	        # Strong brine rejection: -P + E >> 0 (e.g. sea-ice formation).
   689	        fw_brine = jnp.full(shape_2d, -5e-4, dtype=jnp.float64)
   690	        # Zero net heat flux so freshwater is the only buoyancy driver.
   691	        zero_2d = jnp.zeros(shape_2d, dtype=jnp.float64)
   692	
   693	        cfg = VerticalMixingConfig(scheme="kpp", kpp=KPPConfig())
   694	        physics_fn = make_vertical_mixing_physics(cfg)
   695	
   696	        # Pure freshening: K_v should pick up the BACKGROUND value (B_f<0,
   697	        # h_bl <= 1 layer) rather than an enhanced convective profile.
   698	        sf_fresh = OceanSurfaceForcing(
   699	            tau_x=zero_2d, tau_y=zero_2d, q_net=zero_2d, freshwater=fw_freshening,
   700	        )
   701	        out_fresh = physics_fn(state, grid, z_coord, surface_forcing=sf_fresh)
   702	
   703	        # Pure brine rejection: K_v should be larger because B_f > 0
   704	        # destabilizes the column → deeper BL → enhanced K_v.
   705	        sf_brine = OceanSurfaceForcing(
