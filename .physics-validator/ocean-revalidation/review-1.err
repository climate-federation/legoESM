     1	"""Quadratic bottom drag: tau = -C_d * |u| * u."""
     2	
     3	from __future__ import annotations
     4	
     5	import jax.numpy as jnp
     6	
     7	from legoesm.ocean.physics.bottom_drag.config import QuadraticDragConfig
     8	from legoesm.ocean.physics.bottom_drag.output import BottomDragOutput
     9	from legoesm.ocean.vertical import OceanZStarCoordinate
    10	
    11	_EPS = float(jnp.finfo(jnp.float32).eps)  # Float32 machine epsilon (~1.19e-7)
    12	
    13	
    14	def quadratic_bottom_drag(
    15	    u: jnp.ndarray,
    16	    v: jnp.ndarray,
    17	    z_coord: OceanZStarCoordinate,
    18	    jacobian: jnp.ndarray,
    19	    cfg: QuadraticDragConfig,
    20	) -> BottomDragOutput:
    21	    """Apply quadratic bottom drag at the deepest level.
    22	
    23	    Parameters
    24	    ----------
    25	    u, v : array (6, n, n, nlev)
    26	    z_coord : OceanZStarCoordinate
    27	    jacobian : array (6, n, n)
    28	    cfg : QuadraticDragConfig
    29	
    30	    Returns
    31	    -------
    32	    BottomDragOutput
    33	    """
    34	    eps = _EPS
    35	
    36	    # Bottom layer thickness
    37	    dz_bottom = z_coord.dz_ref[-1] * jacobian  # (6, n, n)
    38	
    39	    # Speed at bottom level
    40	    u_bot = u[..., -1]
    41	    v_bot = v[..., -1]
    42	    speed = jnp.sqrt(u_bot**2 + v_bot**2 + eps)
    43	
    44	    # Drag: -C_d * |u| * u / dz_bottom
    45	    inv_dz = 1.0 / jnp.maximum(dz_bottom, eps)
    46	    drag_u = -cfg.C_d * speed * u_bot * inv_dz
    47	    drag_v = -cfg.C_d * speed * v_bot * inv_dz
    48	
    49	    # Pad with zero on top instead of allocating ``zeros_like`` and
    50	    # scattering only the bottom row.  Single Pad HLO op vs alloc +
    51	    # dynamic_update_slice.  The bottom row is ``drag_u``/``drag_v``;
    52	    # the top ``nlev-1`` rows are zero by construction.
    53	    nlev = u.shape[-1]
    54	    pad_axes = ((0, 0),) * (drag_u.ndim)
    55	    du_dt = jnp.pad(drag_u[..., None], (*pad_axes, (nlev - 1, 0)))
    56	    dv_dt = jnp.pad(drag_v[..., None], (*pad_axes, (nlev - 1, 0)))
    57	
    58	    return BottomDragOutput(du_dt=du_dt, dv_dt=dv_dt)

