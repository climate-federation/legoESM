     1	"""Grid-agnostic helpers shared by barotropic_*.py substep solvers.
     2	
     3	Factors small repeated patterns out of the four grid-specific
     4	barotropic solvers (cubed-sphere A-grid, cubed-sphere C-grid, lat-lon
     5	C-grid, MPAS).  Closes #214 (Phase 2).
     6	
     7	The helpers are intentionally thin: each replaces a few lines that were
     8	character-for-character identical across solvers, so future updates to
     9	the BEBT scheme, the cosine time filter, or MAXVEL clipping touch one
    10	file instead of three.
    11	
    12	This module performs no halo exchange and does not depend on any
    13	grid-specific operator package.  Callers are responsible for staging
    14	field shapes correctly before invoking these helpers.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	from typing import Tuple
    20	
    21	import jax.numpy as jnp
    22	
    23	
    24	def compute_filter_weights(
    25	    n_substeps: int,
    26	    dtype: jnp.dtype,
    27	    *,
    28	    use_cosine: bool,
    29	) -> Tuple[jnp.ndarray, jnp.ndarray]:
    30	    """Return per-substep accumulator weights for time-averaging.
    31	
    32	    The cosine bell (Hanning window) suppresses the side lobes of the
    33	    plain box filter that alias barotropic modes into the baroclinic
    34	    coupling.  Both the lat-lon C-grid and MPAS solvers compute the
    35	    weights with the same formula:
    36	
    37	        w_i = 1 + cos(2π · (i - n/2) / n)         (cosine)
    38	        w_i = 1                                   (box)
    39	
    40	    Parameters
    41	    ----------
    42	    n_substeps : int
    43	        Number of barotropic substeps.
    44	    dtype : jnp.dtype
    45	        Working precision for the weight array.
    46	    use_cosine : bool
    47	        ``config.barotropic_time_filter == "cosine"``.
    48	
    49	    Returns
    50	    -------
    51	    w_filter : jax.Array, shape (n_substeps,)
    52	        Per-substep weight passed as ``xs`` to ``lax.scan`` (or
    53	        indexed inside ``fori_loop``).
    54	    w_total : jax.Array, scalar
    55	        ``sum(w_filter)`` — used to normalise the eta / velocity
    56	        accumulators.  Transport accumulators (``Hu``) keep using
    57	        ``n_substeps`` for exact volume conservation.
    58	    """
    59	    i = jnp.arange(n_substeps, dtype=dtype)
    60	    if use_cosine:
    61	        # Hanning-window weights.  At ``n_substeps == 1`` (rare, only
    62	        # used by tests / 1-substep spin-ups) the formula
    63	        # ``1 + cos(2 pi (0 - 0.5)/1) = 1 + cos(-pi) = 0`` collapses to
    64	        # zero, which then divides by zero in
    65	        # ``eta_sum / w_total`` downstream.  Fall back to the box
    66	        # filter when the cosine bell would degenerate (codex
    67	        # adversarial review iter-1, bug #4).
    68	        if n_substeps < 2:
    69	            w_filter = jnp.ones(n_substeps, dtype=dtype)
    70	        else:
    71	            w_filter = 1.0 + jnp.cos(
    72	                2.0 * jnp.pi * (i - 0.5 * n_substeps) / n_substeps,
    73	            )
    74	    else:
    75	        w_filter = jnp.ones(n_substeps, dtype=dtype)
    76	    return w_filter, jnp.sum(w_filter)
    77	
    78	
    79	def bebt_blend(
    80	    eta_new: jnp.ndarray,
    81	    eta_old: jnp.ndarray,
    82	    bebt: float | jnp.ndarray,
    83	) -> jnp.ndarray:
    84	    """Backward-Euler/Backward-time blend of new and old eta for the PGF.
    85	
    86	    ``bebt = 0`` recovers the standard forward-backward scheme; the
    87	    MOM6 default ``bebt = 0.2`` introduces semi-implicit damping of
    88	    the fastest barotropic gravity waves (#205).
    89	    """
    90	    return (1.0 - bebt) * eta_new + bebt * eta_old
    91	
    92	
    93	def maxvel_clip(field: jnp.ndarray, maxvel: float | jnp.ndarray) -> jnp.ndarray:
    94	    """Symmetric clip of barotropic velocity components.
    95	
    96	    Used to suppress runaway velocities at single grid points that
    97	    would otherwise crash the solver before the substep finishes.
    98	    """
    99	    return jnp.clip(field, -maxvel, maxvel)

