     1	"""MPAS-specific ocean physics: surface forcing and bottom drag.
     2	
     3	MPAS uses edge-normal velocity on a TRiSK C-grid, so cell-centered
     4	wind stress (tau_x, tau_y) must be projected onto edge normals.  This
     5	module mirrors the ``make_ocean_physics`` pipeline but returns
     6	``MPASOceanTendencies`` compatible with the MPAS tendency function.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	from typing import Callable
    12	
    13	import jax.numpy as jnp
    14	
    15	from legoesm.core.field import Field
    16	from legoesm.core.state import MPASOceanState, MPASOceanTendencies
    17	from legoesm.grids.voronoi import VoronoiMesh
    18	from legoesm.ocean.eos import rho_0 as rho_0_ref
    19	from legoesm.ocean.vertical import OceanZStarCoordinate, compute_ocean_jacobian
    20	
    21	
    22	def make_mpas_ocean_physics(config) -> Callable:
    23	    """Build a combined physics function for MPAS ocean.
    24	
    25	    Parameters
    26	    ----------
    27	    config : OceanPhysicsConfig
    28	
    29	    Returns
    30	    -------
    31	    Callable
    32	        ``physics_fn(state, mesh, z_coord, surface_forcing=None)``
    33	        returning ``MPASOceanTendencies``.
    34	    """
    35	    from legoesm.ocean.physics.surface_forcing.config import SurfaceForcingConfig
    36	    from legoesm.ocean.physics.bottom_drag.config import BottomDragConfig
    37	
    38	    sf_config = config.surface_forcing
    39	    bd_config = config.bottom_drag
    40	
    41	    # Warn about unsupported physics schemes that would be silently ignored.
    42	    # ``convection`` is handled explicitly below (supports "enhanced_diffusion").
    43	    import warnings
    44	    _unsupported = []
    45	    for attr in ("vertical_mixing", "lateral_mixing", "shortwave_penetration"):
    46	        sub = getattr(config, attr, None)
    47	        if sub is not None and getattr(sub, "scheme", "none") != "none":
    48	            _unsupported.append(f"{attr}={getattr(sub, 'scheme', '?')!r}")
    49	    if _unsupported:
    50	        warnings.warn(
    51	            f"MPAS ocean physics: ignoring unsupported schemes: "
    52	            + ", ".join(_unsupported),
    53	            RuntimeWarning,
    54	            stacklevel=2,
    55	        )
    56	
    57	    sf_scheme = (sf_config.scheme
    58	                 if isinstance(sf_config, SurfaceForcingConfig)
    59	                 else "none")
    60	    # Bail loudly on schemes the MPAS factory does not implement, rather
    61	    # than silently producing zero tendencies.
    62	    _supported_sf = ("none", "prescribed", "restoring", "combined")
    63	    if sf_scheme not in _supported_sf:
    64	        raise NotImplementedError(
    65	            f"MPAS ocean physics does not support surface_forcing scheme "
    66	            f"{sf_scheme!r}. Supported: {_supported_sf}."
    67	        )
    68	    apply_wind_block = sf_scheme in ("prescribed", "combined")
    69	    apply_restoring = sf_scheme in ("restoring", "combined")
    70	
    71	    conv_config = getattr(config, "convection", None)
    72	    conv_scheme = (conv_config.scheme
    73	                   if conv_config is not None else "none")
    74	    _supported_conv = ("none", "enhanced_diffusion")
    75	    if conv_scheme not in _supported_conv:
    76	        raise NotImplementedError(
    77	            f"MPAS ocean physics does not support convection scheme "
    78	            f"{conv_scheme!r}. Supported: {_supported_conv}."
    79	        )
    80	    apply_convection = conv_scheme == "enhanced_diffusion"
    81	
    82	    # Physics-level bottom drag is deprecated — use the dynamics-level
    83	    # ``bottom_drag_r`` field on ``MPASOceanConfig`` instead.  The
    84	    # dynamics path applies drag in both the baroclinic PE and the
    85	    # barotropic substeps, which is physically correct (MOM6 convention).
    86	    if (isinstance(bd_config, BottomDragConfig)
    87	            and bd_config.scheme != "none"):
    88	        raise ValueError(
    89	            f"Physics-level bottom drag (scheme={bd_config.scheme!r}) is "
    90	            "deprecated. Use MPASOceanConfig(bottom_drag_r=...) instead, "
    91	            "which applies drag in both the baroclinic PE and the "
    92	            "barotropic substeps (matching MOM6). Set "
    93	            "BottomDragConfig(scheme='none') in your OceanPhysicsConfig."
    94	        )
    95	
    96	    def physics_fn(
    97	        state: MPASOceanState,
    98	        mesh: VoronoiMesh,
    99	        z_coord: OceanZStarCoordinate,
   100	        surface_forcing=None,
   101	    ) -> MPASOceanTendencies:
   102	        u_3d = state.u.data        # (nEdges, nlev)
   103	        T_3d = state.T.data        # (nCells, nlev)
   104	        eta = state.eta.data        # (nCells,)
   105	        H_bathy = state.H_bathy.data
   106	        mask = state.land_mask.data  # (nCells,)
   107	        dtype = u_3d.dtype
   108	
   109	        du_dt = jnp.zeros_like(u_3d)
   110	        dT_dt = jnp.zeros_like(T_3d)
   111	        dS_dt = jnp.zeros_like(T_3d)
   112	        deta_dt = jnp.zeros_like(eta)
   113	
   114	        # Jacobian — needed by surface forcing (top-layer thickness) and
   115	        # bottom drag (bottom-layer thickness).  Compute once.
   116	        jacobian = compute_ocean_jacobian(eta, H_bathy, z_coord)
   117	        c1 = mesh.cellsOnEdge[0]  # (nEdges,)
   118	        c2 = mesh.cellsOnEdge[1]  # (nEdges,)
   119	
   120	        # --- Prescribed wind / Q_net / E-P (also reused under "combined") ---
   121	        if apply_wind_block:
   122	            cfg = sf_config.prescribed
   123	
   124	            dz_0_cell = z_coord.dz_ref[0] * jacobian  # (nCells,)
   125	
   126	            # Compute cell-centered wind stress from latitude
   127	            from legoesm.ocean.physics.surface_forcing.wind_profiles import compute_wind_stress
   128	            tau_x, tau_y = compute_wind_stress(mesh.grid_lat, cfg)
   129	
   130	            # Project cell-centered wind stress onto edge normals.
   131	            # Average tau from the two cells sharing each edge, then dot
   132	            # with the edge-normal direction (angleEdge).
   133	            tau_x_e = 0.5 * (tau_x[c1] + tau_x[c2])
   134	            tau_y_e = 0.5 * (tau_y[c1] + tau_y[c2])
   135	            tau_n = (tau_x_e * jnp.cos(mesh.angleEdge)
   136	                     + tau_y_e * jnp.sin(mesh.angleEdge))
   137	
   138	            # Edge top-layer thickness
   139	            dz_0_e = 0.5 * (dz_0_cell[c1] + dz_0_cell[c2])
   140	            inv_rho_dz_e = 1.0 / (rho_0_ref * jnp.maximum(dz_0_e, 1e-10))
   141	
   142	            # Apply wind stress to top layer only
   143	            du_dt = du_dt.at[:, 0].add(tau_n * inv_rho_dz_e)
   144	
   145	            # Heat flux: dT/dt = Q_net / (rho_0 * c_sw * dz_0)
   146	            if cfg.Q_net != 0.0:
   147	                from legoesm.ocean.eos import c_sw
   148	                inv_rho_csw_dz = 1.0 / (
   149	                    rho_0_ref * c_sw * jnp.maximum(dz_0_cell, 1e-10))
   150	                dT_dt = dT_dt.at[:, 0].add(cfg.Q_net * inv_rho_csw_dz * mask)
   151	
   152	            # E-P virtual salt flux
   153	            if cfg.E_minus_P != 0.0:
   154	                inv_dz = 1.0 / jnp.maximum(dz_0_cell, 1e-10)
   155	                dS_dt = dS_dt.at[:, 0].add(
   156	                    state.S.data[:, 0] * cfg.E_minus_P * inv_dz * mask)
   157	
   158	        # --- T/S restoring (under "restoring" or "combined") ---
   159	        if apply_restoring:
   160	            from legoesm.ocean.physics.surface_forcing.restoring import (
   161	                restoring_surface_forcing,
   162	            )
   163	            cfg_r = sf_config.restoring
   164	            r_out = restoring_surface_forcing(
   165	                state.T.data, state.S.data, mesh, cfg_r,
   166	            )
   167	            # restoring_surface_forcing does not mask land; do it here so
   168	            # land-cell tracer values are not driven by the restoring term.
   169	            dT_dt = dT_dt + r_out.dT_dt * mask[:, None]
   170	            dS_dt = dS_dt + r_out.dS_dt * mask[:, None]
   171	
   172	        # --- Convective adjustment (enhanced diffusion where N²<0) ---
   173	        if apply_convection:
   174	            from legoesm.ocean.physics.convection.enhanced_diffusion import (
   175	                enhanced_diffusion_convection,
   176	            )
   177	            from legoesm.ocean.eos import compute_ocean_rho
   178	            cfg_c = conv_config.enhanced_diffusion
   179	            # Match the lat-lon convection integration: use the default
   180	            # (Wright) EOS for the ρ used in the static-stability check,
   181	            # even when the dycore is configured with linear EOS.  This
   182	            # is a known approximation — the EOS choice only affects the
   183	            # static-stability ranking, not the dycore tendencies.
   184	            rho = compute_ocean_rho(state, z_coord, jacobian)
   185	            c_out = enhanced_diffusion_convection(
   186	                state.T.data, state.S.data, rho, z_coord, jacobian, cfg_c,
   187	            )
   188	            dT_dt = dT_dt + c_out.dT_dt * mask[:, None]
   189	            dS_dt = dS_dt + c_out.dS_dt * mask[:, None]
   190	
   191	        return MPASOceanTendencies(
   192	            du_dt=Field(data=du_dt, name="du_dt",
   193	                        dims=("nEdges", "nlev"), units="m/s²"),
   194	            dT_dt=Field(data=dT_dt, name="dT_dt",
   195	                        dims=("nCells", "nlev"), units="degC/s"),
   196	            dS_dt=Field(data=dS_dt, name="dS_dt",
   197	                        dims=("nCells", "nlev"), units="PSU/s"),
   198	            deta_dt=Field(data=deta_dt, name="deta_dt",
   199	                          dims=("nCells",), units="m/s"),
   200	        )
   201	
   202	    return physics_fn

