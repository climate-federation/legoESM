   236	    def test_nbar_uses_arithmetic_mean(self):
   237	        """With a depth-varying N, κ uses ⟨N⟩ (not ``sqrt(⟨N²⟩)``).
   238	
   239	        Construct a density field whose N² is strongly concentrated near
   240	        the surface (factor-of-10 between top and bottom interfaces).
   241	        The correct Rossby-radius length uses ``⟨N⟩``; the buggy form
   242	        ``sqrt(⟨N²⟩)`` is strictly larger and would inflate κ.
   243	        """
