     1	"""Configuration for ocean lateral mixing schemes."""
     2	
     3	from __future__ import annotations
     4	
     5	from typing import NamedTuple
     6	
     7	
     8	class HarmonicConfig(NamedTuple):
     9	    """Laplacian (harmonic) lateral mixing."""
    10	    A_h: float = 1e4   # Horizontal viscosity [m^2/s]
    11	    K_h: float = 1e3   # Horizontal tracer diffusivity [m^2/s]
    12	
    13	
    14	class BiharmonicConfig(NamedTuple):
    15	    """Biharmonic lateral mixing."""
    16	    B_h_momentum: float = 0.0   # Biharmonic viscosity [m^4/s]
    17	    B_h_tracer: float = 0.0     # Biharmonic tracer diffusivity [m^4/s]
    18	
    19	
    20	class VisbeckConfig(NamedTuple):
    21	    """Adaptive GM coefficient following Visbeck, Marshall, Haine & Spall 1997.
    22	
    23	    Replaces the constant ``kappa_GM`` with a flow-dependent, horizontally
    24	    varying coefficient
    25	
    26	        κ_Visbeck(x, y) = α · L² · ⟨N · |S|⟩_z
    27	
    28	    where ``α`` is a dimensionless tunable coefficient (Visbeck 97 suggest
    29	    ~0.015; MOM6 uses values between 0.005 and 0.1), ``L`` is a mixing
    30	    length — either a fixed width of the baroclinic zone or the local
    31	    first-baroclinic Rossby radius ``N̄·H/|f|`` — and
    32	    ``⟨N·|S|⟩_z`` is a depth-average of the local Eady-like growth rate
    33	    at isopycnal interfaces.  The final coefficient is clamped to
    34	    [``kappa_min``, ``kappa_max``] for numerical safety.
    35	
    36	    Using ``N·|S|`` as the growth rate follows from the Eady relation
    37	    ``σ = 0.31·|f|/√Ri`` combined with the thermal-wind identity
    38	    ``Ri = f² / (N²·|S|²)``, which gives ``σ ≈ 0.31·N·|S|``; the 0.31
    39	    factor is absorbed into the tunable ``α``.
    40	    """
    41	    enabled: bool = False
    42	    alpha: float = 0.015
    43	    L_fixed: float = 1.0e5               # Fixed mixing length [m]
    44	    use_rossby_radius: bool = True
    45	    L_min: float = 5.0e3                 # Length-scale floor [m]
    46	    L_max: float = 2.0e5                 # Length-scale ceiling [m]
    47	    kappa_min: float = 1.0e2             # κ floor [m²/s]
    48	    kappa_max: float = 4.0e3             # κ ceiling [m²/s]
    49	    f_min: float = 1.0e-6                # |f| floor for Rossby-radius denom
    50	
    51	
    52	class GMRediConfig(NamedTuple):
    53	    """Gent-McWilliams / Redi isopycnal mixing (small-slope formulation).
    54	
    55	    Implements the Griffies (1998) skew-flux form for GM and the full
    56	    Redi isopycnal diffusion tensor with DM95 slope tapering.
    57	
    58	    When kappa_GM == kappa_Redi (default), the horizontal off-diagonal
    59	    terms cancel and the scheme reduces to horizontal diffusion plus
    60	    an enhanced vertical mixing term proportional to S^2.
    61	
    62	    When ``visbeck.enabled = True`` the scalar ``kappa_GM`` is replaced
    63	    by a flow-dependent field computed from the local slope and
    64	    stratification (Visbeck et al. 1997).  ``kappa_Redi`` still
    65	    controls the isopycnal diffusivity.
    66	
    67	    ``slope_scheme`` selects the discretisation used to build the
    68	    isopycnal-tensor fluxes (lat-lon C-grid only — the cubed-sphere
    69	    implementation always uses centered):
    70	
    71	    - ``"triads"`` (default) — Griffies, Gnanadesikan, Pacanowski et
    72	      al. (1998) triad decomposition.  Each flux is built from four
    73	      quarter-cell triads that use the SAME three density / tracer
    74	      values for both slope and gradient, guaranteeing that the Redi
    75	      flux vanishes exactly for tracers constant along isopycnals
    76	      (e.g. T with a linear EOS).  Required for century-scale climate
    77	      runs and the recommended default for all production work.
    78	    - ``"centered"`` — face-then-interface averaging of centered
    79	      slopes (cheap, but the Redi tendency for ``q = f(ρ)`` retains a
    80	      small residual that accumulates through dynamical feedback).
    81	      Kept as a regression-coverage option and as a fallback for
    82	      cheap short integrations.
    83	    """
    84	    kappa_GM: float = 1e3       # GM bolus transport coefficient [m^2/s]
    85	    kappa_Redi: float = 1e3     # Redi isopycnal diffusivity [m^2/s]
    86	    S_max: float = 0.01         # Maximum isopycnal slope for tapering
    87	    visbeck: VisbeckConfig = VisbeckConfig()
    88	    slope_scheme: str = "triads"     # "triads" (default) or "centered"
    89	
    90	
    91	class LateralMixingConfig(NamedTuple):
    92	    """Top-level lateral mixing configuration."""
    93	    scheme: str = "harmonic"  # "harmonic", "biharmonic", "gm_redi", "none"
    94	    harmonic: HarmonicConfig = HarmonicConfig()
    95	    biharmonic: BiharmonicConfig = BiharmonicConfig()
    96	    gm_redi: GMRediConfig = GMRediConfig()

