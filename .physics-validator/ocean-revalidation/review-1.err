    40	#   lambda(T, S) = (c0 + c4*S) + T*(c1 + T*(c2 + c3*T) + c5*S)
    41	# ==============================================================================
    42	
    43	# Specific volume coefficients al0(T, S)
    44	_a0 = 7.057924e-4
    45	_a1 = 3.480336e-7
    46	_a2 = -1.112733e-7
    47	
    48	# Pressure offset p0(T, S) [Pa]
    49	_b0 = 5.790749e8
    50	_b1 = 3.516535e6
    51	_b2 = -4.002714e4
    52	_b3 = 2.084372e2
    53	_b4 = 5.944068e5
    54	_b5 = -9.643486e3
    55	
    56	# Lambda(T, S) [m^2/s^2]
    57	_c0 = 1.704853e5
    58	_c1 = 7.904722e2
    59	_c2 = -7.984422
    60	_c3 = 5.140652e-2
    61	_c4 = -2.302158e2
    62	_c5 = -3.079464
