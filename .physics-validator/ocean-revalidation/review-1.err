     1	"""Ocean mixing parameterizations.
     2	
     3	Horizontal: Laplacian viscosity/diffusivity (reuses core operators).
     4	Vertical: Explicit second-order diffusion.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import jax.numpy as jnp
    10	
    11	from legoesm.core.operators_3d import (
    12	    divergence_3d,
    13	    gradient_x_3d,
    14	    gradient_y_3d,
    15	)
    16	from legoesm.grids.cubed_sphere import CubedSphereGrid
    17	from legoesm.grids.halo import pad_halo_4d
    18	from legoesm.ocean.vertical import OceanZStarCoordinate
    19	
    20	
    21	def laplacian_viscosity_3d(
    22	    field_3d: jnp.ndarray,
    23	    grid: CubedSphereGrid,
    24	    coeff: float,
    25	    padded: jnp.ndarray | None = None,
    26	) -> jnp.ndarray:
    27	    """Compute ``coeff · ∇² f`` for all levels using the native 4D path.
    28	
    29	    Mathematically identical to the previous ``vmap(laplacian)`` over
    30	    the level axis (``div(grad(f))`` with the same centred metric-aware
    31	    operators), but runs the cubed-sphere halo exchange once over all
    32	    levels through ``pad_halo_4d`` / ``pad_halo_vector_4d`` instead of
    33	    once per level.  Under MPI this collapses ``nlev`` separate messages
    34	    into a constant number, which is the dominant cost on multi-GPU
    35	    runs (CLAUDE.md ``Parallel and HPC Rules`` flag the per-level
    36	    ``vmap(pad_halo)`` pattern explicitly).
    37	
    38	    Parameters
    39	    ----------
    40	    field_3d : array
    41	        3D field, shape (6, n, n, nlev).
    42	    grid : CubedSphereGrid
    43	        Horizontal grid.
    44	    coeff : float
    45	        Viscosity/diffusivity coefficient [m^2/s].
    46	    padded : array or None
    47	        Pre-padded field, shape (6, n+2, n+2, nlev).  When provided,
    48	        the internal halo exchange is skipped — used by callers that
    49	        share the same input across multiple operators (e.g. an
    50	        explicit Laplacian alongside a biharmonic hyperdiffusion).
    51	
    52	    Returns
    53	    -------
    54	    array : Laplacian tendency, shape (6, n, n, nlev).
    55	    """
    56	    # Pre-pad the input field once so both ``gradient_x_3d`` and
    57	    # ``gradient_y_3d`` skip their internal halo exchange — saves one
    58	    # MPI message in distributed runs.  ``divergence_3d`` still issues
    59	    # its own vector halo exchange on the gradient outputs.
    60	    if padded is None:
    61	        dg = getattr(grid, 'duogrid', None)
    62	        offsets = None if dg is not None else grid.halo_interp_offsets
    63	        padded = pad_halo_4d(field_3d, interp_offsets=offsets, duogrid=dg)
    64	    gx = gradient_x_3d(field_3d, grid, padded=padded)
    65	    gy = gradient_y_3d(field_3d, grid, padded=padded)
    66	    return coeff * divergence_3d(gx, gy, grid)
    67	
    68	
    69	def vertical_diffusion(
    70	    field: jnp.ndarray,
    71	    z_coord: OceanZStarCoordinate,
    72	    jacobian: jnp.ndarray,
    73	    coeff: float,
    74	) -> jnp.ndarray:
    75	    """Compute d/dz(coeff * d(field)/dz) using 2nd-order centered differences.
    76	
    77	    Explicit vertical diffusion with zero-flux boundary conditions
    78	    at surface and bottom.
    79	
    80	    Parameters
    81	    ----------
    82	    field : array
    83	        3D field, shape (..., nlev).
    84	    z_coord : OceanZStarCoordinate
    85	        Vertical coordinate.
    86	    jacobian : array
    87	        Dynamic Jacobian, shape (...).
    88	    coeff : float
    89	        Diffusivity [m^2/s].
    90	
    91	    Returns
    92	    -------
    93	    array : Vertical diffusion tendency, shape (..., nlev).
    94	    """
    95	    if field.shape[-1] < 2:
    96	        return jnp.zeros_like(field)
    97	
    98	    dtype = field.dtype
    99	    jacobian = jacobian.astype(dtype)
   100	    coeff = jnp.asarray(coeff, dtype=dtype)
   101	
   102	    # Actual layer thickness and interface spacing
   103	    dz = z_coord.dz_ref * jacobian[..., jnp.newaxis]         # (..., nlev)
   104	    dz_half = 0.5 * (dz[..., :-1] + dz[..., 1:])  # (..., nlev-1)
   105	
   106	    # Diffusive flux at interior interfaces: coeff * d(field)/dz
   107	    df_dz = (field[..., :-1] - field[..., 1:]) / dz_half
   108	    flux = coeff * df_dz  # (..., nlev-1)
   109	
   110	    # Tendency at full levels: d(flux)/dz with zero-flux BCs.
   111	    # Using concatenate avoids scatter updates (better JIT lowering and
   112	    # no mixed-dtype scatter edge cases on strict x64 runs).
   113	    top = -flux[..., :1] / dz[..., :1]  # surface: flux_above = 0
   114	    interior = (flux[..., :-1] - flux[..., 1:]) / dz[..., 1:-1]
   115	    bottom = flux[..., -1:] / dz[..., -1:]  # bottom: flux_below = 0
   116	    return jnp.concatenate([top, interior, bottom], axis=-1)
   117	
   118	
   119	def vertical_diffusion_variable_K(
   120	    field: jnp.ndarray,
   121	    z_coord: OceanZStarCoordinate,
   122	    jacobian: jnp.ndarray,
   123	    K_half: jnp.ndarray,
   124	) -> jnp.ndarray:
   125	    """Compute d/dz(K(z) * d(field)/dz) with spatially varying diffusivity.
   126	
   127	    Same algorithm as ``vertical_diffusion`` but accepts a 3-D diffusivity
   128	    array at interior interfaces instead of a scalar.
   129	
   130	    Parameters
   131	    ----------
   132	    field : array
   133	        3D field, shape (..., nlev).
   134	    z_coord : OceanZStarCoordinate
   135	        Vertical coordinate.
   136	    jacobian : array
   137	        Dynamic Jacobian, shape (...).
   138	    K_half : array
   139	        Diffusivity at interior interfaces [m^2/s], shape (..., nlev-1).
   140	
   141	    Returns
   142	    -------
   143	    array : Vertical diffusion tendency, shape (..., nlev).
   144	    """
   145	    if field.shape[-1] < 2:
   146	        return jnp.zeros_like(field)
   147	
   148	    dtype = field.dtype
   149	    jacobian = jacobian.astype(dtype)
   150	    K_half = K_half.astype(dtype)
   151	
   152	    dz = z_coord.dz_ref * jacobian[..., jnp.newaxis]         # (..., nlev)
   153	    dz_half = 0.5 * (dz[..., :-1] + dz[..., 1:])  # (..., nlev-1)
   154	
   155	    df_dz = (field[..., :-1] - field[..., 1:]) / dz_half
   156	    flux = K_half * df_dz  # (..., nlev-1)
   157	
   158	    top = -flux[..., :1] / dz[..., :1]
   159	    interior = (flux[..., :-1] - flux[..., 1:]) / dz[..., 1:-1]
   160	    bottom = flux[..., -1:] / dz[..., -1:]
   161	    return jnp.concatenate([top, interior, bottom], axis=-1)

