   249	        H_max = float(jnp.sum(z_coord.dz_ref))
   250	        z0 = 100.0
   251	        rho_prof = 1025.0 + 2.0 * (1.0 - jnp.exp(-z_centers / z0))
   252	        rho = jnp.broadcast_to(rho_prof[None, None, None, :], shape)
   253	
