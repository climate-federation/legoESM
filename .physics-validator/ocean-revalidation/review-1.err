   369	    def test_ice_fw_multi_category(self):
   370	        """Multi-category ice: total areal mass change is summed."""
   371	        from legoesm.core.field import Field
   372	        from legoesm.ice.state import SeaIceState
   373	        from legoesm.ice.config import SeaIceConfig
   374	
