     1	"""Monin-Obukhov bulk air-sea flux algorithms.
     2	
     3	Provides stability-dependent transfer coefficients using iterative
     4	Monin-Obukhov similarity theory (MOST). Three schemes:
     5	
     6	1. ``constant`` — Fixed neutral transfer coefficients (no iteration)
     7	2. ``coare3`` — COARE 3.0 (Fairall et al. 2003): Charnock + smooth-flow
     8	   roughness, Businger-Dyer stability functions
     9	3. ``large_yeager`` — Large & Yeager 2004 (CORE): empirical C_DN(U_10N),
    10	   stability-dependent Stanton/Dalton number
    11	
    12	The iterative Obukhov length loop uses ``jax.lax.fori_loop`` for
    13	full JAX differentiability (compatible with jax.grad, jax.jit).
    14	
    15	References
    16	----------
    17	- Fairall, C. W., et al. (2003). Bulk parameterization of air-sea fluxes:
    18	  Updates and verification for the COARE algorithm. J. Climate, 16, 571-591.
    19	- Large, W. G., & Yeager, S. G. (2004). Diurnal to decadal global forcing
    20	  for ocean and sea-ice models. NCAR Tech. Note, NCAR/TN-460+STR.
    21	- Businger, J. A., et al. (1971). Flux-profile relationships in the
    22	  atmospheric surface layer. J. Atmos. Sci., 28, 181-189.
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	import jax
    28	import jax.numpy as jnp
    29	
    30	from legoesm import constants
    31	
    32	# Physical constants
    33	KAPPA = constants.kappa_vk  # von Kármán constant (0.4)
    34	G = constants.g
    35	NU_AIR = 1.5e-5  # kinematic viscosity of air [m²/s]
    36	
    37	
    38	# ============================================================================
    39	# Stability functions (Businger-Dyer)
    40	# ============================================================================
    41	
    42	def psi_m(zeta):
    43	    """MOST momentum stability function.
    44	
    45	    Unstable (ζ < 0): Businger-Dyer
    46	        ψ_m = 2 ln((1+x)/2) + ln((1+x²)/2) − 2 arctan(x) + π/2
    47	        where x = (1 − 16ζ)^{1/4}
    48	    Stable (ζ > 0): Dyer (1974)
    49	        ψ_m = −5ζ
    50	
    51	    Uses safe branching (min/max on inputs) to avoid NaN gradients
    52	    in the inactive branch.
    53	    """
    54	    zeta_c = jnp.clip(zeta, -10.0, 10.0)
    55	    # Safe inputs: each branch only sees valid arguments
    56	    zeta_neg = jnp.minimum(zeta_c, -1e-10)
    57	    zeta_pos = jnp.maximum(zeta_c, 1e-10)
    58	
    59	    x = jnp.power(1.0 - 16.0 * zeta_neg, 0.25)
    60	    unstable = (
    61	        2.0 * jnp.log((1.0 + x) / 2.0)
    62	        + jnp.log((1.0 + x ** 2) / 2.0)
    63	        - 2.0 * jnp.arctan(x)
    64	        + jnp.pi / 2.0
    65	    )
    66	    stable = -5.0 * zeta_pos
    67	
    68	    return jnp.where(zeta_c < 0.0, unstable, stable)
    69	
    70	
    71	def psi_h(zeta):
    72	    """MOST heat/moisture stability function.
    73	
    74	    Unstable (ζ < 0): Businger-Dyer
    75	        ψ_h = 2 ln((1+y)/2)  where y = (1 − 16ζ)^{1/2}
    76	    Stable (ζ > 0): Dyer (1974)
    77	        ψ_h = −5ζ
    78	    """
    79	    zeta_c = jnp.clip(zeta, -10.0, 10.0)
    80	    zeta_neg = jnp.minimum(zeta_c, -1e-10)
    81	    zeta_pos = jnp.maximum(zeta_c, 1e-10)
    82	
    83	    y = jnp.sqrt(1.0 - 16.0 * zeta_neg)
    84	    unstable = 2.0 * jnp.log((1.0 + y) / 2.0)
    85	    stable = -5.0 * zeta_pos
    86	
    87	    return jnp.where(zeta_c < 0.0, unstable, stable)
    88	
    89	
    90	# ============================================================================
    91	# Main MOST flux computation
    92	# ============================================================================
    93	
    94	def compute_most_fluxes(
    95	    u_rel,
    96	    v_rel,
    97	    T_atm,
    98	    q_atm,
    99	    T_sfc,
   100	    q_sfc,
   101	    rho,
   102	    z_ref=10.0,
   103	    z0_init=1e-4,
   104	    scheme="coare3",
   105	    n_iter=5,
   106	    charnock=0.011,
   107	    L_latent=None,
   108	):
   109	    """Compute stability-dependent bulk fluxes via iterative MOST.
   110	
   111	    Uses ``jax.lax.fori_loop`` for the Obukhov length iteration,
   112	    ensuring full JAX differentiability (jax.grad, jax.jit).
   113	
   114	    Parameters
   115	    ----------
   116	    u_rel, v_rel : array
   117	        Wind components relative to surface [m/s].
   118	    T_atm : array
   119	        Atmospheric temperature at reference height [K].
   120	    q_atm : array
   121	        Atmospheric specific humidity at reference height [kg/kg].
   122	    T_sfc : array
   123	        Surface temperature [K].
   124	    q_sfc : array
   125	        Surface saturation specific humidity [kg/kg].
   126	    rho : array
   127	        Air density at reference height [kg/m³].
   128	    z_ref : float
   129	        Reference height for bulk formulas [m] (default 10).
   130	    z0_init : float
   131	        Initial momentum roughness length [m] (default 1e-4).
   132	    scheme : str
   133	        ``"coare3"`` or ``"large_yeager"``.
   134	    n_iter : int
   135	        Number of MOST iterations (default 5).
   136	    charnock : float
   137	        Charnock coefficient (COARE only, default 0.011).
   138	
   139	    Returns
   140	    -------
   141	    tau_x, tau_y : array
   142	        Surface stress [Pa] (opposes wind direction).
   143	    shflx : array
   144	        Sensible heat flux [W/m²] (positive upward = surface warmer).
   145	    lhflx : array
   146	        Latent heat flux [W/m²] (positive upward = surface moister).
   147	    ustar : array
   148	        Friction velocity [m/s].
   149	    """
   150	    wind_speed = jnp.sqrt(u_rel ** 2 + v_rel ** 2 + 1e-4)
   151	    dT = T_sfc - T_atm
   152	    dq = q_sfc - q_atm
   153	    T_v = T_atm * (1.0 + 0.61 * q_atm)
   154	
   155	    # Initialize with neutral log-law profile
   156	    z0 = jnp.full_like(wind_speed, z0_init)
   157	    z0_t = z0 * 0.1
   158	    z0_q = z0_t
   159	
   160	    ln_z_z0 = jnp.log(z_ref / jnp.maximum(z0, 1e-12))
   161	    denom_init = jnp.maximum(ln_z_z0, 0.5)
   162	    u_star = KAPPA * wind_speed / denom_init
   163	    theta_star = KAPPA * dT / denom_init
   164	    q_star_val = KAPPA * dq / denom_init
   165	
   166	    carry = (u_star, z0, z0_t, z0_q, theta_star, q_star_val)
   167	
   168	    def body_fn(i, carry):
   169	        u_star, z0, z0_t, z0_q, theta_star, q_star_val = carry
   170	        u_star_safe = jnp.maximum(u_star, 1e-6)
   171	
   172	        # Virtual potential temperature scale
   173	        theta_v_star = theta_star + 0.61 * T_atm * q_star_val
   174	
   175	        # Obukhov length: L = −u*² T_v / (κ g θ_v*)
   176	        L_denom = KAPPA * G * theta_v_star
   177	        L = jnp.where(
   178	            jnp.abs(L_denom) > 1e-10,
   179	            -u_star_safe ** 2 * T_v / L_denom,
   180	            jnp.where(L_denom > 0.0, -1e6, 1e6),
   181	        )
   182	
   183	        zeta = jnp.clip(z_ref / L, -10.0, 10.0)
   184	        psi_m_val = psi_m(zeta)
   185	        psi_h_val = psi_h(zeta)
   186	
   187	        # --- Roughness update (Python if resolved at trace time) ---
   188	        if scheme == "coare3":
   189	            # COARE 3.0: Charnock + smooth-flow regime
   190	            z0_new = (
   191	                charnock * u_star_safe ** 2 / G
   192	                + 0.11 * NU_AIR / u_star_safe
   193	            )
   194	            Re = u_star_safe * z0_new / NU_AIR
   195	            z0_t_new = jnp.minimum(
   196	                1.15e-4,
   197	                5.5e-5 * jnp.power(jnp.maximum(Re, 0.01), -0.6),
   198	            )
   199	            z0_q_new = z0_t_new
   200	
   201	        elif scheme == "large_yeager":
   202	            # Large & Yeager 2004 (CORE): iterate in coefficient space.
   203	            # 1) Neutral 10-m wind from current u_star and z0
   204	            U_10N = u_star_safe / KAPPA * jnp.log(
   205	                10.0 / jnp.maximum(z0, 1e-12)
   206	            )
   207	            U_10N = jnp.clip(U_10N, 0.5, 50.0)
   208	
   209	            # 2) Empirical neutral 10-m drag coefficient C_DN(U_10N)
   210	            C_DN = (2.7 / U_10N + 0.142 + 0.0764 * U_10N) * 1e-3
   211	            C_DN = jnp.clip(C_DN, 0.5e-3, 3.0e-3)
   212	
   213	            # 3) Neutral exchange coefficients at 10 m
   214	            rdn = jnp.sqrt(C_DN)
   215	            # Stability-dependent 10-m Stanton/Dalton number
   216	            CHN10 = jnp.where(zeta < 0.0, 32.7e-3, 18.0e-3) * rdn
   217	            CEN10 = 34.6e-3 * rdn
   218	            rhn = CHN10 / rdn  # = ch_coeff
   219	            ren = CEN10 / rdn  # = ce_coeff
   220	
   221	            # 4) Shift coefficients from 10 m to measurement height z_ref
   222	            #    with stability corrections (LY04 Eq. 9-11):
   223	            #    rd = rdn / (1 + rdn/kappa * (ln(z_ref/10) - psi_m))
   224	            #    rh = rhn / (1 + rhn/kappa * (ln(z_ref/10) - psi_h))
   225	            ln_z_ratio = jnp.log(z_ref / 10.0)
   226	            zeta_10 = jnp.clip(10.0 / L, -10.0, 10.0)
   227	            psi_m_10 = psi_m(zeta_10)
   228	            psi_h_10 = psi_h(zeta_10)
   229	            # Stability correction difference between z_ref and 10 m
   230	            dpsi_m = psi_m_val - psi_m_10
   231	            dpsi_h = psi_h_val - psi_h_10
   232	
   233	            rd = rdn / jnp.maximum(
   234	                1.0 + rdn / KAPPA * (ln_z_ratio - dpsi_m), 0.2
   235	            )
   236	            rh = rhn / jnp.maximum(
   237	                1.0 + rhn / KAPPA * (ln_z_ratio - dpsi_h), 0.2
   238	            )
   239	            re = ren / jnp.maximum(
   240	                1.0 + ren / KAPPA * (ln_z_ratio - dpsi_h), 0.2
   241	            )
   242	
   243	            # 5) Update scaling parameters directly from coefficients
   244	            u_star_new = rd * wind_speed
   245	            theta_star_new = rh * dT
   246	            q_star_new = re * dq
   247	
   248	            # Still need z0 for the next iteration's U_10N estimate
   249	            z0_new = z_ref / jnp.exp(KAPPA / rd + psi_m_val)
   250	            z0_new = jnp.clip(z0_new, 1e-12, 1.0)
   251	            z0_t_new = z0_t  # not used in coefficient path
   252	            z0_q_new = z0_q  # not used in coefficient path
   253	
   254	            return (u_star_new, z0_new, z0_t_new, z0_q_new,
   255	                    theta_star_new, q_star_new)
   256	
   257	        else:
   258	            z0_new = z0
   259	            z0_t_new = z0_t
   260	            z0_q_new = z0_q

