    49	    q_sat = _saturation_specific_humidity(T_s)
    50	
    51	    Q_lw_up = cfg.emissivity * constants.sigma_sb * T_s ** 4
    52	
    53	    if cfg.bulk_scheme in ("coare3", "large_yeager"):
    54	        from legoesm.coupler.bulk_flux import compute_most_fluxes
    55	        # Wind is zonal only (prescribed), zero meridional
    56	        u_a = jnp.full_like(T_s, cfg.U_a, dtype=dtype)
    57	        v_a = jnp.zeros_like(T_s)
    58	        T_a = jnp.full_like(T_s, cfg.T_a, dtype=dtype)
    59	        q_a = jnp.full_like(T_s, cfg.q_a, dtype=dtype)
    60	        rho_a = jnp.full_like(T_s, cfg.rho_a, dtype=dtype)
    61	
    62	        tau_x, tau_y, Q_sh, Q_lh, _ = compute_most_fluxes(
    63	            u_a, v_a, T_a, q_a, T_s, q_sat, rho_a,
    64	            z_ref=cfg.z_ref,
    65	            z0_init=cfg.z0,
    66	            scheme=cfg.bulk_scheme,
    67	            n_iter=cfg.bulk_n_iter,
    68	        )
    69	        # Fluxes are positive upward; stress opposes wind
    70	        tau_x = -tau_x  # flip to positive eastward
    71	    else:
    72	        # Constant coefficients: wind is zonal-only (u_a = U_a, v_a = 0)
    73	        # to match the directional convention used in the MOST path.
    74	        Q_sh = cfg.rho_a * cfg.c_pa * cfg.C_H * cfg.U_a * (T_s - cfg.T_a)
    75	        Q_lh = cfg.rho_a * cfg.L_v * cfg.C_E * cfg.U_a * (q_sat - cfg.q_a)
    76	
    77	        # tau = rho_a * C_D * |U_a| * (u_a, v_a)  — directional stress
    78	        U_a_speed = jnp.abs(cfg.U_a)
    79	        tau_x = jnp.full_like(T_s, cfg.rho_a * cfg.C_D * U_a_speed * cfg.U_a, dtype=dtype)
