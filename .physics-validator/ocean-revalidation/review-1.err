     1	"""Enhanced diffusion for convective adjustment.
     2	
     3	Applies large vertical diffusivity where N^2 < 0 (statically unstable).
     4	"""
     5	
     6	from __future__ import annotations
     7	
     8	import jax
     9	import jax.numpy as jnp
    10	
    11	from legoesm.ocean.eos import compute_buoyancy_frequency
    12	from legoesm.ocean.physics.mixing import vertical_diffusion_variable_K
    13	from legoesm.ocean.physics.convection.config import EnhancedDiffusionConfig
    14	from legoesm.ocean.physics.convection.output import OceanConvectionOutput
    15	from legoesm.ocean.vertical import OceanZStarCoordinate
    16	
    17	
    18	def enhanced_diffusion_convection(
    19	    T: jnp.ndarray,
    20	    S: jnp.ndarray,
    21	    rho: jnp.ndarray,
    22	    z_coord: OceanZStarCoordinate,
    23	    jacobian: jnp.ndarray,
    24	    cfg: EnhancedDiffusionConfig,
    25	) -> OceanConvectionOutput:
    26	    """Apply enhanced diffusion where the water column is unstable.
    27	
    28	    Parameters
    29	    ----------
    30	    T, S : array (6, n, n, nlev)
    31	    rho : array (6, n, n, nlev)
    32	    z_coord : OceanZStarCoordinate
    33	    jacobian : array (6, n, n)
    34	    cfg : EnhancedDiffusionConfig
    35	
    36	    Returns
    37	    -------
    38	    OceanConvectionOutput
    39	    """
    40	    # N^2 at interfaces
    41	    N2 = compute_buoyancy_frequency(rho, z_coord.dz_ref, jacobian)
    42	
    43	    # Diffusivity: large where N^2 < 0
    44	    if cfg.smooth_transition:
    45	        # Smooth sigmoid transition
    46	        K = cfg.K_bg + (cfg.K_conv - cfg.K_bg) * jax.nn.sigmoid(
    47	            -N2 * cfg.sigmoid_sharpness
    48	        )
    49	    else:
    50	        K = jnp.where(N2 < 0.0, cfg.K_conv, cfg.K_bg)
    51	
    52	    # Convection flag
    53	    if cfg.smooth_transition:
    54	        flag = jax.nn.sigmoid(-N2 * cfg.sigmoid_sharpness)
    55	    else:
    56	        flag = jnp.where(N2 < 0.0, 1.0, 0.0)
    57	
    58	    # Apply variable-K vertical diffusion to T and S
    59	    tracers = jnp.stack([T, S], axis=0)
    60	    tr_tend = jax.vmap(
    61	        lambda q: vertical_diffusion_variable_K(q, z_coord, jacobian, K),
    62	        in_axes=0, out_axes=0,
    63	    )(tracers)
    64	
    65	    return OceanConvectionOutput(
    66	        dT_dt=tr_tend[0],
    67	        dS_dt=tr_tend[1],
    68	        convection_flag=flag,
    69	    )

