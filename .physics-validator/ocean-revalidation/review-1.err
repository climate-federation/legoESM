A few additional issues are emerging beyond the sign fix: the KPP fallback path has the sign inversion you suspected, and the Monin-Obukhov stability sign inside KPP looks internally inconsistent with `B_f > 0 = unstable`. I’m checking which of these actually changes tendencies rather than just comments/API naming.
exec
/bin/zsh -lc ".venv/bin/python - <<'PY'
import jax.numpy as jnp
from legoesm import constants
rho0=1025.0; K_bg=1e-5; g=constants.g
# stable: surface density lower than level 1
rho=jnp.array([1025.0,1025.2])
dz=10.0
drho_code=(rho[0]-rho[1])/dz
B_code=-g/rho0*K_bg*drho_code
B_expected=+g/rho0*K_bg*drho_code
print('stable drho_code', float(drho_code), 'B_code', float(B_code), 'B_expected_sign', float(B_expected))
# KPP zeta sign example
u_star=0.01; Bf=-1e-7; kappa=0.4; d=10.0
L_code=u_star**3/(kappa*Bf)
zeta_code=d/L_code
ws_code=kappa*u_star/max(1+5*max(zeta_code,0),1)
L_flip=-u_star**3/(kappa*Bf)
zeta_flip=d/L_flip
ws_flip=kappa*u_star/max(1+5*max(zeta_flip,0),1)
print('stable Bf zeta_code', zeta_code, 'ws_code', ws_code, 'zeta_expected', zeta_flip, 'ws_expected', ws_flip)
