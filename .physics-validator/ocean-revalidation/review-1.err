     1	"""Sea ice model state containers.
     2	
     3	Two state types:
     4	- ``SeaIceState``: Slab thermodynamics only (3 fields, backward compatible).
     5	- ``DynamicSeaIceState``: Full dynamic ice with velocity, stress tensor,
     6	  and optional multi-category fields.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	from typing import NamedTuple
    12	
    13	import jax.numpy as jnp
    14	
    15	from legoesm.core.field import Field
    16	
    17	
    18	class SeaIceState(NamedTuple):
    19	    """Thermodynamic slab sea ice state.
    20	
    21	    All fields have shape (6, n, n).
    22	    """
    23	    h_ice: Field               # Ice thickness [m]
    24	    T_ice: Field               # Ice surface temperature [K]
    25	    concentration: Field       # Ice areal fraction [0-1]
    26	
    27	
    28	class DynamicSeaIceState(NamedTuple):
    29	    """Full dynamic sea ice state with velocity and stress tensor.
    30	
    31	    Thickness/temperature/concentration may have shape (6, n, n) for
    32	    single-category or (6, n, n, n_cat) for multi-category ice.
    33	    Velocity and stress are always (6, n, n).
    34	    """
    35	    h_ice: Field               # Ice thickness [m]
    36	    T_ice: Field               # Ice surface temperature [K]
    37	    concentration: Field       # Ice areal fraction [0-1]
    38	    u_ice: Field               # Ice velocity x-component [m/s]
    39	    v_ice: Field               # Ice velocity y-component [m/s]
    40	    sigma_11: Field            # Stress tensor component [N/m]
    41	    sigma_22: Field            # Stress tensor component [N/m]
    42	    sigma_12: Field            # Stress tensor component [N/m]
    43	
    44	
    45	def init_dynamic_ice_state(shape: tuple[int, ...]) -> DynamicSeaIceState:
    46	    """Create a zero-initialized DynamicSeaIceState.
    47	
    48	    Parameters
    49	    ----------
    50	    shape : tuple
    51	        Spatial shape, typically (6, n, n).
    52	    """
    53	    dims = ("face", "x", "y")
    54	    return DynamicSeaIceState(
    55	        h_ice=Field(data=jnp.zeros(shape), name="h_ice", dims=dims, units="m"),
    56	        T_ice=Field(data=jnp.full(shape, 260.0), name="T_ice", dims=dims, units="K"),
    57	        concentration=Field(data=jnp.zeros(shape), name="ice_concentration", dims=dims, units="1"),
    58	        u_ice=Field(data=jnp.zeros(shape), name="u_ice", dims=dims, units="m/s"),
    59	        v_ice=Field(data=jnp.zeros(shape), name="v_ice", dims=dims, units="m/s"),
    60	        sigma_11=Field(data=jnp.zeros(shape), name="sigma_11", dims=dims, units="N/m"),
    61	        sigma_22=Field(data=jnp.zeros(shape), name="sigma_22", dims=dims, units="N/m"),
    62	        sigma_12=Field(data=jnp.zeros(shape), name="sigma_12", dims=dims, units="N/m"),
    63	    )
    64	
    65	
    66	def dynamic_to_slab(state: DynamicSeaIceState) -> SeaIceState:
    67	    """Convert DynamicSeaIceState to SeaIceState (drops dynamics fields).
    68	
    69	    If multi-category, aggregates to single category first.
    70	    """
    71	    h = state.h_ice.data
    72	    T = state.T_ice.data
    73	    a = state.concentration.data
    74	
    75	    # Multi-category: aggregate
    76	    if h.ndim > 3:
    77	        from legoesm.ice.itd import aggregate_state
    78	        h_agg, T_agg, a_agg = aggregate_state(h, T, a)
    79	        return SeaIceState(
    80	            h_ice=state.h_ice.replace(data=h_agg),
    81	            T_ice=state.T_ice.replace(data=T_agg),
    82	            concentration=state.concentration.replace(data=a_agg),
    83	        )
    84	
    85	    return SeaIceState(
    86	        h_ice=state.h_ice,
