     1	"""Subsurface shortwave penetration heating.
     2	
     3	Distributes downwelling shortwave radiation through the water column
     4	using a two-band exponential absorption profile (Paulson & Simpson 1977,
     5	Jerlov water types).  Without this, all SW heating is applied to the
     6	surface layer, producing unrealistically warm SST and shallow mixed layers.
     7	
     8	References
     9	----------
    10	Paulson, C. A. & Simpson, J. J. (1977): Irradiance measurements in the
    11	    upper ocean. J. Phys. Oceanogr., 7(6), 952-956.
    12	Jerlov, N. G. (1976): Marine Optics. Elsevier, 231 pp.
    13	"""
    14	
    15	from __future__ import annotations
    16	
    17	from typing import NamedTuple
    18	
    19	import jax.numpy as jnp
    20	
    21	
    22	# ==============================================================================
    23	# Jerlov water type parameters
    24	# ==============================================================================
    25	# Two-band model: I(z) = Q_sw * [R * exp(z/zeta1) + (1-R) * exp(z/zeta2)]
    26	# where z is negative (depth below surface), zeta1/zeta2 are e-folding depths.
    27	
    28	class JerlovParams(NamedTuple):
    29	    """Two-band parameters for a Jerlov water type."""
    30	    R: float        # Fraction in short-wavelength band (red/IR)
    31	    zeta1: float    # e-folding depth of band 1 [m] (short, ~red/IR)
    32	    zeta2: float    # e-folding depth of band 2 [m] (long, ~blue/green)
    33	
    34	
    35	# Standard Jerlov water types (Paulson & Simpson 1977, Table 1).
    36	JERLOV_TYPES: dict[str, JerlovParams] = {
    37	    "I":   JerlovParams(R=0.58, zeta1=0.35, zeta2=23.0),
    38	    "IA":  JerlovParams(R=0.62, zeta1=0.60, zeta2=20.0),
    39	    "IB":  JerlovParams(R=0.67, zeta1=1.00, zeta2=17.0),
    40	    "II":  JerlovParams(R=0.77, zeta1=1.50, zeta2=14.0),
    41	    "III": JerlovParams(R=0.78, zeta1=1.40, zeta2=7.9),
    42	}
    43	
    44	
    45	class ShortwavePenetrationConfig(NamedTuple):
    46	    """Configuration for subsurface SW penetration.
    47	
    48	    Parameters
    49	    ----------
    50	    water_type : str
    51	        Jerlov water type ("I", "IA", "IB", "II", "III").
    52	        Type I = clearest open ocean, Type III = coastal/turbid.
    53	        Default "II" is a reasonable global average.
    54	    """
    55	    water_type: str = "II"
    56	
    57	
    58	def shortwave_penetration_tendency(
    59	    sw_down: jnp.ndarray,
    60	    z_coord_dz_ref: jnp.ndarray,
    61	    z_coord_z_half_ref: jnp.ndarray,
    62	    jacobian: jnp.ndarray,
    63	    config: ShortwavePenetrationConfig = ShortwavePenetrationConfig(),
    64	    rho_0: float = 1025.0,  # = eos.rho_0
    65	    c_sw: float = 3994.0,   # = eos.c_sw
    66	) -> jnp.ndarray:
    67	    """Compute 3D temperature tendency from subsurface SW absorption.
    68	
    69	    Parameters
    70	    ----------
    71	    sw_down : array, shape (...,)
    72	        Downwelling shortwave at the sea surface [W/m²].
    73	    z_coord_dz_ref : array, shape (nlev,)
    74	        Reference layer thicknesses [m].
    75	    z_coord_z_half_ref : array, shape (nlev+1,)
    76	        Reference interface depths [m] (negative, z_half_ref[0]=0).
    77	    jacobian : array, shape (...,)
    78	        Dynamic z-star Jacobian (eta + H) / H.
    79	    config : ShortwavePenetrationConfig
    80	    rho_0 : float
    81	        Reference seawater density [kg/m³].
    82	    c_sw : float
    83	        Specific heat of seawater [J/(kg·K)].
    84	
    85	    Returns
    86	    -------
    87	    array, shape (..., nlev)
    88	        Temperature tendency dT/dt [K/s] from SW absorption.
    89	    """
    90	    params = JERLOV_TYPES[config.water_type]
    91	    R = params.R
    92	    zeta1 = params.zeta1
    93	    zeta2 = params.zeta2
    94	
    95	    # Interface depths (negative), shape (nlev+1,).
    96	    # Uses reference z (not dynamic z*J) for the absorption profile.
    97	    # Error is O(eta/H) ~ O(1e-4), negligible vs Jerlov parameter
    98	    # uncertainty.  Standard practice in MOM6, NEMO, and POP.
    99	    z_half = z_coord_z_half_ref
   100	
   101	    # SW flux at each interface: I(z) = Q_sw * [R*exp(z/zeta1) + (1-R)*exp(z/zeta2)]
   102	    # z_half[0] = 0 (surface), z_half[-1] = -H_max (bottom)
   103	    I_half = R * jnp.exp(z_half / zeta1) + (1.0 - R) * jnp.exp(z_half / zeta2)
   104	    # Shape: (nlev+1,)
   105	
   106	    # Fraction absorbed in each layer = I_half[k] - I_half[k+1]
   107	    frac_absorbed = I_half[:-1] - I_half[1:]  # (nlev,)
   108	
   109	    # Actual layer thickness
   110	    dz_actual = z_coord_dz_ref * jacobian[..., jnp.newaxis]  # (..., nlev)
   111	
   112	    # Temperature tendency: dT/dt = Q_sw * frac / (rho_0 * c_sw * dz)
   113	    dT_dt = (
   114	        sw_down[..., jnp.newaxis] * frac_absorbed / (rho_0 * c_sw * dz_actual)
   115	    )
   116	
   117	    return dT_dt

