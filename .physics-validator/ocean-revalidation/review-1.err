    88	    inv_rho_csw_dz = 1.0 / (rho_0_ref * c_sw * jnp.maximum(dz_0, 1e-10))
    89	
    90	    # Pad with zero on trailing axis instead of alloc-zeros +
    91	    # scatter — single Pad HLO op per field.  Same pattern as the
    92	    # ``prescribed.py`` and ``restoring.py`` rewrites.
    93	    nlev = shape_3d[-1]
    94	    pad_axes = ((0, 0),) * (len(shape_3d) - 1)
    95	    du_dt = jnp.pad(
    96	        (tau_x * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
    97	    )
    98	    dv_dt = jnp.pad(
    99	        (tau_y * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
   100	    )
   101	    dT_dt = jnp.pad(
   102	        (Q_net * inv_rho_csw_dz)[..., None], (*pad_axes, (0, nlev - 1)),
   103	    )
   104	    # No freshwater forcing in basic bulk formulation
   105	    dS_dt = jnp.zeros(shape_3d, dtype=dtype)
   106	
   107	    return SurfaceForcingOutput(
   108	        du_dt=du_dt, dv_dt=dv_dt, dT_dt=dT_dt, dS_dt=dS_dt,
   109	        Q_net=Q_net, tau_x=tau_x, tau_y=tau_y,
   110	    )

