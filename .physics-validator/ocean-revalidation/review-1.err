     1	"""Linear bottom drag: du/dt = -r * u / dz_bottom.
     2	
     3	The coefficient r has units [m/s] so that the bottom stress
     4	tau = rho_0 * r * u is independent of vertical resolution.
     5	This matches MITgcm's ``bottomDragLinear`` convention and is
     6	consistent with the quadratic drag implementation.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import jax.numpy as jnp
    12	
    13	from legoesm.ocean.physics.bottom_drag.config import LinearDragConfig
    14	from legoesm.ocean.physics.bottom_drag.output import BottomDragOutput
    15	from legoesm.ocean.vertical import OceanZStarCoordinate
    16	
    17	_EPS = float(jnp.finfo(jnp.float32).eps)
    18	
    19	
    20	def linear_bottom_drag(
    21	    u: jnp.ndarray,
    22	    v: jnp.ndarray,
    23	    z_coord: OceanZStarCoordinate,
    24	    jacobian: jnp.ndarray,
    25	    cfg: LinearDragConfig,
    26	) -> BottomDragOutput:
    27	    """Apply linear bottom drag at the deepest level.
    28	
    29	    du/dt = -r * u / dz_bottom   [m/s^2]
    30	
    31	    where dz_bottom = dz_ref[-1] * jacobian is the physical thickness
    32	    of the bottom layer.
    33	
    34	    Parameters
    35	    ----------
    36	    u, v : array (..., nlev)
    37	        Velocity components.
    38	    z_coord : OceanZStarCoordinate
    39	        Vertical coordinate (provides reference layer thicknesses).
    40	    jacobian : array (...)
    41	        z-star Jacobian (eta + H_bathy) / H_max at cell centers.
    42	    cfg : LinearDragConfig
    43	        Configuration with r in [m/s].
    44	
    45	    Returns
    46	    -------
    47	    BottomDragOutput
    48	    """
    49	    # Bottom layer thickness
    50	    dz_bottom = z_coord.dz_ref[-1] * jacobian  # (...)
    51	    inv_dz = 1.0 / jnp.maximum(dz_bottom, _EPS)
    52	
    53	    # Pad with zero on top instead of allocating ``zeros_like`` and
    54	    # scattering only the bottom row.  Single Pad HLO op vs alloc +
    55	    # dynamic_update_slice.
    56	    nlev = u.shape[-1]
    57	    drag_u = -cfg.r * u[..., -1] * inv_dz
    58	    drag_v = -cfg.r * v[..., -1] * inv_dz
    59	    pad_axes = ((0, 0),) * (drag_u.ndim)
    60	    du_dt = jnp.pad(drag_u[..., None], (*pad_axes, (nlev - 1, 0)))
    61	    dv_dt = jnp.pad(drag_v[..., None], (*pad_axes, (nlev - 1, 0)))
    62	    return BottomDragOutput(du_dt=du_dt, dv_dt=dv_dt)

