/bin/zsh -lc "JAX_PLATFORMS=cpu .venv/bin/python - <<'PY'
import jax.numpy as jnp
# Reproduce kpp.py nonlocal divergence/mask for a BL crossing a cell center.
dz_actual=jnp.array([10.,10.,10.])
z_depth=jnp.cumsum(dz_actual)-0.5*dz_actual # 5,15,25
h_bl=15.0
sigma=z_depth/h_bl
z_half_depth=0.5*(z_depth[:-1]+z_depth[1:]) # 10,20
G=(jnp.clip(z_half_depth/h_bl,0,1)*(1-jnp.clip(z_half_depth/h_bl,0,1))**2)
F=G # set gamma*Q=1
raw=jnp.concatenate([-F[:1]/dz_actual[:1], (F[:-1]-F[1:])/dz_actual[1:-1], F[-1:]/dz_actual[-1:]])
masked=jnp.where(sigma<1, raw, 0.0)
print('z_depth', z_depth, 'sigma', sigma, 'G_half', G, 'raw', raw, 'raw integral', float(jnp.sum(raw*dz_actual)), 'masked', masked, 'masked integral', float(jnp.sum(masked*dz_actual)))
