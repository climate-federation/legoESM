   276	    def test_with_ice(self):
   277	        """Ice melting should produce positive freshwater."""
   278	        from legoesm.core.field import Field
   279	        from legoesm.ice.state import SeaIceState
   280	
   281	        n = 10
   282	        shape = (n,)
   283	        h_old = jnp.ones(shape) * 1.0  # 1m ice
   284	        h_new = jnp.ones(shape) * 0.8  # melted to 0.8m
   285	        conc = jnp.ones(shape) * 0.5
   286	
   287	        ice_old = SeaIceState(
   288	            h_ice=Field(data=h_old, name="h_ice", dims=("nCells",), units="m"),
   289	            T_ice=Field(data=jnp.full(shape, 260.0), name="T_ice", dims=("nCells",), units="K"),
   290	            concentration=Field(data=conc, name="conc", dims=("nCells",), units="1"),
   291	        )
   292	        ice_new = SeaIceState(
   293	            h_ice=Field(data=h_new, name="h_ice", dims=("nCells",), units="m"),
   294	            T_ice=Field(data=jnp.full(shape, 260.0), name="T_ice", dims=("nCells",), units="K"),
   295	            concentration=Field(data=conc, name="conc", dims=("nCells",), units="1"),
   296	        )
   297	
   298	        from legoesm.ice.config import SeaIceConfig
   299	        ice_cfg = SeaIceConfig()
   300	
   301	        fw = freshwater_from_coupler(
   302	            jnp.zeros(n), jnp.zeros(n), 2.5e6,
   303	            ice_state_old=ice_old, ice_state_new=ice_new,
   304	            ice_config=ice_cfg, dt=3600.0,
   305	        )
   306	        # Melting (h decreases) should give positive ice_fw
   307	        assert jnp.all(fw.ice_fw > 0)
   308	
   309	    def test_ice_fw_thickness_only_melt(self):
   310	        """Thickness-only melt (fixed concentration) → correct mass change."""
   311	        from legoesm.core.field import Field
   312	        from legoesm.ice.state import SeaIceState
   313	        from legoesm.ice.config import SeaIceConfig
   314	
   315	        n, dt = 5, 3600.0
   316	        shape = (n,)
   317	        rho_ice = SeaIceConfig().rho_ice
   318	        h_old, h_new, conc = 2.0, 1.5, 0.8
   319	
   320	        ice_old = SeaIceState(
   321	            h_ice=Field(data=jnp.full(shape, h_old), name="h", dims=("c",), units="m"),
   322	            T_ice=Field(data=jnp.full(shape, 260.0), name="T", dims=("c",), units="K"),
   323	            concentration=Field(data=jnp.full(shape, conc), name="A", dims=("c",), units="1"),
   324	        )
   325	        ice_new = SeaIceState(
   326	            h_ice=Field(data=jnp.full(shape, h_new), name="h", dims=("c",), units="m"),
   327	            T_ice=Field(data=jnp.full(shape, 260.0), name="T", dims=("c",), units="K"),
   328	            concentration=Field(data=jnp.full(shape, conc), name="A", dims=("c",), units="1"),
   329	        )
   330	
   331	        fw = freshwater_from_coupler(
   332	            jnp.zeros(n), jnp.zeros(n), 2.5e6,
   333	            ice_state_old=ice_old, ice_state_new=ice_new,
   334	            ice_config=SeaIceConfig(), dt=dt,
   335	        )
   336	        expected = rho_ice * (h_old - h_new) * conc / dt
   337	        assert jnp.allclose(fw.ice_fw, expected, rtol=1e-10)
   338	
   339	    def test_ice_fw_concentration_only(self):
   340	        """Concentration change at fixed thickness → correct mass change."""
   341	        from legoesm.core.field import Field
   342	        from legoesm.ice.state import SeaIceState
   343	        from legoesm.ice.config import SeaIceConfig
   344	
   345	        n, dt = 5, 3600.0
   346	        shape = (n,)
   347	        rho_ice = SeaIceConfig().rho_ice
   348	        h, A_old, A_new = 1.0, 0.8, 0.6
   349	
   350	        ice_old = SeaIceState(
   351	            h_ice=Field(data=jnp.full(shape, h), name="h", dims=("c",), units="m"),
   352	            T_ice=Field(data=jnp.full(shape, 260.0), name="T", dims=("c",), units="K"),
   353	            concentration=Field(data=jnp.full(shape, A_old), name="A", dims=("c",), units="1"),
   354	        )
   355	        ice_new = SeaIceState(
   356	            h_ice=Field(data=jnp.full(shape, h), name="h", dims=("c",), units="m"),
   357	            T_ice=Field(data=jnp.full(shape, 260.0), name="T", dims=("c",), units="K"),
   358	            concentration=Field(data=jnp.full(shape, A_new), name="A", dims=("c",), units="1"),
   359	        )
   360	
   361	        fw = freshwater_from_coupler(
   362	            jnp.zeros(n), jnp.zeros(n), 2.5e6,
   363	            ice_state_old=ice_old, ice_state_new=ice_new,
   364	            ice_config=SeaIceConfig(), dt=dt,
   365	        )
   366	        expected = rho_ice * h * (A_old - A_new) / dt
   367	        assert jnp.allclose(fw.ice_fw, expected, rtol=1e-10)
