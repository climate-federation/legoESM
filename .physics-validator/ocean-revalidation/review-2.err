     1	"""COARE-like bulk air-sea flux formulation."""
     2	
     3	from __future__ import annotations
     4	
     5	import jax.numpy as jnp
     6	
     7	from legoesm import constants
     8	from legoesm.thermo import saturation_mixing_ratio
     9	from legoesm.ocean.eos import rho_0 as rho_0_ref, c_sw
    10	from legoesm.ocean.physics.surface_forcing.config import BulkFormulaConfig
    11	from legoesm.ocean.physics.surface_forcing.output import SurfaceForcingOutput
    12	from legoesm.ocean.vertical import OceanZStarCoordinate
    13	
    14	_P_ATM = 101325.0  # Standard atmosphere [Pa]
    15	
    16	
    17	def _saturation_specific_humidity(T_K: jnp.ndarray) -> jnp.ndarray:
    18	    """Saturation specific humidity at standard atmosphere pressure."""
    19	    return saturation_mixing_ratio(T_K, jnp.full_like(T_K, _P_ATM))
    20	
    21	
    22	def bulk_formula_surface_forcing(
    23	    T: jnp.ndarray,
    24	    S: jnp.ndarray,
    25	    z_coord: OceanZStarCoordinate,
    26	    jacobian: jnp.ndarray,
    27	    cfg: BulkFormulaConfig,
    28	) -> SurfaceForcingOutput:
    29	    """Apply bulk formulas for air-sea fluxes.
    30	
    31	    Supports constant coefficients or stability-dependent MOST algorithms
    32	    (COARE 3.0 or Large & Yeager 2004) selected via ``cfg.bulk_scheme``.
    33	
    34	    Parameters
    35	    ----------
    36	    T, S : array (6, n, n, nlev)
    37	    z_coord : OceanZStarCoordinate
    38	    jacobian : array (6, n, n)
    39	    cfg : BulkFormulaConfig
    40	
    41	    Returns
    42	    -------
    43	    SurfaceForcingOutput
    44	    """
    45	    shape_3d = T.shape
    46	    dtype = T.dtype
    47	
    48	    T_s = T[..., 0] + constants.T_freeze  # (6, n, n)
    49	    q_sat = _saturation_specific_humidity(T_s)
    50	
    51	    Q_lw_up = cfg.emissivity * constants.sigma_sb * T_s ** 4
    52	
    53	    if cfg.bulk_scheme in ("coare3", "large_yeager"):
    54	        from legoesm.coupler.bulk_flux import compute_most_fluxes
    55	        # Wind is zonal only (prescribed), zero meridional
    56	        u_a = jnp.full_like(T_s, cfg.U_a, dtype=dtype)
    57	        v_a = jnp.zeros_like(T_s)
    58	        T_a = jnp.full_like(T_s, cfg.T_a, dtype=dtype)
    59	        q_a = jnp.full_like(T_s, cfg.q_a, dtype=dtype)
    60	        rho_a = jnp.full_like(T_s, cfg.rho_a, dtype=dtype)
    61	
    62	        tau_x, tau_y, Q_sh, Q_lh, _ = compute_most_fluxes(
    63	            u_a, v_a, T_a, q_a, T_s, q_sat, rho_a,
    64	            z_ref=cfg.z_ref,
    65	            z0_init=cfg.z0,
    66	            scheme=cfg.bulk_scheme,
    67	            n_iter=cfg.bulk_n_iter,
    68	        )
    69	        # Fluxes are positive upward; stress opposes wind
    70	        tau_x = -tau_x  # flip to positive eastward
    71	    else:
    72	        # Constant coefficients: wind is zonal-only (u_a = U_a, v_a = 0)
    73	        # to match the directional convention used in the MOST path.
    74	        Q_sh = cfg.rho_a * cfg.c_pa * cfg.C_H * cfg.U_a * (T_s - cfg.T_a)
    75	        Q_lh = cfg.rho_a * cfg.L_v * cfg.C_E * cfg.U_a * (q_sat - cfg.q_a)
    76	
    77	        # tau = rho_a * C_D * |U_a| * (u_a, v_a)  — directional stress
    78	        U_a_speed = jnp.abs(cfg.U_a)
    79	        tau_x = jnp.full_like(T_s, cfg.rho_a * cfg.C_D * U_a_speed * cfg.U_a, dtype=dtype)
    80	        tau_y = jnp.zeros_like(T_s)
    81	
    82	    # Net heat flux (positive into ocean)
    83	    Q_net = cfg.SW_down - Q_lw_up + cfg.LW_down - Q_sh - Q_lh
    84	
    85	    # Convert to top-layer tendencies
    86	    dz_0 = z_coord.dz_ref[0] * jacobian
    87	    inv_rho_dz = 1.0 / (rho_0_ref * jnp.maximum(dz_0, 1e-10))
    88	    inv_rho_csw_dz = 1.0 / (rho_0_ref * c_sw * jnp.maximum(dz_0, 1e-10))
    89	
    90	    # Pad with zero on trailing axis instead of alloc-zeros +
    91	    # scatter — single Pad HLO op per field.  Same pattern as the
    92	    # ``prescribed.py`` and ``restoring.py`` rewrites.
    93	    nlev = shape_3d[-1]
    94	    pad_axes = ((0, 0),) * (len(shape_3d) - 1)
    95	    du_dt = jnp.pad(
    96	        (tau_x * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
    97	    )
    98	    dv_dt = jnp.pad(
    99	        (tau_y * inv_rho_dz)[..., None], (*pad_axes, (0, nlev - 1)),
   100	    )
   101	    dT_dt = jnp.pad(
   102	        (Q_net * inv_rho_csw_dz)[..., None], (*pad_axes, (0, nlev - 1)),
   103	    )
   104	    # No freshwater forcing in basic bulk formulation
   105	    dS_dt = jnp.zeros(shape_3d, dtype=dtype)
   106	
   107	    return SurfaceForcingOutput(
   108	        du_dt=du_dt, dv_dt=dv_dt, dT_dt=dT_dt, dS_dt=dS_dt,
   109	        Q_net=Q_net, tau_x=tau_x, tau_y=tau_y,
   110	    )

