    81	    def test_energy_consistency_rayleigh(self):
    82	        """eps_gwd should equal integrated dT_dt * c_p * rho * dz."""
    83	        from legoesm.atmosphere.physics.gravity_wave_drag.rayleigh import rayleigh_gwd
    84	        from legoesm.atmosphere.physics.gravity_wave_drag.config import RayleighConfig
    85	        from legoesm import constants
    86	        u, v, T, p_full, p_half, z_full, z_half, rho, lat = self._make_gwd_inputs()
    87	        out = rayleigh_gwd(u, v, T, p_full, p_half, z_full, z_half, rho, lat,
    88	                           dt=300.0, config=RayleighConfig())
    89	        dz = jnp.abs(z_half[:, :-1] - z_half[:, 1:])
    90	        heating_power = jnp.sum(rho * out.dT_dt * constants.c_pd * dz, axis=1)
    91	        # eps_gwd should match heating power
    92	        assert jnp.allclose(out.eps_gwd, heating_power, rtol=1e-5), \
    93	            f"Energy mismatch: eps_gwd={out.eps_gwd}, heating={heating_power}"
