   194	        out = gray_radiation(T, p_full, p_half, T_sfc, lat, None, insol, config)
   195	        # Net SW at TOA = SW_down(TOA) - SW_up(TOA)
   196	        net_sw_toa = out.sw_flux_down[:, 0] - out.sw_flux_up[:, 0]
   197	        # SW_down at TOA = insolation, SW_up at TOA = alpha * SW_down(sfc)
   198	        expected_sw_up_toa = alpha * out.sw_flux_down[:, -1]
   199	        assert jnp.allclose(out.sw_flux_up[:, 0], expected_sw_up_toa, rtol=1e-5)
