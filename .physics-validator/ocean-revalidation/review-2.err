    26	class TestGWDDissipationSign:
    27	    """eps_gwd must be positive-definite (KE sink)."""
    28	
    29	    def _make_gwd_inputs(self, ncol=4, nlev=20):
    30	        # Use physical profiles: westerly jets that don't reverse direction
    31	        # so that eps_gwd is positive-definite for all schemes.
    32	        u = jnp.broadcast_to(
    33	            jnp.linspace(5.0, 20.0, nlev)[None, :], (ncol, nlev)
    34	        )
    35	        v = jnp.broadcast_to(
    36	            jnp.linspace(2.0, 5.0, nlev)[None, :], (ncol, nlev)
    37	        )
    38	        T = jnp.broadcast_to(
    39	            jnp.linspace(220.0, 280.0, nlev)[None, :], (ncol, nlev)
    40	        )
    41	        p_half = jnp.broadcast_to(
    42	            jnp.linspace(100.0, 101325.0, nlev + 1)[None, :], (ncol, nlev + 1)
    43	        )
    44	        p_full = 0.5 * (p_half[:, :-1] + p_half[:, 1:])
    45	        z_half = jnp.broadcast_to(
    46	            jnp.linspace(30000.0, 0.0, nlev + 1)[None, :], (ncol, nlev + 1)
    47	        )
    48	        z_full = 0.5 * (z_half[:, :-1] + z_half[:, 1:])
    49	        rho = p_full / (287.0 * T)
    50	        lat = jnp.linspace(-jnp.pi / 4, jnp.pi / 4, ncol)
    51	        return u, v, T, p_full, p_half, z_full, z_half, rho, lat
    52	
    53	    def test_rayleigh_eps_positive(self):
