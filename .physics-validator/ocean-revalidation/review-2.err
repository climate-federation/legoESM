     1	"""End-to-end probe: KPP integration B_f sign for freshening vs brine rejection.
     2	
     3	After the integration.py:144 fix:
     4	- Pure freshening (Q_T=0, fw>0)            → B_f < 0 (stabilizing)
     5	- Pure brine rejection (Q_T=0, fw<0)        → B_f > 0 (destabilizing)
     6	- Pure cooling (q_net<0, fw=0)              → B_f > 0 (destabilizing)
     7	- Pure warming (q_net>0, fw=0)              → B_f < 0 (stabilizing)
     8	"""
     9	from __future__ import annotations
    10	
    11	import jax
    12	import jax.numpy as jnp
    13	
    14	from legoesm import constants
    15	from legoesm.ocean.eos import (
    16	    rho_0 as _RHO_0,
    17	    c_sw as _C_SW,
    18	    thermal_expansion_coeff,
    19	    haline_contraction_coeff,
    20	)
    21	
    22	
    23	def compute_B_f(q_net, fw, T_sfc, S_sfc):
    24	    """Replicate the production B_f computation in integration.py."""
    25	    p_sfc = jnp.zeros_like(T_sfc)
    26	
    27	    Q_sfc_T = q_net / (_RHO_0 * _C_SW)
    28	    alpha = thermal_expansion_coeff(T_sfc, S_sfc, p_sfc)
    29	    B_heat = -constants.g * alpha * Q_sfc_T
    30	
    31	    Q_sfc_S = -S_sfc * fw / _RHO_0
    32	    beta = haline_contraction_coeff(T_sfc, S_sfc, p_sfc)
    33	    # FIXED: was -g*beta*Q_sfc_S, should be +g*beta*Q_sfc_S
    34	    B_salt = constants.g * beta * Q_sfc_S
    35	    return B_heat + B_salt, B_heat, B_salt
    36	
    37	
    38	def main() -> None:
    39	    T_sfc = jnp.asarray(20.0)   # degC
    40	    S_sfc = jnp.asarray(35.0)   # PSU
    41	    fail = 0
    42	
    43	    cases = [
    44	        # (q_net, fw, expected B_f sign, label)
    45	        (    0.0,  1e-5, "negative", "Pure freshening (fw>0, q_net=0)"),
    46	        (    0.0, -1e-5, "positive", "Pure brine/evap (fw<0, q_net=0)"),
    47	        ( -100.0,   0.0, "positive", "Pure cooling (q_net<0, fw=0)"),
    48	        ( +100.0,   0.0, "negative", "Pure warming (q_net>0, fw=0)"),
    49	    ]
    50	    for q_net, fw, expect, label in cases:
    51	        B_f, B_h, B_s = compute_B_f(
    52	            jnp.asarray(q_net), jnp.asarray(fw), T_sfc, S_sfc,
    53	        )
    54	        sign = "negative" if float(B_f) < 0 else ("positive" if float(B_f) > 0 else "zero")
    55	        ok = (sign == expect)
    56	        marker = "[PASS]" if ok else "[FAIL]"
    57	        if not ok:
    58	            fail += 1
    59	        print(f"{marker} {label}")
    60	        print(f"       B_heat = {float(B_h):+.3e}, B_salt = {float(B_s):+.3e}, B_f = {float(B_f):+.3e}")
    61	        print(f"       expected sign = {expect}, got {sign}")
    62	        print()
    63	    print(f"TOTAL FAIL: {fail}")
    64	
    65	
    66	if __name__ == "__main__":
    67	    main()
     1	"""Probe: KPP non-local tracer transport column conservation.
     2	
     3	After the codex iter-1 fix (drop the in_bl_full mask, keep only
     4	is_unstable_col), the column-integrated non-local tendency should
     5	sum to zero exactly (within machine precision):
     6	
     7	    sum_k dT_nonlocal[k] * dz[k] = -F_top_flux + F_bot_flux = 0 - 0 = 0
     8	
     9	(zero-flux BCs at surface and bottom).
    10	"""
    11	from __future__ import annotations
    12	
    13	import jax.numpy as jnp
    14	
    15	from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
    16	from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
    17	from legoesm.ocean.eos import wright_eos
    18	from legoesm.ocean.vertical import create_ocean_z_star
    19	
    20	
    21	def main() -> None:
    22	    nlev = 8
    23	    z_coord = create_ocean_z_star(n_levels=nlev, H_max=200.0)
    24	    shape = (6, 2, 2, nlev)
    25	    shape_2d = (6, 2, 2)
    26	
    27	    # Unstable column: cold over warm so it convects.
    28	    T = jnp.broadcast_to(
    29	        jnp.array([2.0, 5.0, 10.0, 15.0, 18.0, 20.0, 22.0, 23.0])[None, None, None, :],
    30	        shape,
    31	    ).astype(jnp.float64)
    32	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
    33	    p = jnp.full(shape, 1e6, dtype=jnp.float64)
    34	    rho = wright_eos(T, S, p)
    35	
    36	    u = jnp.full(shape, 0.05, dtype=jnp.float64)
    37	    v = jnp.zeros(shape, dtype=jnp.float64)
    38	    eta = jnp.zeros(shape_2d, dtype=jnp.float64)
    39	    J = jnp.ones(shape_2d, dtype=jnp.float64)
    40	
    41	    # Strong unstable B_f to ensure non-local is active.
    42	    B_f = jnp.full(shape_2d, 1e-6, dtype=jnp.float64)
    43	    Q_sfc_T = jnp.full(shape_2d, 1e-3, dtype=jnp.float64)  # K m/s
    44	
    45	    # h_bl_prev: pick a value that places the BL boundary INSIDE a layer
    46	    # so the previous mask would have leaked.
    47	    h_bl_prev = jnp.full(shape_2d, 75.0, dtype=jnp.float64)  # mid-column
    48	
    49	    cfg = KPPConfig()
    50	    out = kpp_vertical_mixing(
    51	        u, v, T, S, rho, eta, z_coord, J, cfg,
    52	        B_f=B_f, Q_sfc_T=Q_sfc_T, h_bl_prev=h_bl_prev,
    53	    )
    54	
    55	    # Reproduce the diffusion-only run for subtraction.
    56	    out_no_qsfc = kpp_vertical_mixing(
    57	        u, v, T, S, rho, eta, z_coord, J, cfg,
    58	        B_f=B_f, Q_sfc_T=jnp.zeros(shape_2d), h_bl_prev=h_bl_prev,
    59	    )
    60	
    61	    # The non-local tendency = full - (no Q_T).
    62	    dT_nonlocal = out.dT_dt - out_no_qsfc.dT_dt
    63	
    64	    # Column integral with layer thickness dz_actual = dz_ref * J.
    65	    dz_actual = z_coord.dz_ref * J[..., jnp.newaxis]
    66	    column_integral = jnp.sum(dT_nonlocal * dz_actual, axis=-1)
    67	    max_abs = float(jnp.max(jnp.abs(column_integral)))
    68	    norm = float(jnp.max(jnp.abs(dT_nonlocal)))
    69	    rel = max_abs / max(norm, 1e-30)
    70	    print(f"max|column integral of dT_nonlocal|: {max_abs:.3e}")
    71	    print(f"max|dT_nonlocal|:                    {norm:.3e}")
    72	    print(f"relative drift:                      {rel:.3e}")
    73	    if rel < 1e-12:
    74	        print("[PASS] non-local transport conserves column tracer.")
    75	    else:
    76	        print("[FAIL] non-local transport does NOT conserve column tracer.")
    77	
    78	
    79	if __name__ == "__main__":
    80	    main()
     1	"""Probe: KPP V_t² gradient through sqrt(|N²|) at N²=0.
     2	
     3	The line:
     4	    V_t2 = Cv * sqrt(max(|N²_full|, 0)) / sqrt(...) * ...
     5	
     6	If any layer has exactly N²=0 (rare but possible), the backward
     7	pass evaluates `d sqrt(|0|)/d|0| = inf` chained with `d|0|/d0 = 0`
     8	(JAX subgradient), producing 0*inf = NaN.
     9	
    10	Setup an N²=0 column to test.
    11	"""
    12	from __future__ import annotations
    13	
    14	import jax
    15	import jax.numpy as jnp
    16	
    17	from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
    18	from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
    19	from legoesm.ocean.vertical import create_ocean_z_star
    20	
    21	
    22	def main() -> None:
    23	    nlev = 6
    24	    z_coord = create_ocean_z_star(n_levels=nlev, H_max=1000.0)
    25	    shape = (6, 4, 4, nlev)
    26	    shape_2d = (6, 4, 4)
    27	
    28	    # Density EXACTLY constant in middle layers (N²=0).
    29	    rho = jnp.full(shape, 1029.0, dtype=jnp.float64)
    30	
    31	    T = jnp.full(shape, 15.0, dtype=jnp.float64)
    32	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
    33	    u = jnp.full(shape, 0.1, dtype=jnp.float64)
    34	    v = jnp.zeros(shape, dtype=jnp.float64)
    35	    eta = jnp.zeros(shape_2d, dtype=jnp.float64)
    36	    J = jnp.ones(shape_2d, dtype=jnp.float64)
    37	    cfg = KPPConfig()
    38	
    39	    def loss(rho_in):
    40	        out = kpp_vertical_mixing(u, v, T, S, rho_in, eta, z_coord, J, cfg)
    41	        return jnp.sum(out.dT_dt)
    42	
    43	    g = jax.grad(loss)(rho)
    44	    has_nan = bool(jnp.any(jnp.isnan(g)))
    45	    print(f"Constant-rho column → N²=0 → V_t² formula triggered.")
    46	    print(f"  any NaN in dL/drho: {has_nan}")
    47	    if has_nan:
    48	        print("CONFIRMED: NaN gradient through KPP V_t² at N²=0.")
    49	
    50	
    51	if __name__ == "__main__":
    52	    main()

