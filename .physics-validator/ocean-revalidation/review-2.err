     1	"""Direct unit tests for the entraining mass-flux plume convection scheme.
     2	
     3	Covers the leaf module ``legoesm.ocean.physics.convection.plume`` rather than
     4	the integration factory.  Specifically guards the entrainment formulation
     5	``entrain = 1 - exp(-epsilon * dz)`` against regressions back to the linear
     6	``entrain = epsilon * dz`` form, which can exceed unity for thick layers
     7	and produce an unphysical sign-flip on the plume properties.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import jax
    13	import jax.numpy as jnp
    14	import pytest
    15	
    16	from legoesm.ocean.physics.convection.config import PlumeConfig
    17	from legoesm.ocean.physics.convection.plume import plume_convection
    18	from legoesm.ocean.vertical import create_ocean_z_star
    19	
    20	
    21	def _build_state(n_levels: int = 8, H_max: float = 4000.0,
    22	                 surface_unstable: bool = True):
    23	    """Tiny synthetic 6-face cubed-sphere column at realistic magnitudes."""
    24	    z = create_ocean_z_star(n_levels=n_levels, H_max=H_max)
    25	    shape = (6, 4, 4, n_levels)
    26	
    27	    # Linear T profile from 18 °C at surface to 2 °C at depth.
    28	    T_profile = jnp.linspace(18.0, 2.0, n_levels)
    29	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
    30	    if surface_unstable:
    31	        # Cold dense water on top → plume should descend.
    32	        T = T.at[..., 0].set(1.0)
    33	
    34	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
    35	
    36	    # Crude linear-EOS density consistent with T (alpha ~2e-4):
    37	    rho = 1025.0 - 0.2 * (T - 4.0)
    38	    p = jnp.cumsum(
    39	        jnp.broadcast_to(jnp.linspace(0.0, 4.0e7, n_levels), shape),
    40	        axis=-1,
    41	    )
    42	    J = jnp.ones((6, 4, 4), dtype=jnp.float64)
    43	    return T, S, rho, p, z, J
    44	
    45	
    46	def test_plume_outputs_finite_and_signs_consistent():
    47	    """Surface-unstable column: tendencies are finite and surface row is zero."""
    48	    T, S, rho, p, z, J = _build_state(surface_unstable=True)
    49	    cfg = PlumeConfig()
    50	
    51	    out = plume_convection(T, S, rho, p, z, J, cfg)
    52	
    53	    assert jnp.all(jnp.isfinite(out.dT_dt))
    54	    assert jnp.all(jnp.isfinite(out.dS_dt))
    55	    assert jnp.all(jnp.isfinite(out.convection_flag))
    56	
    57	    # Surface level is the plume launch — no detrainment tendency there.
    58	    assert float(jnp.max(jnp.abs(out.dT_dt[..., 0]))) == 0.0
    59	    assert float(jnp.max(jnp.abs(out.dS_dt[..., 0]))) == 0.0
    60	
    61	    # Convection flag is in [0, 1].
    62	    flag_min = float(jnp.min(out.convection_flag))
    63	    flag_max = float(jnp.max(out.convection_flag))
    64	    assert 0.0 <= flag_min <= 1.0
    65	    assert 0.0 <= flag_max <= 1.0
    66	
    67	
    68	def test_plume_zero_when_stable():
    69	    """Stably stratified column: plume should not be active."""
    70	    T, S, rho, p, z, J = _build_state(surface_unstable=False)
    71	    cfg = PlumeConfig()
    72	
    73	    out = plume_convection(T, S, rho, p, z, J, cfg)
    74	
    75	    # No surface instability → plume inactive everywhere.
    76	    assert float(jnp.max(jnp.abs(out.dT_dt))) == 0.0
    77	    assert float(jnp.max(jnp.abs(out.dS_dt))) == 0.0
    78	    assert float(jnp.max(out.convection_flag)) == 0.0
    79	
    80	
    81	def test_plume_entrainment_uses_exact_not_linear_form():
    82	    """Sharp regression guard: ``-expm1(-eps*dz)`` vs ``eps*dz``.
    83	
    84	    For a cold dense surface (5 °C) above a warm sub-surface (20 °C) with
    85	    ``eps=1e-3`` and a layer thickness ``dz_1 ≈ 1048 m`` (so ``eps*dz_1
    86	    ≈ 1.05``), the two entrainment formulas produce **opposite signs** for
    87	    the detrainment tendency at the first descent step.
    88	
    89	    With the corrected units fix (``dT/dt = w_p * alpha * eps * (T_p -
    90	    T_env)``, codex iter-1 finding #2), the expected magnitude is
    91	    ``w_p * alpha * eps * dT ~ 0.01 * 0.1 * 1e-3 * 10 K ~ 1e-5 K/s``.
    92	
    93	    * Exact form: ``T_plume`` after entrainment ≈ 14.8 °C (cooler than
    94	      ``T_env=20``), so ``dT_dt[k=1] < 0`` (env cools toward plume).
    95	    * Linear form: ``(1 - eps*dz)`` is ``-0.05`` so the plume's prior
    96	      temperature is *subtracted*, giving ``T_plume`` slightly *warmer*
    97	      than env, and ``dT_dt[k=1] > 0`` (wrong sign).
    98	
    99	    Asserting ``dT_dt[..., 1] < 0`` distinguishes the two.
   100	    """
   101	    nlev = 4
   102	    H_max = 6000.0  # → dz_ref[1] ≈ 1048 m, so eps*dz_1 ≈ 1.05 with eps=1e-3
   103	    z = create_ocean_z_star(n_levels=nlev, H_max=H_max)
   104	    shape = (6, 2, 2, nlev)
   105	
   106	    # Cold dense surface above warmer sub-surface.  Surface is unstable
   107	    # (rho_0 > rho_1) so the plume launches.  Sub-surface is sufficiently
   108	    # warmer that entrainment of T_env strongly heats the plume — but
   109	    # under the exact form the plume stays cooler than env.
   110	    T_profile = jnp.array([5.0, 20.0, 18.0, 16.0])
   111	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
   112	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
   113	    rho = 1025.0 - 0.2 * (T - 4.0)
   114	    p = jnp.cumsum(
   115	        jnp.broadcast_to(jnp.linspace(0.0, 6.0e7, nlev), shape), axis=-1,
   116	    )
   117	    J = jnp.ones((6, 2, 2), dtype=jnp.float64)
   118	
   119	    cfg = PlumeConfig(epsilon=1e-3)
   120	    out = plume_convection(T, S, rho, p, z, J, cfg)
   121	
   122	    # Bounded: tendencies are finite even though eps*dz_1 > 1 — the linear
   123	    # form would also produce finite (but sign-flipped) values, so this is
   124	    # a sanity floor, not a discriminator.
   125	    assert jnp.all(jnp.isfinite(out.dT_dt))
   126	    assert jnp.all(jnp.isfinite(out.dS_dt))
   127	
   128	    # Sharp discriminator: at the first descent step (level k=1) the plume
   129	    # is cooler than the environment under the exact form; the linear
   130	    # form's sign-flip makes the plume artificially *warmer* than env.
   131	    # Tolerance: with w_p*alpha*eps = 1e-6 1/s and dT ~ 5 K, expected
   132	    # |dT_dt| ~ 5e-6 K/s.  Lower bound 1e-7 rules out trivial near-zero;
   133	    # upper bound 1e-4 rules out unphysical magnitudes.
   134	    dT_at_first_step = float(out.dT_dt[..., 1].mean())
   135	    assert dT_at_first_step < -1e-7, (
   136	        f"dT_dt at first descent step is {dT_at_first_step:.3e}; expected "
   137	        "a clearly negative value (~ -5e-6) under the exact "
   138	        "1 - exp(-eps*dz) entrainment.  A positive or near-zero value "
   139	        "indicates regression to the linear ``eps*dz`` form."
   140	    )
   141	    assert dT_at_first_step > -1e-4, (
   142	        f"dT_dt at first descent step is {dT_at_first_step:.3e}; "
   143	        "magnitude is unphysically large for cfg.w_plume_min=0.01, "
   144	        "alpha_plume=0.1, eps=1e-3, |T_plume - T_env| ~ 5 K."
   145	    )
   146	
   147	
   148	def test_plume_gradient_flows():
   149	    """``jax.grad`` through plume_convection produces finite, nonzero grads."""
   150	    T, S, rho, p, z, J = _build_state(surface_unstable=True)
   151	    cfg = PlumeConfig()
   152	
   153	    def loss(T_in):
   154	        out = plume_convection(T_in, S, rho, p, z, J, cfg)
   155	        return jnp.sum(out.dT_dt ** 2)
   156	
   157	    g = jax.grad(loss)(T)
   158	    assert jnp.all(jnp.isfinite(g))
   159	    # At least some sensitivity below the surface — surface row may be zero
   160	    # but k>0 levels should respond to environmental T perturbations.
   161	    assert float(jnp.max(jnp.abs(g[..., 1:]))) > 0.0
   162	
   163	
   164	@pytest.mark.parametrize("eps", [1e-4, 1e-3, 5e-3])
   165	def test_plume_finite_across_eps_regimes(eps):
   166	    """Sanity floor: tendencies are finite across a span of ``eps*dz``.
   167	
   168	    This is a *finiteness* check across entrainment regimes (``eps*dz``
   169	    ranging from ~0.025 to ~1.25 with the chosen layering), not a
   170	    correctness check on the entrainment form itself — the linear form
   171	    also produces finite (but sign-flipped) values.  The actual form
   172	    discrimination lives in
   173	    ``test_plume_entrainment_uses_exact_not_linear_form``.
   174	    """
   175	    nlev = 6
   176	    H_max = 1500.0  # dz_ref ~ 250 m → eps*dz spans 0.025 to 1.25
   177	    z = create_ocean_z_star(n_levels=nlev, H_max=H_max)
   178	    shape = (6, 2, 2, nlev)
   179	    T_profile = jnp.linspace(18.0, 2.0, nlev)
   180	    T = jnp.broadcast_to(T_profile, shape).astype(jnp.float64)
   181	    T = T.at[..., 0].set(1.0)
   182	    S = jnp.full(shape, 35.0, dtype=jnp.float64)
   183	    rho = 1025.0 - 0.2 * (T - 4.0)
   184	    p = jnp.cumsum(
   185	        jnp.broadcast_to(jnp.linspace(0.0, 1.5e7, nlev), shape), axis=-1,
   186	    )
   187	    J = jnp.ones((6, 2, 2), dtype=jnp.float64)
   188	
   189	    cfg = PlumeConfig(epsilon=eps)
   190	    out = plume_convection(T, S, rho, p, z, J, cfg)
   191	
   192	    assert jnp.all(jnp.isfinite(out.dT_dt))
   193	    assert jnp.all(jnp.isfinite(out.dS_dt))
   194	    assert jnp.all(jnp.isfinite(out.convection_flag))

