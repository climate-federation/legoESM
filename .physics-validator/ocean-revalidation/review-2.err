    38	def _make_setup(n=4, nlev=10):
    39	    grid = create_cubed_sphere(n)
    40	    z_coord = create_ocean_z_star(n_levels=nlev, H_max=1000.0)
    41	    shape = (6, n, n, nlev)
    42	    jacobian = jnp.ones((6, n, n))
    43	    return grid, z_coord, jacobian, shape
    44	
    45	
    46	def _stratified_fields(n=4, nlev=10, slope=1e-4):
    47	    """Meridionally tilted isopycnals with uniform stratification.
    48	
    49	    Builds a density field whose mean vertical gradient is set so that
    50	    ``N² ≈ g·(ρ(top)-ρ(bottom))/(H·ρ_0)`` is a sensible 1e-5 s⁻², then
    51	    adds a horizontal component matching the requested slope.
    52	    """
    53	    grid, z_coord, jacobian, shape = _make_setup(n=n, nlev=nlev)
    54	    # Vertical profile: 1025 at surface -> 1027 at bottom, so rho[0] < rho[-1]
    55	    # giving N² > 0.  compute_buoyancy_frequency uses +(g/ρ₀)·|drho/dz|.
    56	    rho_z = jnp.linspace(1025.0, 1027.0, nlev)
    57	    # Add a meridional gradient proportional to latitude index.  At slope
    58	    # = 1e-4 and dρ/dz ≈ 2/H, horizontal gradient ≈ slope × dρ/dz.
    59	    dz_full = z_coord.dz_ref
    60	    H_total = float(jnp.sum(dz_full))
    61	    drho_dz = 2.0 / H_total
    62	    drho_dh = slope * drho_dz
    63	
    64	    # Build a density field with a zonal gradient along the first axis of
    65	    # each face (arbitrary but nonzero).  Broadcasting gives (6,n,n,nlev).
    66	    n_ax = shape[1]
    67	    grad_h = drho_dh * jnp.arange(n_ax, dtype=jnp.float64)
    68	    rho = (rho_z[None, None, None, :]
    69	           + grad_h[None, :, None, None]
    70	           + jnp.zeros(shape, dtype=jnp.float64))
    71	
    72	    T = jnp.broadcast_to(
    73	        jnp.linspace(20.0, 5.0, nlev)[None, None, None, :], shape,
    74	    )
    75	    S = jnp.ones(shape) * 35.0
    76	    u = jnp.zeros(shape)
    77	    v = jnp.zeros(shape)
    78	    return grid, z_coord, jacobian, shape, u, v, T, S, rho
    79	
