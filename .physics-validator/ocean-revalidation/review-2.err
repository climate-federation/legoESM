   556	    def test_lmo_sign_preserved_near_zero_bf(self):
   557	        """L_MO sign is preserved for small negative B_f (issue #168 bug 1).
   558	
   559	        Before the fix, jnp.where(abs(B_f) > eps, B_f, eps) would
   560	        substitute +eps for small-negative B_f, flipping the stability
   561	        classification.
   562	        """
   563	        from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
   564	        from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
   565	        u, v, T, S, rho, eta, z_coord, J = self._make_kpp_inputs()
   566	        cfg = KPPConfig()
   567	
   568	        # Small negative B_f (barely stable): should NOT be classified as unstable
   569	        B_f_neg = -1e-12 * jnp.ones((6, 4, 4))
   570	        out_neg = kpp_vertical_mixing(u, v, T, S, rho, eta, z_coord, J, cfg, B_f=B_f_neg)
   571	
   572	        # Small positive B_f (barely unstable): should have nonlocal active
   573	        B_f_pos = 1e-12 * jnp.ones((6, 4, 4))
   574	        out_pos = kpp_vertical_mixing(u, v, T, S, rho, eta, z_coord, J, cfg, B_f=B_f_pos)
   575	
   576	        # Both must be finite
   577	        assert jnp.all(jnp.isfinite(out_neg.dT_dt))
   578	        assert jnp.all(jnp.isfinite(out_pos.dT_dt))
   579	
   580	        # The tendencies should differ (nonlocal active for unstable, not stable)
   581	        diff = float(jnp.max(jnp.abs(out_pos.dT_dt - out_neg.dT_dt)))
   582	        assert diff > 0, "B_f sign flip: stable and unstable produced identical output"
