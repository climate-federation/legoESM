   123	class TestVisbeckCoefficient:
   124	    def test_shape_one_per_column(self):
   125	        grid, z_coord, jacobian, shape, u, v, T, S, rho = _stratified_fields()
   126	        S_x, S_y, _ = _compute_tapered_slopes(
