   202	    def test_realistic_magnitude(self):
   203	        """κ for realistic (N, S, L_ρ) is O(1e2–1e3) m²/s.
   204	
   205	        Regression against a codex-caught bug where the buoyancy frequency
   206	        was computed with ``rho_ref=1`` instead of ``ρ₀≈1025``, which
   207	        inflated N² (and therefore κ) by ~10³ and saturated the ceiling.
   208	        Pass slope fields directly (rather than building a density
   209	        profile) so the numerics aren't confounded by grid geometry.
   210	        """
   211	        grid, z_coord, jacobian, shape = _make_setup(n=4, nlev=10)
   212	        # Density profile: Δρ = 2 kg/m³ over 1000 m → N² ≈ 1.9e-5,
   213	        # giving N ≈ 4.4e-3 s⁻¹ for ρ₀ = 1025.
   214	        rho = jnp.broadcast_to(
   215	            jnp.linspace(1025.0, 1027.0, shape[-1])[None, None, None, :],
   216	            shape,
   217	        )
   218	        S_mag = 1.0e-3   # 1 m per 1000 m — Southern Ocean frontal scale
   219	        S_x = jnp.full(shape[:-1] + (shape[-1] - 1,), S_mag)
   220	        S_y = jnp.zeros_like(S_x)
   221	        cfg = VisbeckConfig(enabled=True, alpha=0.015,
   222	                            kappa_min=1.0, kappa_max=1.0e6)
   223	        kappa = compute_visbeck_kappa_gm(
   224	            rho, S_x, S_y, z_coord, jacobian,
   225	            jnp.asarray(grid.grid_coriolis), cfg)
   226	        k_max = float(jnp.max(kappa))
   227	        k_mean = float(jnp.mean(kappa))
   228	        # With ρ₀=1025 and S=1e-3, analytical κ ≈ α·L²·N·S is O(100).
   229	        # The rho_ref=1 bug would inflate κ by ~10³ to >1e5.
   230	        assert 1.0 < k_mean < 1.0e4, (
   231	            f"κ_mean={k_mean:.3g} is outside the realistic [1, 1e4] m²/s "
