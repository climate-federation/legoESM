   630	    def test_w_s_suppressed_in_stable_conditions(self):
   631	        """In stable forcing (B_f<0), the turbulent velocity scale w_s
   632	        must be suppressed by phi_m = 1 + 5*|zeta|, NOT remain at the
   633	        unsuppressed value kappa*u_star.
   634	
   635	        Convention used here: ``B_f > 0 = unstable``.  Then
   636	        ``L_MO = u*^3/(kappa*B_f) < 0`` for stable, and
   637	        ``zeta = d/L_MO < 0`` for stable.  An earlier version used
   638	        ``max(zeta, 0)`` which always returned 0 in stable conditions,
   639	        disabling the suppression entirely.  Fixed to ``max(-zeta, 0)``.
   640	
   641	        Codex adversarial review iter-1, finding #4.
   642	        """
   643	        from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
   644	        from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
   645	        u, v, T, S, rho, eta, z_coord, J = self._make_kpp_inputs()
   646	
   647	        # Match-magnitude probes: same |B_f|, opposite signs.
   648	        B_f_stable = jnp.full((6, 4, 4), -1e-6, dtype=jnp.float64)
   649	        B_f_unstable = jnp.full((6, 4, 4), 1e-6, dtype=jnp.float64)
   650	        cfg = KPPConfig()
   651	
   652	        out_s = kpp_vertical_mixing(u, v, T, S, rho, eta, z_coord, J, cfg, B_f=B_f_stable)
   653	        out_u = kpp_vertical_mixing(u, v, T, S, rho, eta, z_coord, J, cfg, B_f=B_f_unstable)
   654	
   655	        # Stable boundary layer should mix LESS than unstable
   656	        # at the same |B_f|.  K_v inside the BL = h_bl * w_s * G, so
   657	        # K_v_stable.max() < K_v_unstable.max() if w_s suppression is
   658	        # active.
   659	        K_v_stable_max = float(jnp.max(out_s.K_v))
   660	        K_v_unstable_max = float(jnp.max(out_u.K_v))
   661	        # Unstable should have at least 1.5x more max K_v than stable.
   662	        # Under the bug (no suppression), the two are nearly identical.
   663	        ratio = K_v_unstable_max / max(K_v_stable_max, 1e-30)
   664	        assert ratio > 1.2, (
   665	            f"Stable BL mixes too aggressively: K_v_stable_max="
   666	            f"{K_v_stable_max:.3e}, K_v_unstable_max={K_v_unstable_max:.3e}, "
   667	            f"ratio={ratio:.2f}.  Stable suppression formula likely "
   668	            f"degenerated to no-op (max(zeta_kpp, 0) bug)."
   669	        )
