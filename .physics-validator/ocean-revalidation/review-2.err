     1	"""LMD94-style K-Profile Parameterization (KPP).
     2	
     3	Boundary-layer parameterization following Large, McWilliams & Doney (1994)
     4	with:
     5	
     6	- Bulk Richardson number BL-depth diagnosis with linear interpolation
     7	  of the crossing depth between model levels.
     8	- Turbulent velocity scales w_s(sigma) from surface forcing (u_star, B_f).
     9	- Cubic shape function G(sigma) = sigma * (1 - sigma)^2.
    10	- Non-local tracer transport for unstable (convective) conditions only.
    11	- Interior mixing: Richardson-number dependent + convective instability
    12	  enhancement for statically unstable layers below the BL.
    13	
    14	The caller should provide surface wind stress and buoyancy flux when
    15	available.  If tau_x/tau_y are None, a simplified u_star proxy from
    16	surface speed is used.
    17	
    18	References
    19	----------
    20	- Large, W. G., McWilliams, J. C., & Doney, S. C. (1994). Oceanic
    21	  vertical mixing: A review and a model with a nonlocal boundary layer
    22	  parameterization. Rev. Geophys., 32, 363-403.
    23	"""
    24	
    25	from __future__ import annotations
    26	
    27	import jax
    28	import jax.numpy as jnp
    29	
    30	from legoesm import constants
    31	from legoesm.ocean.eos import (
    32	    wright_eos,
    33	    compute_buoyancy_frequency,
    34	    compute_hydrostatic_pressure,
    35	    rho_0 as rho_0_ref,
    36	)
    37	from legoesm.ocean.physics.mixing import vertical_diffusion_variable_K
    38	from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
    39	from legoesm.ocean.physics.vertical_mixing.output import VerticalMixingOutput
    40	from legoesm.ocean.vertical import OceanZStarCoordinate
    41	
    42	_EPS = float(jnp.finfo(jnp.float32).eps)  # Float32 machine epsilon (~1.19e-7)
    43	
    44	
    45	def _boundary_layer_depth(
    46	    rho: jnp.ndarray,
    47	    u: jnp.ndarray,
    48	    v: jnp.ndarray,
    49	    z_coord: OceanZStarCoordinate,
    50	    jacobian: jnp.ndarray,
    51	    u_star: jnp.ndarray,
    52	    B_f: jnp.ndarray,
    53	    cfg: KPPConfig,
    54	    g: float = constants.g,
    55	    h_bl_prev: jnp.ndarray | None = None,
    56	) -> jnp.ndarray:
    57	    """Estimate boundary layer depth h via bulk Richardson number.
    58	
    59	    Uses linear interpolation to find the depth where Ri_b crosses
    60	    Ri_crit, rather than snapping to the nearest model level.
    61	
    62	    Returns shape (...) boundary layer depth [m, positive downward].
    63	    """
    64	    eps = _EPS
    65	    nlev = rho.shape[-1]
    66	
    67	    dz_actual = z_coord.dz_ref * jacobian[..., jnp.newaxis]
    68	    # Depth of cell centers below surface (positive downward)
    69	    z_depth = jnp.cumsum(dz_actual, axis=-1) - 0.5 * dz_actual
    70	
    71	    # Density and velocity differences from surface
    72	    delta_rho = rho - rho[..., :1]
    73	    delta_u = u - u[..., :1]
    74	    delta_v = v - v[..., :1]
    75	    delta_V2 = delta_u**2 + delta_v**2
    76	
    77	    # LMD94 Eq. 23: V_t^2 = Cv * sqrt(|N2|) / sqrt(c_s * epsilon) *
    78	    #   max(Ri_crit * h - d, 0) * d / h
    79	    # Uses h_bl from the previous time step to break the coupling.
    80	    N2 = compute_buoyancy_frequency(rho, z_coord.dz_ref, jacobian)
    81	    N2_full = jnp.concatenate([N2[..., :1], N2], axis=-1)
    82	    max_depth = z_depth[..., -1]
    83	    h_est = max_depth if h_bl_prev is None else h_bl_prev
    84	    h_safe = jnp.maximum(h_est[..., jnp.newaxis], eps)
    85	    # ``sqrt(0)`` has an infinite backward derivative; combined with
    86	    # ``maximum(., 0)`` whose VJP is zero on the masked side, JAX
    87	    # produces ``0 * inf = NaN``.  Use a tiny positive floor instead
    88	    # so the gradient is finite (very large) and gets multiplied by
    89	    # zero through ``maximum`` to a well-defined zero.  Forward
    90	    # error is at most ``sqrt(1e-30) ≈ 1e-15``, negligible.
    91	    V_t2 = (cfg.Cv * jnp.sqrt(jnp.maximum(jnp.abs(N2_full), 1e-30))
    92	            / jnp.sqrt(jnp.maximum(cfg.c_s * cfg.epsilon_lmd, eps))
    93	            * jnp.maximum(cfg.Ri_crit * h_safe - z_depth, 0.0)
    94	            * z_depth / h_safe)
    95	
    96	    # Bulk Richardson number
    97	    Ri_b = (g * delta_rho * z_depth) / (
    98	        rho_0_ref * jnp.maximum(delta_V2 + V_t2, eps)
    99	    )
   100	
   101	    # --- Differentiable soft interpolation of crossing depth ---
   102	    # Instead of argmax (non-differentiable), use a sigmoid-weighted
   103	    # average over all levels.  Each level contributes a weight
   104	    # proportional to how much Ri_b crosses Ri_crit there.
   105	    #
   106	    # Weight at level k = sigmoid(sharpness * (Ri_b[k] - Ri_crit))
   107	    #                    - sigmoid(sharpness * (Ri_b[k-1] - Ri_crit))
   108	    # This is ~1 at the crossing level and ~0 elsewhere.
   109	    sharpness = cfg.crossing_sharpness
   110	    sig = jax.nn.sigmoid(sharpness * (Ri_b - cfg.Ri_crit))  # (..., nlev)
   111	
   112	    # Crossing weight: difference of adjacent sigmoid values.  ``jnp.pad``
   113	    # along the trailing axis is one HLO op; the previous
   114	    # ``concatenate([zeros_like(sig[..., :1]), sig[..., :-1]])`` allocated
   115	    # a fresh zero buffer and concatenated.
   116	    pad_axes = ((0, 0),) * (sig.ndim - 1)
   117	    sig_prev = jnp.pad(sig[..., :-1], (*pad_axes, (1, 0)))
   118	    w_cross = sig - sig_prev  # (..., nlev), peaks at crossing level
   119	    w_cross = jnp.maximum(w_cross, 0.0)
   120	    w_sum = jnp.sum(w_cross, axis=-1, keepdims=True)
   121	    w_norm = w_cross / jnp.maximum(w_sum, eps)
   122	
   123	    # Crossing-based depth estimate
   124	    h_crossing = jnp.sum(w_norm * z_depth, axis=-1)  # (...)
   125	
   126	    # Fallback for columns where Ri_b never crosses Ri_crit:
   127	    # - If column is mostly unstable (sig ≈ 0): BL extends to full depth
   128	    # - If column is mostly stable (sig ≈ 1): BL is one layer
   129	    column_stability = jnp.mean(sig, axis=-1)  # 0 = all unstable, 1 = all stable
   130	    max_depth = z_depth[..., -1]
   131	    min_depth = dz_actual[..., 0]
   132	    h_fallback = (1.0 - column_stability) * max_depth + column_stability * min_depth
   133	
   134	    # Blend: use crossing depth when crossing signal is strong, fallback otherwise
   135	    crossing_strength = w_sum[..., 0]
   136	    blend = jax.nn.sigmoid(cfg.crossing_sharpness * (crossing_strength - cfg.crossing_threshold))
   137	    h = blend * h_crossing + (1.0 - blend) * h_fallback
   138	
   139	    # At least one layer thick
   140	    h = jnp.maximum(h, dz_actual[..., 0])
   141	
   142	    return h
   143	
   144	
   145	def kpp_vertical_mixing(
   146	    u: jnp.ndarray,
   147	    v: jnp.ndarray,
   148	    T: jnp.ndarray,
   149	    S: jnp.ndarray,
   150	    rho: jnp.ndarray,
   151	    eta: jnp.ndarray,
   152	    z_coord: OceanZStarCoordinate,
   153	    jacobian: jnp.ndarray,
   154	    cfg: KPPConfig,
   155	    g: float = constants.g,
   156	    tau_x: jnp.ndarray | None = None,
   157	    tau_y: jnp.ndarray | None = None,
   158	    B_f: jnp.ndarray | None = None,
   159	    Q_sfc_T: jnp.ndarray | None = None,
   160	    Q_sfc_S: jnp.ndarray | None = None,
   161	    h_bl_prev: jnp.ndarray | None = None,
   162	) -> VerticalMixingOutput:
   163	    """Apply LMD94-style KPP vertical mixing.
   164	
   165	    Parameters
   166	    ----------
   167	    u, v : array (6, n, n, nlev)
   168	    T, S : array (6, n, n, nlev)
   169	    rho : array (6, n, n, nlev)
   170	    eta : array (6, n, n)
   171	    z_coord : OceanZStarCoordinate
   172	    jacobian : array (6, n, n)
   173	    cfg : KPPConfig
   174	    g : float
   175	    tau_x, tau_y : array (6, n, n) or None
   176	        Surface wind stress [Pa]. If None, a proxy from surface speed is used.
   177	    B_f : array (6, n, n) or None
   178	        Surface buoyancy flux [m^2/s^3], positive = destabilizing (convective).
   179	        If None, estimated from surface density gradient.
   180	    Q_sfc_T : array (6, n, n) or None
   181	        Surface kinematic heat flux [K*m/s] for non-local transport (LMD94
   182	        Eq. 19).  If None, falls back to diagnosed K_sfc * dT/dz proxy.
   183	    Q_sfc_S : array (6, n, n) or None
   184	        Surface kinematic salt flux [PSU*m/s]. Same convention as Q_sfc_T.
   185	    h_bl_prev : array (6, n, n) or None
   186	        BL depth from the previous time step [m, positive downward].
   187	        Used to break the implicit V_t-h_bl coupling in the Ri_b diagnosis
   188	        (LMD94 Eq. 23).  If None, uses the full column depth as estimate.
   189	
   190	    Returns
   191	    -------
   192	    VerticalMixingOutput
   193	    """
   194	    eps = _EPS
   195	    nlev = u.shape[-1]
   196	
   197	    # --- Friction velocity ---
   198	    if tau_x is not None and tau_y is not None:
   199	        # Proper u_star from wind stress: u_star = sqrt(|tau| / rho_0)
   200	        tau_mag = jnp.sqrt(tau_x**2 + tau_y**2 + eps)
   201	        u_star = jnp.sqrt(tau_mag / rho_0_ref)
   202	    else:
   203	        # Simplified proxy: u_star ~ 0.01 * |U_surface|
   204	        speed_sfc = jnp.sqrt(u[..., 0]**2 + v[..., 0]**2 + eps)
   205	        u_star = jnp.maximum(speed_sfc * 0.01, 1e-4)
   206	
   207	    # --- Surface buoyancy flux ---
   208	    dz_actual = z_coord.dz_ref * jacobian[..., jnp.newaxis]
   209	    dz_half0 = 0.5 * (dz_actual[..., 0] + dz_actual[..., 1])
   210	    if B_f is None:
   211	        # Diffusive proxy from near-surface density gradient.  The KPP
   212	        # convention here is ``B_f > 0 = unstable``, so the proxy must
   213	        # be POSITIVE when the surface layer is statically unstable
   214	        # (i.e. ``rho[0] > rho[1]`` ⇒ ``drho_dz_sfc > 0`` ⇒
   215	        # ``B_f > 0``).  An earlier version had a leading minus sign
   216	        # which inverted the sign and made stable columns spuriously
   217	        # trigger non-local transport.
   218	        drho_dz_sfc = (rho[..., 0] - rho[..., 1]) / jnp.maximum(dz_half0, eps)
   219	        B_f = g / rho_0_ref * cfg.K_bg * drho_dz_sfc  # simplified proxy
   220	
   221	    # --- Boundary layer depth ---
   222	    h_bl = _boundary_layer_depth(
   223	        rho, u, v, z_coord, jacobian, u_star, B_f, cfg, g,
   224	        h_bl_prev=h_bl_prev,
   225	    )
   226	
   227	    # --- Depth coordinate ---
   228	    z_depth = jnp.cumsum(dz_actual, axis=-1) - 0.5 * dz_actual
   229	    sigma = z_depth / jnp.maximum(h_bl[..., jnp.newaxis], eps)
   230	
   231	    # --- Shape function G(sigma) = sigma * (1 - sigma)^2 ---
   232	    sigma_clip = jnp.clip(sigma, 0.0, 1.0)
   233	    G = sigma_clip * (1.0 - sigma_clip) ** 2
   234	
   235	    # --- Turbulent velocity scale w_s(sigma) (LMD94 Appendix B) ---
   236	    # w_s depends on stability (B_f) and depth d = sigma * h_bl
   237	    d = sigma_clip * h_bl[..., jnp.newaxis]
   238	    # Monin-Obukhov length: L_MO = u_star^3 / (kappa * B_f)
   239	    # Use copysign(eps, B_f) to preserve the sign of B_f near zero,
   240	    # preventing a stability classification flip (issue #168 bug 1).
   241	    B_f_safe = jnp.where(
   242	        jnp.abs(B_f[..., jnp.newaxis]) > eps,
   243	        B_f[..., jnp.newaxis],
   244	        jnp.copysign(eps, B_f[..., jnp.newaxis]),
   245	    )
   246	    L_MO = u_star[..., jnp.newaxis]**3 / (cfg.kappa_vk * B_f_safe)
   247	    zeta_kpp = d / L_MO
   248	
   249	    # LMD94 Appendix B turbulent velocity scales:
   250	    # Stable (B_f <= 0): w_s = kappa * u_star / (1 + 5*zeta)
   251	    # Unstable, weakly (epsilon*d < |L|): w_s = kappa * u_star * phi_m^{-1}
   252	    #   where phi_m^{-1} = (1 - 16*zeta)^{1/4}
   253	    # Unstable, strongly convective (epsilon*d > |L|):
   254	    #   w_s = (kappa * (u_star^3 + c_b * kappa * (-B_f) * d))^{1/3}
   255	    is_unstable = B_f[..., jnp.newaxis] > 0.0
   256	    epsilon_lmd = cfg.epsilon_lmd
   257	
   258	    # Weakly unstable: phi_m^{-1} formulation
   259	    w_s_weak = (cfg.kappa_vk * u_star[..., jnp.newaxis]
   260	                * jnp.power(jnp.maximum(1.0 + 16.0 * jnp.abs(zeta_kpp), 1.0), 0.25))
   261	
   262	    # Strongly convective: includes convective velocity scale
   263	    Bf_pos = jnp.maximum(B_f[..., jnp.newaxis], 0.0)
   264	    w_s_conv = jnp.power(
   265	        cfg.kappa_vk * (u_star[..., jnp.newaxis]**3
   266	                        + cfg.c_b * cfg.kappa_vk * Bf_pos * d),
   267	        1.0 / 3.0,
   268	    )
   269	
   270	    # Transition: use convective scale when epsilon*d > |L_MO|
   271	    is_strongly_convective = epsilon_lmd * d > jnp.abs(L_MO)
   272	    w_s_unstable = jnp.where(is_strongly_convective, w_s_conv, w_s_weak)
   273	
   274	    # Stable suppression: ``phi_m = 1 + 5*|zeta|`` for |zeta| > 0 in the
   275	    # classical Monin-Obukhov convention.  Under the sign convention
   276	    # used here (B_f > 0 = unstable), ``L_MO = u*^3 / (kappa * B_f)``
   277	    # is NEGATIVE for stable forcing, so ``zeta_kpp = d / L_MO < 0`` for
   278	    # stable.  The previous form ``max(zeta_kpp, 0)`` always returned
   279	    # zero in stable conditions and disabled the suppression entirely.
   280	    # Use ``max(-zeta_kpp, 0)`` so the magnitude of zeta drives the
   281	    # stable suppression (codex adversarial review iter-1, finding #4).
   282	    w_s_stable = (cfg.kappa_vk * u_star[..., jnp.newaxis]
   283	                  / jnp.maximum(1.0 + 5.0 * jnp.maximum(-zeta_kpp, 0.0), 1.0))
   284	    w_s = jnp.where(is_unstable, w_s_unstable, w_s_stable)
   285	    w_s = jnp.maximum(w_s, 1e-10)
   286	
   287	    # --- BL diffusivity at full levels ---
   288	    K_bl_full = h_bl[..., jnp.newaxis] * w_s * G
   289	    K_bl_full = jnp.minimum(K_bl_full, cfg.K_max)
   290	
   291	    # --- Interior mixing: Richardson-number dependent ---
   292	    N2 = compute_buoyancy_frequency(rho, z_coord.dz_ref, jacobian)
   293	    dz_half = 0.5 * (dz_actual[..., :-1] + dz_actual[..., 1:])
   294	    du = u[..., :-1] - u[..., 1:]
   295	    dv = v[..., :-1] - v[..., 1:]
   296	    S2 = (du**2 + dv**2) / jnp.maximum(dz_half**2, eps)
   297	    Ri_int = N2 / jnp.maximum(S2, eps)
   298	    # LMD94 interior shear instability: K = K_0 * (1 - (Ri/Ri_0)^2)^3
   299	    # for Ri < Ri_0, zero above.
   300	    Ri_ratio = jnp.clip(Ri_int / cfg.Ri_0, 0.0, 1.0)
   301	    Ri_shear_curve = cfg.K_0_shear * (1.0 - Ri_ratio**2) ** 3
   302	
   303	    # Interior static instability: enhanced mixing where N2 < 0
   304	    K_conv = jnp.where(N2 < cfg.Ri_conv, cfg.K_conv, 0.0)
   305	
   306	    # Build separate interior floors for tracer (K_v) and momentum (A_v).
   307	    # The shear-instability + convective enhancement is shared, but the
   308	    # background floors differ (K_bg = 1e-5 for tracers, A_bg = 1e-4 for
   309	    # momentum).  Previously both branches used cfg.K_bg, which dropped
   310	    # the momentum interior viscosity by an order of magnitude (codex
   311	    # adversarial review iter-1, finding #6).
   312	    K_interior = Ri_shear_curve + cfg.K_bg + K_conv
   313	    A_interior = Ri_shear_curve + cfg.A_bg + K_conv
   314	
   315	    # --- K at interfaces (average of full level K_bl) ---
   316	    K_bl_half = 0.5 * (K_bl_full[..., :-1] + K_bl_full[..., 1:])
   317	
   318	    # sigma at interfaces
   319	    z_half_depth = 0.5 * (z_depth[..., :-1] + z_depth[..., 1:])
   320	    sigma_half = z_half_depth / jnp.maximum(h_bl[..., jnp.newaxis], eps)
   321	    in_bl = sigma_half < 1.0
   322	
   323	    # Combine BL and interior.  Each branch uses its own background
   324	    # floor (K_bg for tracers, A_bg for momentum) so the merged field
   325	    # honors the configured background levels in BOTH the BL and the
   326	    # interior.
   327	    K_v = jnp.where(in_bl, K_bl_half + cfg.K_bg, K_interior)
   328	    A_v = jnp.where(in_bl, K_bl_half + cfg.A_bg, A_interior)
   329	    K_v = jnp.minimum(K_v, cfg.K_max)
   330	    A_v = jnp.minimum(A_v, cfg.K_max)
   331	
   332	    # --- Apply diffusion ---
   333	    vel = jnp.stack([u, v], axis=0)
   334	    vel_tend = jax.vmap(
   335	        lambda q: vertical_diffusion_variable_K(q, z_coord, jacobian, A_v),
   336	        in_axes=0, out_axes=0,
   337	    )(vel)
   338	
   339	    tracers = jnp.stack([T, S], axis=0)
   340	    tr_tend = jax.vmap(
   341	        lambda q: vertical_diffusion_variable_K(q, z_coord, jacobian, K_v),
   342	        in_axes=0, out_axes=0,
   343	    )(tracers)
   344	
   345	    # --- Non-local flux for T, S (LMD94 Eq. 19) ---
   346	    #
   347	    # LMD94 defines a counter-gradient term:
   348	    #   gamma_T(sigma) = C_s * Q_0 / (w_s(sigma) * h)   [K/m]
   349	    # where Q_0 is the surface kinematic heat flux [K*m/s].
   350	    #
   351	    # The non-local tendency is  -d/dz(K_bl * gamma_T).
   352	    # Substituting K_bl = h * w_s * G(sigma):
   353	    #   K_bl * gamma_T = h * w_s * G * C_s * Q_0 / (w_s * h) = C_s * Q_0 * G(sigma)
   354	    #
   355	    # So the non-local tendency reduces to:
   356	    #   dT/dt_nonlocal = -d/dz[ C_s * Q_0 * G(sigma) ]            [K/s]
   357	    #
   358	    # We discretize this as the vertical divergence of the non-local
   359	    # flux F_nl = C_s * Q_0 * G(sigma) evaluated at interfaces.
   360	
   361	    # Surface kinematic heat/salt flux for non-local transport (LMD94 Eq. 19).
   362	    # Use the IMPOSED surface flux when available (from bulk formulas or
   363	    # prescribed forcing).  Fall back to diagnosed K_sfc * dT/dz proxy
   364	    # only when no external flux is provided (issue #168 bug 2).
   365	    if Q_sfc_T is not None:
   366	        Q_T = Q_sfc_T  # [K*m/s]
   367	    else:
   368	        dT_dz_sfc = (T[..., 0] - T[..., 1]) / jnp.maximum(dz_half[..., 0], eps)
   369	        K_sfc = K_bl_full[..., 0]
   370	        Q_T = K_sfc * dT_dz_sfc
   371	
   372	    if Q_sfc_S is not None:
   373	        Q_S = Q_sfc_S  # [PSU*m/s]
   374	    else:
   375	        dS_dz_sfc = (S[..., 0] - S[..., 1]) / jnp.maximum(dz_half[..., 0], eps)
   376	        K_sfc = K_bl_full[..., 0]
   377	        Q_S = K_sfc * dS_dz_sfc
   378	
   379	    # Only apply non-local transport for unstable (convective) columns.
   380	    is_unstable_col = B_f > 0.0
   381	
   382	    # G(sigma) at interior interfaces (half levels between full levels)
   383	    sigma_half_full = z_half_depth / jnp.maximum(h_bl[..., jnp.newaxis], eps)
   384	    sigma_half_clip = jnp.clip(sigma_half_full, 0.0, 1.0)
   385	    G_half = sigma_half_clip * (1.0 - sigma_half_clip) ** 2  # (..., nlev-1)
   386	
   387	    in_bl_full = sigma < 1.0
   388	
   389	    # --- Temperature non-local tendency ---
   390	    # Non-local flux at interfaces: F_nl = C_s * Q_T * G_half  [K*m/s]
   391	    # G_half = 0 for sigma_half >= 1 (outside BL) so F_T automatically
   392	    # vanishes below the BL — the divergence ``-dF/dz`` is naturally
   393	    # restricted to the BL.  The previous in-BL mask
   394	    # ``in_bl_full & is_unstable_col`` zeroed the compensating
   395	    # tendency in the layer whose CENTER sigma >= 1 but whose TOP
   396	    # interface sigma_half < 1, breaking column conservation when h_bl
   397	    # cut through a grid cell (codex adversarial review iter-1,
   398	    # finding #1).  Keep only the column-level ``is_unstable_col``
   399	    # gate.
   400	    F_T = cfg.gamma_T * Q_T[..., jnp.newaxis] * G_half  # (..., nlev-1)
   401	    # Tendency = -dF/dz at full levels (zero-flux BCs at surface and bottom)
   402	    dT_nonlocal_top = -F_T[..., :1] / dz_actual[..., :1]
   403	    dT_nonlocal_int = (F_T[..., :-1] - F_T[..., 1:]) / dz_actual[..., 1:-1]
   404	    dT_nonlocal_bot = F_T[..., -1:] / dz_actual[..., -1:]
   405	    dT_nonlocal = jnp.concatenate(
   406	        [dT_nonlocal_top, dT_nonlocal_int, dT_nonlocal_bot], axis=-1
   407	    )  # (..., nlev)  [K/s]
   408	    dT_nonlocal = jnp.where(
   409	        is_unstable_col[..., jnp.newaxis], dT_nonlocal, 0.0
   410	    )
   411	
   412	    # --- Salinity non-local tendency ---
   413	    F_S = cfg.gamma_S * Q_S[..., jnp.newaxis] * G_half  # (..., nlev-1)
   414	    dS_nonlocal_top = -F_S[..., :1] / dz_actual[..., :1]
   415	    dS_nonlocal_int = (F_S[..., :-1] - F_S[..., 1:]) / dz_actual[..., 1:-1]
   416	    dS_nonlocal_bot = F_S[..., -1:] / dz_actual[..., -1:]
   417	    dS_nonlocal = jnp.concatenate(
   418	        [dS_nonlocal_top, dS_nonlocal_int, dS_nonlocal_bot], axis=-1
   419	    )  # (..., nlev)  [psu/s]
   420	    dS_nonlocal = jnp.where(
   421	        is_unstable_col[..., jnp.newaxis], dS_nonlocal, 0.0
   422	    )
   423	
   424	    return VerticalMixingOutput(
   425	        du_dt=vel_tend[0],
   426	        dv_dt=vel_tend[1],
   427	        dT_dt=tr_tend[0] + dT_nonlocal,
   428	        dS_dt=tr_tend[1] + dS_nonlocal,
   429	        K_v=K_v,
   430	        A_v=A_v,
   431	    )

