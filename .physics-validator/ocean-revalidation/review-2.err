   378	    def test_visbeck_kappa_grad_finite_in_unstable_column(self):
   379	        """``compute_visbeck_kappa_gm`` must produce finite gradients
   380	        even when the column has statically unstable layers (N²<0).
   381	
   382	        Regression guard for ``sqrt(max(N², 0))``: in JAX, ``sqrt(0)``
   383	        has an infinite backward derivative, and chained with the
   384	        ``maximum(., 0)`` mask whose VJP is zero on the negative side,
   385	        the autodiff produces ``inf*0 = NaN``.  The fixed form
   386	        ``sqrt(max(N², 1e-30))`` keeps N tiny but positive, giving a
   387	        finite (very large) derivative which is still gradient-zero
   388	        through the ``maximum`` VJP — well-defined zero, not NaN.
   389	        """
   390	        nlev = 6
   391	        z_coord = create_ocean_z_star(n_levels=nlev, H_max=1000.0)
   392	        shape = (4, nlev)
   393	        # Column with N² < 0 in mid-layer (unstable).
   394	        T = jnp.array([20.0, 5.0, 18.0, 8.0, 3.0, 1.0]).astype(jnp.float64)
   395	        T = jnp.broadcast_to(T, shape)
   396	        from legoesm.ocean.eos import wright_eos
   397	        S = jnp.full(shape, 35.0, dtype=jnp.float64)
   398	        p = jnp.full(shape, 1e7, dtype=jnp.float64)
   399	        rho = wright_eos(T, S, p)
   400	
   401	        S_x = jnp.full((4, nlev - 1), 1e-3, dtype=jnp.float64)
   402	        S_y = jnp.zeros((4, nlev - 1), dtype=jnp.float64)
   403	        J = jnp.ones(4, dtype=jnp.float64)
   404	        f_coriolis = jnp.full(4, 1e-4, dtype=jnp.float64)
   405	        cfg = VisbeckConfig()
   406	
   407	        def _loss(rho_in):
   408	            kappa = compute_visbeck_kappa_gm(
   409	                rho_in, S_x, S_y, z_coord, J, f_coriolis, cfg,
   410	            )
   411	            return jnp.sum(kappa)
   412	
   413	        g = jax.grad(_loss)(rho)
   414	        assert not bool(jnp.any(jnp.isnan(g))), (
   415	            f"Visbeck kappa gradient contains NaN — sqrt(max(N²,0)) "
   416	            f"backward pass blew up at N²<0.  Use sqrt(max(N², 1e-30)).\n"
   417	            f"Gradient: {g}"
   418	        )
   419	        assert not bool(jnp.any(jnp.isinf(g))), (
   420	            f"Visbeck kappa gradient contains Inf — likely sqrt(0) "
   421	            f"backward.  Gradient: {g}"
   422	        )

