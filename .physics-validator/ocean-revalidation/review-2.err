     1	"""Ocean diagnostics: deformation radius and energy/enstrophy spectra.
     2	
     3	Deformation radius follows Chelton et al. (1998) / Gill (1982):
     4	    L_d = (1 / (pi |f|)) * integral_{-H}^{0} N(z) dz
     5	
     6	Energy and enstrophy spectra use 2D FFT with isotropic wavenumber binning.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import jax.numpy as jnp
    12	
    13	from legoesm import constants
    14	from legoesm.ocean.eos import compute_buoyancy_frequency, rho_0 as _RHO_0
    15	from legoesm.ocean.vertical import OceanZStarCoordinate
    16	
    17	
    18	# ============================================================================
    19	# Phase 1c: First baroclinic deformation radius
    20	# ============================================================================
    21	
    22	
    23	def first_baroclinic_deformation_radius(
    24	    rho: jnp.ndarray,
    25	    z_coord: OceanZStarCoordinate,
    26	    jacobian: jnp.ndarray,
    27	    f_coriolis: jnp.ndarray,
    28	    rho_ref: float = _RHO_0,
    29	    f_min: float = 1e-10,
    30	) -> jnp.ndarray:
    31	    """First baroclinic deformation radius (Rossby radius).
    32	
    33	    L_d = (1 / (pi |f|)) * integral_{-H}^{0} N(z) dz
    34	
    35	    where N = sqrt(max(N^2, 0)) is the Brunt-Vaisala frequency.
    36	
    37	    Parameters
    38	    ----------
    39	    rho : (..., nlev)
    40	        In-situ density [kg/m^3].
    41	    z_coord : OceanZStarCoordinate
    42	        Vertical coordinate.
    43	    jacobian : (...)
    44	        Dynamic z-star Jacobian.
    45	    f_coriolis : (...)
    46	        Coriolis parameter [1/s], same horizontal shape as ``jacobian``.
    47	    rho_ref : float
    48	        Reference density for buoyancy frequency.
    49	    f_min : float
    50	        Floor on |f| to prevent blow-up near the equator.
    51	
    52	    Returns
    53	    -------
    54	    L_d : (...)
    55	        Deformation radius [m].  One value per water column.
    56	    """
    57	    # N^2 at interior interfaces, shape (..., nlev-1)
    58	    N2 = compute_buoyancy_frequency(
    59	        rho, z_coord.dz_ref, jacobian, rho_ref=rho_ref, g=constants.g,
    60	    )
    61	    # Tiny positive floor avoids NaN gradients in unstable layers,
    62	    # where ``sqrt(0)`` × ``maximum``-mask backward yields ``inf*0=NaN``.
    63	    # See _gm_redi_common.py:154 for the analogous fix.
    64	    N = jnp.sqrt(jnp.maximum(N2, 1e-30))
    65	
    66	    # Interface thicknesses for depth-weighted averaging.
    67	    dz_actual = z_coord.dz_ref * jacobian[..., jnp.newaxis]  # (..., nlev)
    68	    dz_half = 0.5 * (dz_actual[..., :-1] + dz_actual[..., 1:])  # (..., nlev-1)
    69	
    70	    # Depth-weighted average of N, then scale to full water column depth.
    71	    # dz_half only spans interior interfaces, missing half-layers at the
    72	    # surface and bottom.  Using N_bar * H_col extrapolates N to the
    73	    # boundaries — matches the Visbeck (1997) Rossby-radius convention
    74	    # in compute_visbeck_kappa_gm().
    75	    w_total = jnp.sum(dz_half, axis=-1)
    76	    N_bar = jnp.sum(N * dz_half, axis=-1) / jnp.maximum(w_total, 1e-30)
    77	    H_col = jnp.sum(dz_actual, axis=-1)
    78	
    79	    f_safe = jnp.maximum(jnp.abs(f_coriolis), f_min)
    80	    L_d = N_bar * H_col / (jnp.pi * f_safe)
    81	
    82	    return L_d
    83	
    84	
    85	# ============================================================================
    86	# Phase 1d: Isotropic energy and enstrophy spectra
    87	# ============================================================================
    88	
    89	
    90	def _isotropic_spectrum_2d(
    91	    field: jnp.ndarray,
    92	    dx: float,
    93	    detrend: bool = True,
    94	) -> tuple[jnp.ndarray, jnp.ndarray]:
    95	    """Isotropic power spectrum from a 2D field via FFT and radial binning.
    96	
    97	    Parameters
    98	    ----------
    99	    field : (ny, nx)
   100	        Real-valued 2D field on a regular grid.

