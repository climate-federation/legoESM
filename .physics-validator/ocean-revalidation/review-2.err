   142	        assert jnp.all(kappa <= cfg.kappa_max + 1e-10)
   143	
   144	    def test_zero_slope_hits_floor(self):
   145	        """Flat isopycnals ⇒ N·|S| ≈ 0 ⇒ κ collapses to ``kappa_min``."""
   146	        grid, z_coord, jacobian, shape = _make_setup()
   147	        rho = jnp.broadcast_to(
   148	            jnp.linspace(1025.0, 1027.0, shape[-1])[None, None, None, :],
   149	            shape,
   150	        )
   151	        # Zero slopes by construction
   152	        S_x = jnp.zeros(shape[:-1] + (shape[-1] - 1,))
   153	        S_y = jnp.zeros_like(S_x)
   154	        cfg = VisbeckConfig(enabled=True, kappa_min=123.0, kappa_max=4000.0)
   155	        kappa = compute_visbeck_kappa_gm(
   156	            rho, S_x, S_y, z_coord, jacobian,
   157	            jnp.asarray(grid.grid_coriolis), cfg)
   158	        assert jnp.allclose(kappa, cfg.kappa_min)
   159	
   160	    def test_scales_with_alpha_below_ceiling(self):
   161	        """Below the ceiling, κ is linear in ``alpha`` (and the sum
   162	        stays below kappa_max here by construction)."""
   163	        grid, z_coord, jacobian, shape, u, v, T, S, rho = _stratified_fields(
   164	            slope=1e-5)  # small slope so κ stays below the ceiling
   165	        S_x, S_y, _ = _compute_tapered_slopes(
   166	            rho, z_coord, jacobian, grid, GMRediConfig())
   167	        cfg_a = VisbeckConfig(enabled=True, alpha=0.01,
   168	                              kappa_min=1e-8, kappa_max=1e6,
   169	                              use_rossby_radius=False, L_fixed=5e4)
   170	        cfg_b = cfg_a._replace(alpha=0.02)
   171	        ka = compute_visbeck_kappa_gm(
   172	            rho, S_x, S_y, z_coord, jacobian,
   173	            jnp.asarray(grid.grid_coriolis), cfg_a)
   174	        kb = compute_visbeck_kappa_gm(
   175	            rho, S_x, S_y, z_coord, jacobian,
   176	            jnp.asarray(grid.grid_coriolis), cfg_b)
   177	        # κ(α=0.02) / κ(α=0.01) → 2 wherever the slope is non-trivial.
   178	        active = ka > 1.1 * cfg_a.kappa_min
   179	        ratio = jnp.where(active, kb / jnp.where(active, ka, 1.0), 2.0)
   180	        assert jnp.allclose(ratio, 2.0, rtol=1e-10)
   181	
   182	    def test_quadratic_in_L_fixed(self):
   183	        """At fixed-L, κ ∝ L² below the ceiling."""
   184	        grid, z_coord, jacobian, shape, u, v, T, S, rho = _stratified_fields(
