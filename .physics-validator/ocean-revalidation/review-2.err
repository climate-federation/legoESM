   213	        """Different sw_exponent should change mid-atmosphere SW absorption."""
   214	        from legoesm.atmosphere.physics.radiation.gray import gray_radiation
   215	        from legoesm.atmosphere.physics.radiation.config import GrayRadiationConfig
   216	        T, p_full, p_half, T_sfc, lat, insol = self._make_column_data()
