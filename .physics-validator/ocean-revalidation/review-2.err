   671	    def test_a_v_uses_a_bg_not_k_bg(self):
   672	        """Interior momentum viscosity falls back to A_bg, not K_bg.
   673	
   674	        In LMD94, momentum and tracer share the shear-instability
   675	        formulation but have different background floors:
   676	        ``K_bg = 1e-5`` for tracers, ``A_bg = 1e-4`` for momentum.
   677	        An earlier version used ``K_bg`` for the momentum interior
   678	        floor, dropping ``A_v`` by an order of magnitude in stable
   679	        interior layers.  Codex adversarial review iter-1, finding #6.
   680	        """
   681	        from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
   682	        from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
   683	        u, v, T, S, rho, eta, z_coord, J = self._make_kpp_inputs()
   684	
   685	        # Stable forcing → all interior interfaces below the BL are in
   686	        # the "interior" branch; pick a small h_bl_prev to keep BL thin.
   687	        B_f = jnp.full((6, 4, 4), -1e-7, dtype=jnp.float64)
   688	        h_bl_prev = jnp.full((6, 4, 4), 5.0, dtype=jnp.float64)
   689	        cfg = KPPConfig()
   690	        out = kpp_vertical_mixing(
   691	            u, v, T, S, rho, eta, z_coord, J, cfg,
   692	            B_f=B_f, h_bl_prev=h_bl_prev,
   693	        )
   694	
   695	        # Far below the BL, in stably stratified layers with weak
   696	        # shear, K_v should be at or near K_bg = 1e-5 and A_v at or
   697	        # near A_bg = 1e-4.  Take the minimum over the lowest layers
   698	        # (away from the BL where K_bl_half dominates).
   699	        # Specifically, the LAST few interfaces should reflect the
   700	        # interior floor.
   701	        K_v_min_bottom = float(jnp.min(out.K_v[..., -3:]))
   702	        A_v_min_bottom = float(jnp.min(out.A_v[..., -3:]))
   703	
   704	        # K_v floor ~ K_bg = 1e-5.  Check it is within 50% of K_bg.
   705	        assert abs(K_v_min_bottom - cfg.K_bg) / cfg.K_bg < 0.5, (
   706	            f"K_v interior floor {K_v_min_bottom:.3e} differs from "
   707	            f"K_bg={cfg.K_bg} by more than 50%."
   708	        )
   709	        # A_v floor must be ~A_bg = 1e-4, NOT K_bg = 1e-5.  The
   710	        # discriminator: A_v should be at least 5x K_v in stable
   711	        # interior (since A_bg = 10 * K_bg).
   712	        assert A_v_min_bottom > 5.0 * K_v_min_bottom, (
   713	            f"A_v interior {A_v_min_bottom:.3e} is not significantly "
   714	            f"larger than K_v interior {K_v_min_bottom:.3e}.  "
   715	            f"Bug: A_v branch is using K_bg ({cfg.K_bg}) instead of "
   716	            f"A_bg ({cfg.A_bg})."
   717	        )
   718	
   719	    def test_nonlocal_transport_conserves_column_tracer(self):
   720	        """KPP non-local transport is column-conservative.
   721	
   722	        The non-local heat/salt fluxes ``F = gamma * Q * G(sigma)``
   723	        vanish at sigma=0 (G=0) and sigma>=1 (G clipped to 0), so the
   724	        flux divergence ``-dF/dz`` integrates to zero over the column
   725	        with zero-flux BCs.  An earlier version masked the divergence
   726	        with ``in_bl_full`` (sigma_center < 1), which dropped the
   727	        compensating tendency in the cell whose center sigma >= 1
   728	        but whose top interface sigma_half < 1 — breaking column
   729	        conservation when h_bl cut through a grid cell.  Codex
   730	        adversarial review iter-1, finding #1.
   731	        """
   732	        from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
   733	        from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
   734	        from legoesm.ocean.eos import wright_eos
   735	        from legoesm.ocean.vertical import create_ocean_z_star
   736	
   737	        nlev = 8
   738	        z_coord = create_ocean_z_star(n_levels=nlev, H_max=200.0)
   739	        shape = (6, 2, 2, nlev)
   740	        shape_2d = (6, 2, 2)
   741	
   742	        # Unstable column: cold over warm.
   743	        T_profile = jnp.array([2.0, 5.0, 10.0, 15.0, 18.0, 20.0, 22.0, 23.0])
   744	        T = jnp.broadcast_to(T_profile[None, None, None, :], shape).astype(jnp.float64)
   745	        S = jnp.full(shape, 35.0, dtype=jnp.float64)
   746	        p = jnp.full(shape, 1e6, dtype=jnp.float64)
   747	        rho = wright_eos(T, S, p)
   748	
   749	        u = jnp.full(shape, 0.05, dtype=jnp.float64)
   750	        v = jnp.zeros(shape, dtype=jnp.float64)
   751	        eta = jnp.zeros(shape_2d, dtype=jnp.float64)
   752	        J = jnp.ones(shape_2d, dtype=jnp.float64)
   753	
   754	        B_f = jnp.full(shape_2d, 1e-6, dtype=jnp.float64)
   755	        Q_sfc_T = jnp.full(shape_2d, 1e-3, dtype=jnp.float64)
   756	
   757	        # h_bl_prev placed mid-column to ensure the BL crosses a layer.
   758	        h_bl_prev = jnp.full(shape_2d, 75.0, dtype=jnp.float64)
   759	        cfg = KPPConfig()
   760	
   761	        out = kpp_vertical_mixing(
   762	            u, v, T, S, rho, eta, z_coord, J, cfg,
   763	            B_f=B_f, Q_sfc_T=Q_sfc_T, h_bl_prev=h_bl_prev,
   764	        )
   765	        out_no_qsfc = kpp_vertical_mixing(
   766	            u, v, T, S, rho, eta, z_coord, J, cfg,
   767	            B_f=B_f, Q_sfc_T=jnp.zeros(shape_2d), h_bl_prev=h_bl_prev,
   768	        )
   769	
   770	        # Isolate the non-local contribution by differencing.
   771	        dT_nonlocal = out.dT_dt - out_no_qsfc.dT_dt
   772	
   773	        dz_actual = z_coord.dz_ref * J[..., jnp.newaxis]
   774	        column_integral = jnp.sum(dT_nonlocal * dz_actual, axis=-1)
   775	        max_drift = float(jnp.max(jnp.abs(column_integral)))
   776	        norm = float(jnp.max(jnp.abs(dT_nonlocal)))
   777	        rel_drift = max_drift / max(norm, 1e-30)
   778	
   779	        assert rel_drift < 1e-12, (
   780	            f"KPP non-local transport non-conservative: column drift "
   781	            f"{max_drift:.3e}, relative {rel_drift:.3e}.  Was the "
   782	            f"in_bl_full mask re-introduced?"
   783	        )
   784	
   785	    def test_b_f_proxy_sign_for_stable_column(self):
   786	        """The B_f proxy (used when caller passes B_f=None) must produce
   787	        a NEGATIVE B_f for a statically-stable surface layer.
   788	
   789	        Convention: ``B_f > 0 = unstable``.  The diffusive proxy
   790	        ``B_f = +g/rho_0 * K_bg * drho_dz_sfc`` (with
   791	        ``drho_dz_sfc = (rho[0] - rho[1]) / dz``) gives:
   792	            stable column   (rho[0] < rho[1] ⇒ drho_dz_sfc < 0) → B_f < 0  ✓
   793	            unstable column (rho[0] > rho[1] ⇒ drho_dz_sfc > 0) → B_f > 0  ✓
   794	
   795	        Regression guard: an earlier version had a leading minus sign
   796	        on the proxy which inverted the stability classification.
   797	        """
   798	        from legoesm.ocean.physics.vertical_mixing.kpp import kpp_vertical_mixing
   799	        from legoesm.ocean.physics.vertical_mixing.config import KPPConfig
   800	        u, v, T, S, rho, eta, z_coord, J = self._make_kpp_inputs()
   801	        cfg = KPPConfig()
   802	
   803	        # T monotone-decreasing → STABLE column.  Provide an explicit
   804	        # negative B_f for the reference case.
   805	        B_f_stable = jnp.full((6, 4, 4), -1e-7, dtype=jnp.float64)
   806	        Q_sfc_T = jnp.full((6, 4, 4), 1e-3, dtype=jnp.float64)
   807	        Q_sfc_S = jnp.zeros((6, 4, 4), dtype=jnp.float64)
   808	
   809	        out_explicit = kpp_vertical_mixing(
   810	            u, v, T, S, rho, eta, z_coord, J, cfg,
   811	            B_f=B_f_stable, Q_sfc_T=Q_sfc_T, Q_sfc_S=Q_sfc_S,
   812	        )
   813	        out_proxy = kpp_vertical_mixing(
   814	            u, v, T, S, rho, eta, z_coord, J, cfg,
   815	            Q_sfc_T=Q_sfc_T, Q_sfc_S=Q_sfc_S,
   816	        )
   817	
   818	        # If the proxy is correctly STABLE (B_f<0), non-local
   819	        # transport stays inactive and the proxy run agrees with the
   820	        # explicit-negative-B_f run.  Under the buggy +g/rho_0 →
   821	        # -g/rho_0 sign flip, the proxy would report B_f>0, fire
   822	        # non-local transport, and the two outputs would disagree.
   823	        diff = float(jnp.max(jnp.abs(out_proxy.dT_dt - out_explicit.dT_dt)))
   824	        assert diff < 1e-12, (
   825	            f"B_f proxy sign regression: stable-column proxy run differs "
   826	            f"from explicit-negative-B_f run by {diff:.3e}.  This "
   827	            f"indicates the proxy is producing the WRONG SIGN of B_f "
   828	            f"and incorrectly firing non-local transport in stable "
   829	            f"columns."
   830	        )
   831	
   832	    def test_b_salt_sign_freshening_is_stabilizing(self):
   833	        """Surface buoyancy flux from freshwater has the correct sign.
   834	
   835	        The KPP B_f convention is ``B_f > 0 = unstable``, with formula
   836	        ``B_f = -g*alpha*Q_T + g*beta*Q_S`` where Q_T, Q_S are kinematic
   837	        fluxes INTO the ocean.  For pure surface freshening (P > E,
   838	        Q_T = 0) the salt flux INTO the ocean is NEGATIVE
   839	        (Q_S = -S * F_fw / rho_0 < 0 because freshwater dilutes the
   840	        surface), which makes B_salt = +g*beta*Q_S < 0 — STABILIZING,
   841	        consistent with lighter water on top.
   842	
   843	        Regression guard: a previous implementation used the wrong sign
   844	        ``B_salt = -g*beta*Q_S``, producing destabilization for
   845	        freshening — exactly opposite of physical reality.
   846	        """
   847	        from legoesm.ocean.physics.vertical_mixing.integration import (
   848	            make_vertical_mixing_physics,
   849	        )
   850	        from legoesm.ocean.physics.vertical_mixing.config import (
   851	            KPPConfig, VerticalMixingConfig,
   852	        )
   853	        from legoesm.ocean.state import OceanSurfaceForcing
   854	        from legoesm.core.field import Field
   855	        from legoesm.ocean.vertical import create_ocean_z_star
   856	        from legoesm.grids.cubed_sphere import create_cubed_sphere
   857	
   858	        # Build minimal cubed-sphere ocean state with strong surface freshening.
   859	        n, nlev = 4, 6
   860	        grid = create_cubed_sphere(n=n)
   861	        z_coord = create_ocean_z_star(n_levels=nlev, H_max=2000.0)
   862	        shape = (6, n, n, nlev)
   863	        shape_2d = (6, n, n)
   864	
   865	        # Mildly stable column (T decreasing with depth, near-zero density gradient
   866	        # so the surface buoyancy flux dominates h_bl).
   867	        T_data = jnp.broadcast_to(
   868	            jnp.linspace(15.0, 5.0, nlev)[None, None, None, :], shape,
   869	        ).astype(jnp.float64)
   870	        S_data = jnp.full(shape, 35.0, dtype=jnp.float64)
   871	        u_data = jnp.zeros(shape, dtype=jnp.float64)
   872	        v_data = jnp.zeros(shape, dtype=jnp.float64)
   873	        eta_data = jnp.zeros(shape_2d, dtype=jnp.float64)
   874	        H_bathy_data = jnp.full(shape_2d, 2000.0, dtype=jnp.float64)
   875	        land_mask = jnp.ones(shape_2d, dtype=jnp.float64)
   876	
   877	        from legoesm.ocean.state import OceanState
   878	        state = OceanState(
   879	            u=Field(data=u_data),
   880	            v=Field(data=v_data),
   881	            T=Field(data=T_data),
   882	            S=Field(data=S_data),
   883	            eta=Field(data=eta_data),
   884	            H_bathy=Field(data=H_bathy_data),
   885	            land_mask=Field(data=land_mask),
   886	        )
   887	
   888	        # Strong freshening: P >> E.
   889	        fw_freshening = jnp.full(shape_2d, 5e-4, dtype=jnp.float64)  # kg/m^2/s
   890	        # Strong brine rejection: -P + E >> 0 (e.g. sea-ice formation).
   891	        fw_brine = jnp.full(shape_2d, -5e-4, dtype=jnp.float64)
   892	        # Zero net heat flux so freshwater is the only buoyancy driver.
   893	        zero_2d = jnp.zeros(shape_2d, dtype=jnp.float64)
   894	
   895	        cfg = VerticalMixingConfig(scheme="kpp", kpp=KPPConfig())
   896	        physics_fn = make_vertical_mixing_physics(cfg)
   897	
   898	        # Pure freshening: K_v should pick up the BACKGROUND value (B_f<0,
   899	        # h_bl <= 1 layer) rather than an enhanced convective profile.
   900	        sf_fresh = OceanSurfaceForcing(
   901	            tau_x=zero_2d, tau_y=zero_2d, q_net=zero_2d, freshwater=fw_freshening,
   902	        )
   903	        out_fresh = physics_fn(state, grid, z_coord, surface_forcing=sf_fresh)
   904	
   905	        # Pure brine rejection: K_v should be larger because B_f > 0
   906	        # destabilizes the column → deeper BL → enhanced K_v.
   907	        sf_brine = OceanSurfaceForcing(
   908	            tau_x=zero_2d, tau_y=zero_2d, q_net=zero_2d, freshwater=fw_brine,
   909	        )
   910	        out_brine = physics_fn(state, grid, z_coord, surface_forcing=sf_brine)
   911	
   912	        # Compute column-averaged K_v to compare overall mixing intensity.
   913	        K_v_fresh = float(jnp.mean(out_fresh.K_v if hasattr(out_fresh, "K_v")
   914	                                   else jnp.zeros(1)))
   915	        # The factory wraps to OceanTendencies which doesn't expose K_v;
   916	        # fall back to comparing dT/dt (non-local) magnitudes.
   917	        diff_T = float(jnp.max(jnp.abs(out_brine.dT_dt.data - out_fresh.dT_dt.data)))
   918	
   919	        # Brine rejection should produce STRONGER mixing (larger |dT/dt|)
   920	        # than freshening — the asymmetry is exactly what would FAIL
   921	        # under the buggy `B_salt = -g*beta*Q_S` (which would invert
   922	        # the asymmetry: freshening would mix harder than brine).
   923	        max_T_brine = float(jnp.max(jnp.abs(out_brine.dT_dt.data)))
   924	        max_T_fresh = float(jnp.max(jnp.abs(out_fresh.dT_dt.data)))
   925	        assert max_T_brine >= max_T_fresh - 1e-30, (
   926	            f"B_salt sign regression: freshening produced stronger mixing "
   927	            f"({max_T_fresh:.3e}) than brine rejection ({max_T_brine:.3e}). "
   928	            "Under the correct sign (B_salt = +g*beta*Q_S), brine "
   929	            "rejection destabilizes and should mix at least as hard as "
   930	            "freshening (which stabilizes)."
   931	        )
   932	
