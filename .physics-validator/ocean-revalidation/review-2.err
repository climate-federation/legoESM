   222	        # but mid-level profiles should differ (exponent changes how tau
   223	        # is distributed vertically through the atmosphere).
   224	        mid = out1.sw_flux_down.shape[1] // 2
   225	        assert not jnp.allclose(out1.sw_flux_down[:, mid], out2.sw_flux_down[:, mid])
   226	        # SW heating rates should also differ
   227	        assert not jnp.allclose(out1.sw_heating_rate, out2.sw_heating_rate)
