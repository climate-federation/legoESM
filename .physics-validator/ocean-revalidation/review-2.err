     1	"""Configuration for ocean surface forcing schemes."""
     2	
     3	from __future__ import annotations
     4	
     5	from typing import NamedTuple
     6	
     7	
     8	class PrescribedForcingConfig(NamedTuple):
     9	    """Fixed wind stress and heat/freshwater fluxes."""
    10	    tau_x: float = 0.0           # Zonal wind stress [N/m^2]
    11	    tau_y: float = 0.0           # Meridional wind stress [N/m^2]
    12	    Q_net: float = 0.0           # Net surface heat flux [W/m^2] (+ into ocean)
    13	    E_minus_P: float = 0.0       # Evaporation minus precipitation [m/s]
    14	    wind_profile: str = "constant"   # "constant", "cosine_latitude", "single_gyre", "double_gyre", "double_gyre_sin2", "double_gyre_tapered", or "global_wind"
    15	    tau_max: float = 0.1         # Max wind stress for wind profiles [N/m^2]
    16	    lat_south_deg: float = 15.0  # Southern basin boundary [degrees]
    17	    lat_north_deg: float = 75.0  # Northern basin boundary [degrees]
    18	    wind_buffer_deg: float = 0.0  # Buffer zone width [degrees] where wind tapers to zero at basin edges
    19	
    20	
    21	class RestoringConfig(NamedTuple):
    22	    """SST/SSS restoring to target profiles."""
    23	    tau_T: float = 2592000.0     # Temperature restoring timescale [s] (30 days)
    24	    tau_S: float = 2592000.0     # Salinity restoring timescale [s] (30 days)
    25	    T_star_eq: float = 25.0      # Target equatorial SST [degC]
    26	    T_star_pole: float = 0.0     # Target polar SST [degC]
    27	    S_star: float = 35.0         # Target SSS [PSU]
    28	    T_profile: str = "cosine"    # "cosine" or "constant"
    29	
    30	
    31	class BulkFormulaConfig(NamedTuple):
    32	    """COARE-like air-sea flux formulation."""
    33	    C_D: float = 1.5e-3     # Drag coefficient (constant scheme)
    34	    C_H: float = 1.5e-3     # Sensible heat transfer coefficient (constant)
    35	    C_E: float = 1.5e-3     # Latent heat transfer coefficient (constant)
    36	    rho_a: float = 1.225    # Air density [kg/m^3]
    37	    c_pa: float = 1004.64   # Specific heat of air [J/(kg·K)] (= constants.c_pd)
    38	    L_v: float = 2.501e6    # Latent heat of vaporization [J/kg] (= constants.L_v)
    39	    T_a: float = 280.0      # Air temperature [K]
    40	    U_a: float = 5.0        # Wind speed [m/s]
    41	    q_a: float = 0.005      # Air specific humidity [kg/kg]
    42	    SW_down: float = 200.0  # Downward shortwave [W/m^2]
    43	    LW_down: float = 300.0  # Downward longwave [W/m^2]
    44	    bulk_scheme: str = "constant"  # "constant", "coare3", "large_yeager"
    45	    z_ref: float = 10.0     # Reference height for MOST [m]
    46	    z0: float = 1e-4        # Roughness length for MOST [m]
    47	    bulk_n_iter: int = 5    # MOST iterations
    48	    emissivity: float = 0.97  # Surface longwave emissivity
    49	
    50	
    51	class SurfaceForcingConfig(NamedTuple):
    52	    """Top-level surface forcing configuration.
    53	
    54	    Use ``scheme="combined"`` to apply prescribed wind stress together
    55	    with temperature/salinity restoring — needed for realistic
    56	    baroclinic gyre experiments.
    57	    """
    58	    scheme: str = "none"  # "prescribed", "restoring", "combined", "bulk_formulas", "none"
    59	    prescribed: PrescribedForcingConfig = PrescribedForcingConfig()
    60	    restoring: RestoringConfig = RestoringConfig()
    61	    bulk_formulas: BulkFormulaConfig = BulkFormulaConfig()

